<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\DailyVitals.Data\DailyVitals.Data.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>DailyVitals.Web-Deployment</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);App.config;artifacts\**;server*.log</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="App.config" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Include="..\database\**\*.sql"
             Link="Database\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
