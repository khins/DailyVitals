@page "/"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using DailyVitals.Web.Services
@inject NavigationManager Navigation
@inject LocalLoginService LoginService
@inject LocalLoginSession LoginSession
@inject IConfiguration Configuration

<PageTitle>Sign in | DailyVitals</PageTitle>

<section class="login-page">
    <div class="login-visual" aria-hidden="true">
        <div class="vitals-card">
            <div class="vitals-card__header">
                <span>Today</span>
                <strong>Stable</strong>
            </div>
            <div class="pulse-line"></div>
            <div class="metric-grid">
                <div>
                    <span>BP</span>
                    <strong>118/76</strong>
                </div>
                <div>
                    <span>Glucose</span>
                    <strong>96</strong>
                </div>
                <div>
                    <span>Weight</span>
                    <strong>182.4</strong>
                </div>
                <div>
                    <span>Exercise</span>
                    <strong>42m</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="login-panel">
        <div class="brand-row">
            <div class="brand-mark" aria-hidden="true">DV</div>
            <div>
                <p class="eyebrow">DailyVitals Web</p>
                <h1>Sign in</h1>
            </div>
        </div>

        <EditForm Model="_model" FormName="sign-in-form" OnValidSubmit="SignIn" class="login-form">
            <DataAnnotationsValidator />

            <div class="field-group">
                <label for="user-name">Email</label>
                <InputText id="user-name" name="username" type="email" class="form-input" autocomplete="username" @bind-Value="_model.UserName" />
                <ValidationMessage For="() => _model.UserName" />
            </div>

            <div class="field-group">
                <label for="password">Password</label>
                <InputText id="password" name="password" type="@PasswordInputType" class="form-input" autocomplete="current-password" @bind-Value="_model.Password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <div class="password-action-row">
                <label class="checkbox-row show-password-row">
                    <InputCheckbox @bind-Value="_showPassword" />
                    <span>Show Password</span>
                </label>
            </div>

            <div class="recovery-link-row">
                <a href="forgot-email">Forgot Email?</a>
                <a href="account-recovery">Forgot Password?</a>
            </div>

            <div class="form-options remember-device-row">
                <label class="checkbox-row">
                    <InputCheckbox @bind-Value="_model.RememberMe" />
                    <span>Remember this device</span>
                </label>
                @if (_model.RememberMe)
                {
                    <span class="remember-device-duration">Keep me logged in for 30 days</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="login-message" role="status">@_message</div>
            }

            <button type="submit" class="primary-button">Sign in</button>
            <a class="form-link" href="create-account">Create account</a>

            @if (DemoModeEnabled)
            {
                <div class="demo-login-panel">
                    <div>
                        <strong>Explore Demo Mode</strong>
                        <span>@DemoUserName</span>
                    </div>
                    <button type="button" class="secondary-link" @onclick="UseDemoCredentials">Use demo account</button>
                </div>
            }
        </EditForm>
    </div>
</section>

@code {
    private readonly LoginModel _model = new()
    {
        UserName = string.Empty
    };

    private string? _message;
    private bool _showPassword;

    private string PasswordInputType => _showPassword ? "text" : "password";
    private bool DemoModeEnabled => Configuration.GetValue("DemoMode:Enabled", false);
    private string DemoUserName => Configuration["DemoMode:UserName"] ?? "demo@activevitals.app";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoginSession.RestoreAsync();

        if (LoginSession.IsSignedIn)
            Navigation.NavigateTo("/dashboard", replace: true);
    }

    private async Task SignIn()
    {
        if (!LoginService.IsConfigured)
        {
            _message = "Local sign-in is not configured yet. Add DailyVitalsLogin email and password settings.";
            return;
        }

        var loginUser = LoginService.ValidateLogin(_model.UserName, _model.Password);
        if (loginUser is null)
        {
            _message = "The email or password is incorrect.";
            return;
        }

        if (!loginUser.PersonId.HasValue)
        {
            _message = "This login is not linked to a person record yet.";
            return;
        }

        _message = null;
        await LoginSession.SignInAsync(
            loginUser.UserName,
            loginUser.PersonId,
            _model.RememberMe,
            loginUser.IsDemo);
        Navigation.NavigateTo("/dashboard", forceLoad: true, replace: true);
    }

    private void UseDemoCredentials()
    {
        _model.UserName = DemoUserName;
        _model.Password = Configuration["DemoMode:Password"] ?? "Demo123!";
        _model.RememberMe = false;
        _message = null;
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? UserName { get; set; }

        [Required(ErrorMessage = "Enter your password.")]
        public string? Password { get; set; }

        public bool RememberMe { get; set; } = true;
    }
}
