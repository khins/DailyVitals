@page "/"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using DailyVitals.Web.Services
@inject NavigationManager Navigation
@inject LocalLoginService LoginService
@inject LocalLoginSession LoginSession

<PageTitle>Sign in | DailyVitals</PageTitle>

<section class="login-page">
    <div class="login-visual" aria-hidden="true">
        <div class="vitals-card">
            <div class="vitals-card__header">
                <span>Today</span>
                <strong>Stable</strong>
            </div>
            <div class="pulse-line"></div>
            <div class="metric-grid">
                <div>
                    <span>BP</span>
                    <strong>118/76</strong>
                </div>
                <div>
                    <span>Glucose</span>
                    <strong>96</strong>
                </div>
                <div>
                    <span>Weight</span>
                    <strong>182.4</strong>
                </div>
                <div>
                    <span>Exercise</span>
                    <strong>42m</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="login-panel">
        <div class="brand-row">
            <div class="brand-mark" aria-hidden="true">DV</div>
            <div>
                <p class="eyebrow">DailyVitals Web</p>
                <h1>Sign in</h1>
            </div>
        </div>

        <EditForm Model="_model" FormName="sign-in-form" OnValidSubmit="SignIn" class="login-form">
            <DataAnnotationsValidator />

            <div class="field-group">
                <label for="user-name">Email</label>
                <InputText id="user-name" type="email" class="form-input" autocomplete="email" @bind-Value="_model.UserName" />
                <ValidationMessage For="() => _model.UserName" />
            </div>

            <div class="field-group">
                <label for="password">Password</label>
                <InputText id="password" type="password" class="form-input" autocomplete="current-password" @bind-Value="_model.Password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <div class="form-options">
                <label class="checkbox-row">
                    <InputCheckbox @bind-Value="_model.RememberMe" />
                    <span>Remember this device</span>
                </label>
                <a href="account-recovery">Forgot password?</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="login-message" role="status">@_message</div>
            }

            <button type="submit" class="primary-button">Sign in</button>
            <a class="form-link" href="create-account">Create account</a>
        </EditForm>
    </div>
</section>

@code {
    private readonly LoginModel _model = new()
    {
        UserName = string.Empty
    };

    private string? _message;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && LoginSession.IsSignedIn)
            Navigation.NavigateTo("/dashboard", replace: true);
    }

    private void SignIn()
    {
        if (!LoginService.IsConfigured)
        {
            _message = "Local sign-in is not configured yet. Add DailyVitalsLogin email and password settings.";
            return;
        }

        var loginUser = LoginService.ValidateLogin(_model.UserName, _model.Password);
        if (loginUser is null)
        {
            _message = "The email or password is incorrect.";
            return;
        }

        if (!loginUser.PersonId.HasValue)
        {
            _message = "This login is not linked to a person record yet.";
            return;
        }

        _message = null;
        LoginSession.SignIn(loginUser.UserName, loginUser.PersonId);
        Navigation.NavigateTo("/dashboard", replace: true);
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? UserName { get; set; }

        [Required(ErrorMessage = "Enter your password.")]
        public string? Password { get; set; }

        public bool RememberMe { get; set; } = true;
    }
}
