@page "/"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using DailyVitals.Web.Services
@inject NavigationManager Navigation
@inject LocalLoginSession LoginSession
@inject IConfiguration Configuration

<PageTitle>Sign in | DailyVitals</PageTitle>

<section class="login-page">
    <div class="login-visual" aria-hidden="true">
        <div class="vitals-card">
            <div class="vitals-card__header">
                <span>Today</span>
                <strong>Stable</strong>
            </div>
            <div class="pulse-line"></div>
            <div class="metric-grid">
                <div>
                    <span>BP</span>
                    <strong>118/76</strong>
                </div>
                <div>
                    <span>Glucose</span>
                    <strong>96</strong>
                </div>
                <div>
                    <span>Weight</span>
                    <strong>182.4</strong>
                </div>
                <div>
                    <span>Exercise</span>
                    <strong>42m</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="login-panel">
        <div class="brand-row">
            <div class="brand-mark" aria-hidden="true">DV</div>
            <div>
                <p class="eyebrow">DailyVitals Web</p>
                <h1>Sign in</h1>
            </div>
        </div>

        <form method="post" action="/auth/login" class="login-form">
            <div class="field-group">
                <label for="user-name">Email</label>
                <input id="user-name" name="UserName" type="email" class="form-input" autocomplete="username" value="@Model!.UserName" required />
            </div>

            <div class="field-group">
                <label for="password">Password</label>
                <input id="password" name="Password" type="@PasswordInputType" class="form-input" autocomplete="current-password" value="@Model!.Password" required />
            </div>

            <div class="password-action-row">
                <label class="checkbox-row show-password-row">
                    <InputCheckbox @bind-Value="_showPassword" />
                    <span>Show Password</span>
                </label>
            </div>

            <div class="recovery-link-row">
                <a href="forgot-email">Forgot Email?</a>
                <a href="account-recovery">Forgot Password?</a>
            </div>

            <div class="form-options remember-device-row">
                <label class="checkbox-row">
                    <input type="checkbox" name="RememberMe" value="true" checked="@Model!.RememberMe" />
                    <span>Remember this device</span>
                </label>
                @if (Model!.RememberMe)
                {
                    <span class="remember-device-duration">Keep me logged in for 30 days</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(SignInMessage))
            {
                <div class="login-message" role="status">@SignInMessage</div>
            }

            <button type="submit" class="primary-button">Sign in</button>
            <a class="form-link" href="create-account">Create account</a>

            @if (DemoModeEnabled)
            {
                <div class="demo-login-panel">
                    <div>
                        <strong>Explore Demo Mode</strong>
                        <span>@DemoUserName</span>
                    </div>
                    <button type="button" class="secondary-link" @onclick="UseDemoCredentials">Use demo account</button>
                </div>
            }
        </form>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "signin")]
    private string? SignInResult { get; set; }

    private LoginModel? Model { get; set; }
    private bool _showPassword;

    private string PasswordInputType => _showPassword ? "text" : "password";
    private bool DemoModeEnabled => Configuration.GetValue("DemoMode:Enabled", false);
    private string DemoUserName => Configuration["DemoMode:UserName"] ?? "demo@activevitals.app";
    private string? SignInMessage => SignInResult switch
    {
        "missing" => "Enter your email and password.",
        "locked" => "Too many failed attempts. Try again later.",
        "invalid" => "The email or password is incorrect.",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        Model ??= new LoginModel { UserName = string.Empty };

        await LoginSession.RestoreAsync();

        if (LoginSession.IsSignedIn)
            Navigation.NavigateTo("/dashboard", replace: true);
    }

    private void UseDemoCredentials()
    {
        Model ??= new LoginModel();
        Model.UserName = DemoUserName;
        Model.Password = Configuration["DemoMode:Password"] ?? "Demo123!";
        Model.RememberMe = false;
        SignInResult = null;
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? UserName { get; set; }

        [Required(ErrorMessage = "Enter your password.")]
        public string? Password { get; set; }

        public bool RememberMe { get; set; } = true;
    }
}
