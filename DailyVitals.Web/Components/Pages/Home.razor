@page "/"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using DailyVitals.Web.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject NavigationManager Navigation
@inject LocalLoginService LoginService
@inject LocalLoginSession LoginSession
@inject IConfiguration Configuration
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Sign in | DailyVitals</PageTitle>

<section class="login-page">
    <div class="login-visual" aria-hidden="true">
        <div class="vitals-card">
            <div class="vitals-card__header">
                <span>Today</span>
                <strong>Stable</strong>
            </div>
            <div class="pulse-line"></div>
            <div class="metric-grid">
                <div>
                    <span>BP</span>
                    <strong>118/76</strong>
                </div>
                <div>
                    <span>Glucose</span>
                    <strong>96</strong>
                </div>
                <div>
                    <span>Weight</span>
                    <strong>182.4</strong>
                </div>
                <div>
                    <span>Exercise</span>
                    <strong>42m</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="login-panel">
        <div class="brand-row">
            <div class="brand-mark" aria-hidden="true">DV</div>
            <div>
                <p class="eyebrow">DailyVitals Web</p>
                <h1>Sign in</h1>
            </div>
        </div>

        <EditForm Model="Model" FormName="sign-in-form" OnValidSubmit="SignIn" class="login-form">
            <DataAnnotationsValidator />

            <div class="field-group">
                <label for="user-name">Email</label>
                <InputText id="user-name" type="email" class="form-input" autocomplete="username" @bind-Value="Model!.UserName" />
                <ValidationMessage For="() => Model!.UserName" />
            </div>

            <div class="field-group">
                <label for="password">Password</label>
                <InputText id="password" type="@PasswordInputType" class="form-input" autocomplete="current-password" @bind-Value="Model!.Password" />
                <ValidationMessage For="() => Model!.Password" />
            </div>

            <div class="password-action-row">
                <label class="checkbox-row show-password-row">
                    <InputCheckbox @bind-Value="_showPassword" />
                    <span>Show Password</span>
                </label>
            </div>

            <div class="recovery-link-row">
                <a href="forgot-email">Forgot Email?</a>
                <a href="account-recovery">Forgot Password?</a>
            </div>

            <div class="form-options remember-device-row">
                <label class="checkbox-row">
                    <InputCheckbox @bind-Value="Model!.RememberMe" />
                    <span>Remember this device</span>
                </label>
                @if (Model!.RememberMe)
                {
                    <span class="remember-device-duration">Keep me logged in for 30 days</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="login-message" role="status">@_message</div>
            }

            <button type="submit" class="primary-button">Sign in</button>
            <a class="form-link" href="create-account">Create account</a>

            @if (DemoModeEnabled)
            {
                <div class="demo-login-panel">
                    <div>
                        <strong>Explore Demo Mode</strong>
                        <span>@DemoUserName</span>
                    </div>
                    <button type="button" class="secondary-link" @onclick="UseDemoCredentials">Use demo account</button>
                </div>
            }
        </EditForm>
    </div>
</section>

@code {
    [SupplyParameterFromForm(FormName = "sign-in-form")]
    private LoginModel? Model { get; set; }

    private string? _message;
    private bool _showPassword;

    private string PasswordInputType => _showPassword ? "text" : "password";
    private bool DemoModeEnabled => Configuration.GetValue("DemoMode:Enabled", false);
    private string DemoUserName => Configuration["DemoMode:UserName"] ?? "demo@activevitals.app";

    protected override async Task OnInitializedAsync()
    {
        Model ??= new LoginModel { UserName = string.Empty };

        await LoginSession.RestoreAsync();

        if (LoginSession.IsSignedIn)
            Navigation.NavigateTo("/dashboard", replace: true);
    }

    private async Task SignIn()
    {
        if (!LoginService.IsConfigured)
        {
            _message = "Local sign-in is not configured yet. Add DailyVitalsLogin email and password settings.";
            return;
        }

        var loginResult = LoginService.Authenticate(Model!.UserName, Model.Password);
        if (loginResult.IsLocked)
        {
            _message = loginResult.LockedUntil.HasValue
                ? $"Too many failed attempts. Try again after {loginResult.LockedUntil.Value:t}."
                : "Too many failed attempts. Try again later.";
            return;
        }

        var loginUser = loginResult.LoginUser;
        if (loginUser is null)
        {
            _message = "The email or password is incorrect.";
            return;
        }

        if (!loginUser.PersonId.HasValue)
        {
            _message = "This login is not linked to a person record yet.";
            return;
        }

        _message = null;
        await SignInAfterAuthentication(
            loginUser.UserName,
            loginUser.PersonId,
            Model.RememberMe,
            loginUser.IsDemo);
        Navigation.NavigateTo("/dashboard", forceLoad: true, replace: true);
    }

    private async Task SignInAfterAuthentication(string userName, long? personId, bool rememberDevice, bool isDemo)
    {
        if (!personId.HasValue)
            throw new InvalidOperationException("A person record is required to create an authenticated session.");

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            var claims = new[]
            {
                new Claim(ClaimTypes.Name, userName),
                new Claim(LocalLoginSession.AuthClaimTypes.PersonId, personId.Value.ToString()),
                new Claim(LocalLoginSession.AuthClaimTypes.IsDemo, isDemo.ToString()),
                new Claim(LocalLoginSession.AuthClaimTypes.RememberDevice, rememberDevice.ToString())
            };
            var principal = new ClaimsPrincipal(
                new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme));
            var properties = new AuthenticationProperties
            {
                IsPersistent = rememberDevice,
                AllowRefresh = true,
                ExpiresUtc = rememberDevice ? DateTimeOffset.UtcNow.AddDays(30) : null
            };

            await httpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme,
                principal,
                properties);
            LoginSession.SignIn(userName, personId, isDemo, rememberDevice);
            return;
        }

        await LoginSession.SignInAsync(userName, personId, rememberDevice, isDemo);
    }

    private void UseDemoCredentials()
    {
        Model ??= new LoginModel();
        Model.UserName = DemoUserName;
        Model.Password = Configuration["DemoMode:Password"] ?? "Demo123!";
        Model.RememberMe = false;
        _message = null;
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? UserName { get; set; }

        [Required(ErrorMessage = "Enter your password.")]
        public string? Password { get; set; }

        public bool RememberMe { get; set; } = true;
    }
}
