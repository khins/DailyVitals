    private async Task GenerateCoachReview()
    {
        if (LoginSession.IsDemo)
        {
            _coachError = DemoModeGuard.ReadOnlyMessage;
            return;
        }

        if (_coachSnapshot is null || _coachSnapshot.DaysLogged == 0 || _isGeneratingCoachReview)
            return;

        _isGeneratingCoachReview = true;
        _coachError = null;

        try
        {
            var storedReview = await NutritionCoachService.GenerateReviewAsync(
                LoginSession.PersonId!.Value,
                _coachSnapshot);
            _coachReview = storedReview.Review;
            _coachReviewCreatedAt = storedReview.CreatedAt;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nutrition coach review failed.");
            _coachError = "Nutrition coach review could not be completed. Please try again.";
        }
        finally
        {
            _isGeneratingCoachReview = false;
        }
    }

    private string FormatCoachGoalDays(NutritionCoachMetric metric) => _coachSnapshot is null || _coachSnapshot.DaysLogged == 0
        ? "--"
        : $"{metric.DaysMeetingGoal} of {_coachSnapshot.DaysLogged} logged days";

    private RenderFragment RenderCoachList(string title, IReadOnlyList<string> items) => @<section>
        <h3>@title</h3>
        <ul>
            @foreach (var item in items)
            {
                <li>@item</li>
            }
        </ul>
    </section>;

    private RenderFragment RenderSourceList(string title, IReadOnlyList<NutrientSource> sources, string unit) => @<div class="action-source-list">
        <strong>@title</strong>
        @if (sources.Count == 0)
        {
            <p>Add foods with @unit values to identify your largest sources.</p>
        }
        else
        {
            <ul>
                @foreach (var source in sources)
                {
                    <li>
                        <span>@source.FoodName</span>
                        <strong>@FormatNutrientAmount(source.Amount, unit)</strong>
                    </li>
                }
            </ul>
        }
    </div>;

    private static string FormatNutrientAmount(decimal value, string unit) =>
        unit == "g"
            ? $"{value:N1} g"
            : $"{value:N0} {unit}";

    private sealed record ReportNote(string Title, string Detail);

    private sealed record NutrientSource(string FoodName, decimal Amount);

    private sealed record MealSodiumSummary(string Name, decimal AverageMg, decimal Percentage);

    private sealed record NutrientReport(
        string Title,
        string Target,
        string Average,
        string DaysLabel,
        string DaysText,
        string VarianceLabel,
        string Variance,
        string HighestDay,
        string LowestDay,
        string SourceTitle,
        IReadOnlyList<NutrientSource> Sources,
        string Unit);
