@page "/reports"
@attribute [Authorize]
@rendermode InteractiveServer
@using DailyVitals.Data.Services
@using DailyVitals.Data.Services.DailyVitals.App.Services
@using DailyVitals.Domain.Models
@using DailyVitals.Web.Services
@inject BloodPressureService BloodPressureService
@inject BloodGlucoseService BloodGlucoseService
@inject WeightService WeightService
@inject ExerciseService ExerciseService
@inject FoodPhosphorusIntakeService FoodService
@inject NutritionGoalService NutritionGoalService
@inject NutritionCoachService NutritionCoachService
@inject PersonService PersonService
@inject LocalLoginSession LoginSession
@inject NavigationManager Navigation
@inject ILogger<Reports> Logger

<PageTitle>Reports | DailyVitals</PageTitle>

@if (LoginSession.IsSignedIn)
{
    <section class="dashboard-shell @(LoginSession.IsDemo ? "demo-mode" : null)">
        <aside class="dashboard-rail" aria-label="Primary navigation">
            <div class="rail-brand">
                <span class="brand-mark brand-mark--compact" aria-hidden="true">DV</span>
                <span>DailyVitals</span>
            </div>

            <nav class="rail-nav">
                <a href="dashboard">Dashboard</a>
                <a href="blood-pressure">Blood Pressure</a>
                <a href="blood-glucose">Glucose</a>
                <a href="weight">Weight</a>
                <a href="exercise">Exercise</a>
                <a class="is-active" href="reports">Reports</a>
                <a href="nutrition">Nutrition</a>
                <a href="fluid-intake">Fluid Intake</a>
                @if (_showKidneyLabs)
                {
                    <a href="renal-foods">Renal Friendly Foods</a>
                    <a href="labs">Kidney Labs</a>
                }
            </nav>

            <a class="rail-profile" href="profile" aria-label="Profile">
                <span class="profile-icon" aria-hidden="true"></span>
                <span>Profile</span>
            </a>

            <button type="button" class="rail-signout" @onclick="SignOut">Sign out</button>
        </aside>

        <main class="dashboard-main">
            <DemoModeBanner />
            <header class="dashboard-topbar">
                <div>
                    <p class="eyebrow">DailyVitals Web</p>
                    <h1>Reports</h1>
                </div>

                <div class="dashboard-actions">
                    <div class="person-switcher">
                        <span>Person</span>
                        <strong>@LoginSession.UserName</strong>
                    </div>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="@_messageClass" role="status">@_message</div>
            }

            <section class="status-band status-band--ok" aria-label="Reports summary">
                <div>
                    <span class="status-dot"></span>
                    <strong>@ReportSummaryTitle</strong>
                    <p>Reports are person-scoped and summarize data already captured in DailyVitals.</p>
                </div>
                <div>
                    <span>Reporting window</span>
                    <strong>Last 30 days</strong>
                </div>
            </section>

            <article class="dashboard-card ai-coach-card" aria-labelledby="ai-coach-title">
                <div class="ai-coach-heading">
                    <div>
                        <span>AI Nutrition Coach</span>
                        <h2 id="ai-coach-title">@(_coachReview?.Headline ?? "Your weekly nutrition review")</h2>
                        <p>@CoachPeriodText</p>
                        @if (_coachReviewCreatedAt.HasValue)
                        {
                            <p class="ai-coach-saved">Saved @_coachReviewCreatedAt.Value.ToString("MMM d, yyyy h:mm tt")</p>
                        }
                    </div>
                    <button type="button"
                            class="primary-action"
                            disabled="@(!CanGenerateCoachReview)"
                            @onclick="GenerateCoachReview">
                        @(_isGeneratingCoachReview ? "Reviewing..." : _coachReview is null ? "Generate Review" : "Refresh Review")
                    </button>
                </div>

                @if (_coachSnapshot is { } coachSnapshot)
                {
                    <dl class="ai-coach-facts" aria-label="Weekly nutrition data coverage">
                        <div>
                            <dt>Days logged</dt>
                            <dd>@coachSnapshot.DaysLogged of @coachSnapshot.DaysInPeriod</dd>
                        </div>
                        <div>
                            <dt>Food entries</dt>
                            <dd>@coachSnapshot.FoodEntries</dd>
                        </div>
                        <div>
                            <dt>Phosphorus within goal</dt>
                            <dd>@FormatCoachGoalDays(coachSnapshot.Phosphorus)</dd>
                        </div>
                        <div>
                            <dt>Sodium within goal</dt>
                            <dd>@FormatCoachGoalDays(coachSnapshot.Sodium)</dd>
                        </div>
                    </dl>
                }

                @if (!string.IsNullOrWhiteSpace(_coachError))
                {
                    <div class="ai-coach-error" role="alert">@_coachError</div>
                }
                else if (_isGeneratingCoachReview)
                {
                    <p class="ai-coach-placeholder" role="status">Reviewing your logged nutrition patterns...</p>
                }
                else if (_coachReview is { } coachReview)
                {
                    <p class="ai-coach-summary">@coachReview.Summary</p>

                    <div class="ai-coach-guidance">
                        @RenderCoachList("Wins", coachReview.Wins)
                        @RenderCoachList("Focus Areas", coachReview.FocusAreas)
                        @RenderCoachList("Next Steps", coachReview.SuggestedActions)
                    </div>

                    @if (!string.IsNullOrWhiteSpace(coachReview.CareTeamNote))
                    {
                        <p class="ai-coach-care-note"><strong>For your care team:</strong> @coachReview.CareTeamNote</p>
                    }
                }
                else
                {
                    <p class="ai-coach-placeholder">
                        @(_coachSnapshot?.DaysLogged > 0
                            ? "Generate a review to turn this week's logged foods and personal nutrition goals into a concise summary."
                            : "Log at least one day of nutrition to generate a weekly review.")
                    </p>
                }

                <p class="ai-coach-disclosure">Educational guidance only. The coach does not change nutrition goals, binders, medications, or treatment plans.</p>
            </article>

            <section class="report-card-grid" aria-label="Report overview">
                <article class="dashboard-card report-card">
                    <div class="card-heading">
                        <div>
                            <span>Weight Progress Report</span>
                            <h2>@WeightChangeText</h2>
                        </div>
                        <strong class="@WeightStatusClass">@WeightStatusText</strong>
                    </div>
                    <dl class="report-metric-list">
                        <div>
                            <dt>Starting</dt>
                            <dd>@WeightStartText</dd>
                        </div>
                        <div>
                            <dt>Latest</dt>
                            <dd>@WeightLatestText</dd>
                        </div>
                        <div>
                            <dt>Readings</dt>
                            <dd>@_weightHistory.Count</dd>
                        </div>
                    </dl>
                </article>

                <article class="dashboard-card report-card">
                    <div class="card-heading">
                        <div>
                            <span>Nutrition Compliance Report</span>
                            <h2>@NutritionActiveDaysText</h2>
                        </div>
                    </div>
                    <dl class="report-metric-list report-metric-list--narrative">
                        <div>
                            <dt>Overall</dt>
                            <dd>@NutritionComplianceText</dd>
                        </div>
                        <div>
                            <dt>Phosphorus</dt>
                            <dd>@PhosphorusComplianceText</dd>
                        </div>
                        <div>
                            <dt>Sodium</dt>
                            <dd>@SodiumComplianceText</dd>
                        </div>
                        <div>
                            <dt>Avg calories</dt>
                            <dd>@_nutritionAverageCalories.ToString("N0") cal</dd>
                        </div>
                    </dl>
                </article>

                <article class="dashboard-card report-card">
                    <div class="card-heading">
                        <div>
                            <span>Sodium Goal Progress</span>
                            <h2>@SodiumAverageText</h2>
                        </div>
                        <strong class="@SodiumStatusClass">@SodiumStatusText</strong>
                    </div>
                    <dl class="report-metric-list">
                        <div>
                            <dt>Target</dt>
                            <dd>@_sodiumTargetMg.ToString("N0") mg/day</dd>
                        </div>
                        <div>
                            <dt>Within goal</dt>
                            <dd>@SodiumDaysWithinGoalText</dd>
                        </div>
                        <div>
                            <dt>Average excess</dt>
                            <dd>@SodiumAverageExcessText</dd>
                        </div>
                    </dl>
                    <button type="button" class="secondary-link report-card-action" @onclick="ShowSodiumReport">Details</button>
                </article>

                <article class="dashboard-card report-card">
                    <div class="card-heading">
                        <div>
                            <span>Nutrition Pattern</span>
                            <h2>Meal Sodium Analysis</h2>
                        </div>
                        <strong>Last 30 days</strong>
                    </div>
                    @if (_nutritionTotalSodium <= 0)
                    {
                        <p class="meal-sodium-note">Add foods with sodium values to see which meal periods contribute the most.</p>
                    }
                    else
                    {
                        <dl class="report-metric-list">
                            @foreach (var meal in _mealSodiumSummaries)
                            {
                                <div>
                                    <dt>@meal.Name</dt>
                                    <dd>@meal.AverageMg.ToString("N0") mg (@meal.Percentage.ToString("N0")%)</dd>
                                </div>
                            }
                        </dl>
                        <p class="meal-sodium-note">
                            Average per logged day using the meal selected on each food entry.
                            Edit older entries marked Unassigned to include them accurately.
                        </p>
                    }
                </article>

                <article class="dashboard-card report-card">
                    <div class="card-heading">
                        <div>
                            <span>Phosphorus Goal Progress</span>
                            <h2>@PhosphorusAverageText</h2>
                        </div>
                        <strong class="@PhosphorusStatusClass">@PhosphorusStatusText</strong>
                    </div>
                    <dl class="report-metric-list">
                        <div>
                            <dt>Target</dt>
                            <dd>@_phosphorusTargetMg.ToString("N0") mg/day</dd>
                        </div>
                        <div>
                            <dt>Within goal</dt>
                            <dd>@PhosphorusDaysWithinGoalText</dd>
                        </div>
                        <div>
                            <dt>Average excess</dt>
                            <dd>@PhosphorusAverageExcessText</dd>
                        </div>
                    </dl>
                    <button type="button" class="secondary-link report-card-action" @onclick="ShowPhosphorusReport">Details</button>
                </article>

                <article class="dashboard-card report-card">
                    <div class="card-heading">
                        <div>
                            <span>Protein Target Progress</span>
                            <h2>@ProteinAverageText</h2>
                        </div>
                        <strong class="@ProteinStatusClass">@ProteinStatusText</strong>
                    </div>
                    <dl class="report-metric-list">
                        <div>
                            <dt>Target</dt>
                            <dd>@_proteinTargetG.ToString("N0") g/day</dd>
                        </div>
                        <div>
                            <dt>Meeting target</dt>
                            <dd>@ProteinDaysMeetingTargetText</dd>
                        </div>
                        <div>
                            <dt>Average gap</dt>
                            <dd>@ProteinAverageGapText</dd>
                        </div>
                    </dl>
                    <button type="button" class="secondary-link report-card-action" @onclick="ShowProteinReport">Details</button>
                </article>

                <article class="dashboard-card report-card">
                    <div class="card-heading">
                        <div>
                            <span>Potassium Goal Progress</span>
                            <h2>@PotassiumAverageText</h2>
                        </div>
                        <strong class="@PotassiumStatusClass">@PotassiumStatusText</strong>
                    </div>
                    <dl class="report-metric-list">
                        <div>
                            <dt>Target</dt>
                            <dd>@_potassiumTargetMg.ToString("N0") mg/day</dd>
                        </div>
                        <div>
                            <dt>Within goal</dt>
                            <dd>@PotassiumDaysWithinGoalText</dd>
                        </div>
                        <div>
                            <dt>Average excess</dt>
                            <dd>@PotassiumAverageExcessText</dd>
                        </div>
                    </dl>
                    <button type="button" class="secondary-link report-card-action" @onclick="ShowPotassiumReport">Details</button>
                </article>

                <article class="dashboard-card report-card">
                    <div class="card-heading">
                        <div>
                            <span>Exercise Consistency Report</span>
                            <h2>@_exerciseActiveDays active days</h2>
                        </div>
                        <strong>@FormatMinutes(_exerciseTotalMinutes)</strong>
                    </div>
                    <dl class="report-metric-list">
                        <div>
                            <dt>Sessions</dt>
                            <dd>@_recentExercise.Count</dd>
                        </div>
                        <div>
                            <dt>Average session</dt>
                            <dd>@FormatMinutes(_exerciseAverageMinutes)</dd>
                        </div>
                        <div>
                            <dt>Most common</dt>
                            <dd>@MostCommonExercise</dd>
                        </div>
                    </dl>
                </article>

                <article class="dashboard-card report-card">
                    <div class="card-heading">
                        <div>
                            <span>Monthly Health Summary</span>
                            <h2>@DateTime.Today.ToString("MMMM yyyy")</h2>
                        </div>
                        <strong>@MonthlyEntryCount entries</strong>
                    </div>
                    <dl class="report-metric-list">
                        <div>
                            <dt>Latest BP</dt>
                            <dd>@LatestBloodPressureText</dd>
                        </div>
                        <div>
                            <dt>Latest glucose</dt>
                            <dd>@LatestGlucoseText</dd>
                        </div>
                        <div>
                            <dt>Latest weight</dt>
                            <dd>@WeightLatestText</dd>
                        </div>
                    </dl>
                </article>
            </section>

            <section class="report-detail-grid">
                <article class="dashboard-card report-detail-panel">
                    <div class="card-heading">
                        <div>
                            <span>Nutrition</span>
                            <h2>Last 30 Days</h2>
                        </div>
                        <strong>@_recentNutrition.Count entries</strong>
                    </div>

                    <div class="data-table-wrap report-table-wrap">
                        <table class="data-table data-table--readonly">
                            <thead>
                                <tr>
                                    <th>Metric</th>
                                    <th>Total</th>
                                    <th>Daily Average</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Phosphorus</td>
                                    <td>@_nutritionTotalPhosphorus.ToString("N0") mg</td>
                                    <td>@AveragePerActiveDay(_nutritionTotalPhosphorus).ToString("N0") mg</td>
                                </tr>
                                <tr>
                                    <td>Sodium</td>
                                    <td>@_nutritionTotalSodium.ToString("N0") mg</td>
                                    <td>@AveragePerActiveDay(_nutritionTotalSodium).ToString("N0") mg</td>
                                </tr>
                                <tr>
                                    <td>Calories</td>
                                    <td>@_nutritionTotalCalories.ToString("N0") cal</td>
                                    <td>@_nutritionAverageCalories.ToString("N0") cal</td>
                                </tr>
                                <tr>
                                    <td>Protein</td>
                                    <td>@_nutritionTotalProtein.ToString("N1") g</td>
                                    <td>@AveragePerActiveDay(_nutritionTotalProtein).ToString("N1") g</td>
                                </tr>
                                <tr>
                                    <td>Potassium</td>
                                    <td>@_nutritionTotalPotassium.ToString("N0") mg</td>
                                    <td>@AveragePerActiveDay(_nutritionTotalPotassium).ToString("N0") mg</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </article>

                <article class="dashboard-card report-detail-panel">
                    <div class="card-heading">
                        <div>
                            <span>Archive</span>
                            <h2>Recent Report Notes</h2>
                        </div>
                    </div>

                    <div class="report-note-list">
                        @foreach (var note in ReportNotes)
                        {
                            <div class="attention-row">
                                <span class="attention-marker marker-info"></span>
                                <div>
                                    <strong>@note.Title</strong>
                                    <p>@note.Detail</p>
                                </div>
                            </div>
                        }
                    </div>
                </article>
            </section>

            @if (ActiveNutrientReport is { } report)
            {
                <div class="modal-backdrop" role="presentation" @onclick="DismissNutrientReport">
                    <section class="info-modal nutrient-report-modal" role="dialog" aria-modal="true" aria-labelledby="nutrient-report-title" @onclick:stopPropagation="true">
                        <div class="info-modal-header">
                            <div>
                                <span>Actionable Nutrition</span>
                                <h2 id="nutrient-report-title">@report.Title</h2>
                            </div>
                            <button type="button" class="modal-close-button" aria-label="Close nutrient report" @onclick="DismissNutrientReport">×</button>
                        </div>

                        <dl class="action-report-list">
                            <div>
                                <dt>Target</dt>
                                <dd>@report.Target</dd>
                            </div>
                            <div>
                                <dt>Average</dt>
                                <dd>@report.Average</dd>
                            </div>
                            <div>
                                <dt>@report.DaysLabel</dt>
                                <dd>@report.DaysText</dd>
                            </div>
                            <div>
                                <dt>@report.VarianceLabel</dt>
                                <dd>@report.Variance</dd>
                            </div>
                            <div>
                                <dt>Highest Day</dt>
                                <dd>@report.HighestDay</dd>
                            </div>
                            <div>
                                <dt>Lowest Day</dt>
                                <dd>@report.LowestDay</dd>
                            </div>
                        </dl>

                        @RenderSourceList(report.SourceTitle, report.Sources, report.Unit)
                    </section>
                </div>
            }

            <p class="dashboard-disclosure">
                ActiveVitals reports are for personal tracking and awareness only, not medical diagnosis or treatment advice.
            </p>
        </main>
    </section>
}

@code {
    private readonly List<WeightReading> _weightHistory = [];
    private readonly List<ExerciseSession> _exerciseHistory = [];
    private readonly List<FoodPhosphorusIntake> _nutritionHistory = [];
    private readonly List<BloodPressureReading> _bloodPressureHistory = [];
    private readonly List<BloodGlucoseReading> _glucoseHistory = [];
    private readonly List<ExerciseSession> _recentExercise = [];
    private readonly List<FoodPhosphorusIntake> _recentNutrition = [];
    private string? _message;
    private string _messageClass = "page-message";
    private bool _showKidneyLabs;
    private string? _activeNutrientReportKey;
    private NutritionCoachSnapshot? _coachSnapshot;
    private NutritionCoachReview? _coachReview;
    private DateTime? _coachReviewCreatedAt;
    private bool _isGeneratingCoachReview;
    private string? _coachError;
    private NutritionGoal? _nutritionGoal;
    private int _nutritionActiveDays;
    private int _nutritionPhosphorusDaysInTarget;
    private int _nutritionSodiumDaysInTarget;
    private decimal _nutritionTotalPhosphorus;
    private decimal _nutritionTotalSodium;
    private decimal _nutritionTotalCalories;
    private decimal _nutritionTotalProtein;
    private decimal _nutritionTotalPotassium;
    private decimal _nutritionAverageCalories;
    private int _sodiumTargetMg = 2000;
    private decimal _sodiumAverage;
    private decimal _sodiumAverageExcess;
    private int _sodiumDaysInWindow = 30;
    private int _sodiumDaysWithinGoal;
    private DateTime? _sodiumHighestDate;
    private int? _sodiumHighestMg;
    private DateTime? _sodiumLowestDate;
    private int? _sodiumLowestMg;
    private readonly List<NutrientSource> _topSodiumSources = [];
    private readonly List<MealSodiumSummary> _mealSodiumSummaries = [];
    private int _phosphorusTargetMg = 1000;
    private decimal _phosphorusAverage;
    private decimal _phosphorusAverageExcess;
    private int _phosphorusDaysWithinGoal;
    private DateTime? _phosphorusHighestDate;
    private int? _phosphorusHighestMg;
    private DateTime? _phosphorusLowestDate;
    private int? _phosphorusLowestMg;
    private readonly List<NutrientSource> _topPhosphorusSources = [];
    private decimal _proteinTargetG = 60;
    private decimal _proteinAverage;
    private decimal _proteinAverageGap;
    private int _proteinDaysMeetingTarget;
    private DateTime? _proteinHighestDate;
    private decimal? _proteinHighestG;
    private DateTime? _proteinLowestDate;
    private decimal? _proteinLowestG;
    private readonly List<NutrientSource> _topProteinSources = [];
    private int _potassiumTargetMg = 2000;
    private decimal _potassiumAverage;
    private decimal _potassiumAverageExcess;
    private int _potassiumDaysWithinGoal;
    private DateTime? _potassiumHighestDate;
    private int? _potassiumHighestMg;
    private DateTime? _potassiumLowestDate;
    private int? _potassiumLowestMg;
    private readonly List<NutrientSource> _topPotassiumSources = [];
    private decimal _exerciseTotalMinutes;
    private decimal _exerciseAverageMinutes;
    private int _exerciseActiveDays;

    protected override async Task OnInitializedAsync()
    {
        await LoginSession.RestoreAsync();

        if (!LoginSession.IsSignedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        LoadReports();
        StateHasChanged();
    }

    private string ReportSummaryTitle =>
        _weightHistory.Count + _exerciseHistory.Count + _nutritionHistory.Count + _bloodPressureHistory.Count + _glucoseHistory.Count == 0
            ? "No report data yet"
            : "Simple reports are ready";

    private bool CanGenerateCoachReview =>
        !LoginSession.IsDemo && !_isGeneratingCoachReview && _coachSnapshot?.DaysLogged > 0;

    private string CoachPeriodText => _coachSnapshot is null
        ? "Last 7 days"
        : $"{_coachSnapshot.PeriodStart:MMM d} - {_coachSnapshot.PeriodEnd:MMM d, yyyy}";

    private WeightReading? LatestWeight => _weightHistory.FirstOrDefault();

    private WeightReading? StartingWeight => _weightHistory
        .OrderBy(x => x.ReadingTime)
        .FirstOrDefault();

    private string WeightStartText => StartingWeight is null
        ? "--"
        : $"{StartingWeight.WeightValue:N1} {StartingWeight.WeightUnit}";

    private string WeightLatestText => LatestWeight is null
        ? "--"
        : $"{LatestWeight.WeightValue:N1} {LatestWeight.WeightUnit}";

    private decimal? WeightChange => LatestWeight is null || StartingWeight is null
        ? null
        : LatestWeight.WeightValue - StartingWeight.WeightValue;

    private string WeightChangeText => WeightChange.HasValue
        ? $"{WeightChange.Value:+0.0;-0.0;0.0} lb"
        : "No trend yet";

    private string WeightStatusText => WeightChange switch
    {
        < 0 => "Down",
        > 0 => "Up",
        0 => "Stable",
        _ => "Waiting"
    };

    private string WeightStatusClass => WeightChange switch
    {
        < 0 => "status-pill status-ok",
        > 0 => "status-pill status-watch",
        _ => "status-pill status-info"
    };

    private string NutritionComplianceText => _nutritionActiveDays == 0
        ? "--"
        : $"{Math.Round((_nutritionPhosphorusDaysInTarget + _nutritionSodiumDaysInTarget) / (decimal)(_nutritionActiveDays * 2) * 100m)}%";

    private string PhosphorusComplianceText => _nutritionActiveDays == 0
        ? "--"
        : $"{Math.Round(_nutritionPhosphorusDaysInTarget / (decimal)_nutritionActiveDays * 100m)}% ({_nutritionPhosphorusDaysInTarget} of {_nutritionActiveDays} days)";

    private string SodiumComplianceText => _nutritionActiveDays == 0
        ? "--"
        : $"{Math.Round(_nutritionSodiumDaysInTarget / (decimal)_nutritionActiveDays * 100m)}% ({_nutritionSodiumDaysInTarget} of {_nutritionActiveDays} days)";

    private string SodiumAverageText => _nutritionActiveDays == 0
        ? "--"
        : $"{_sodiumAverage:N0} mg/day";

    private string SodiumDaysWithinGoalText => _nutritionActiveDays == 0
        ? "--"
        : $"{_sodiumDaysWithinGoal} of {_sodiumDaysInWindow} ({Math.Round(_sodiumDaysWithinGoal / (decimal)_sodiumDaysInWindow * 100m)}%)";

    private string SodiumAverageExcessText => _nutritionActiveDays == 0
        ? "--"
        : $"{_sodiumAverageExcess:N0} mg/day";

    private string SodiumHighestDayText => _sodiumHighestMg.HasValue
        ? $"{_sodiumHighestMg.Value:N0} mg on {_sodiumHighestDate:M/d}"
        : "--";

    private string SodiumLowestDayText => _sodiumLowestMg.HasValue
        ? $"{_sodiumLowestMg.Value:N0} mg on {_sodiumLowestDate:M/d}"
        : "--";

    private string SodiumStatusText => _nutritionActiveDays == 0
        ? "Waiting"
        : _sodiumAverage <= _sodiumTargetMg ? "On Track" : "Over";

    private string SodiumStatusClass => _nutritionActiveDays == 0
        ? "status-pill status-info"
        : _sodiumAverage <= _sodiumTargetMg ? "status-pill status-ok" : "status-pill status-watch";

    private string PhosphorusAverageText => _nutritionActiveDays == 0
        ? "--"
        : $"{_phosphorusAverage:N0} mg/day";

    private string PhosphorusDaysWithinGoalText => _nutritionActiveDays == 0
        ? "--"
        : $"{_phosphorusDaysWithinGoal} of {_sodiumDaysInWindow} ({Math.Round(_phosphorusDaysWithinGoal / (decimal)_sodiumDaysInWindow * 100m)}%)";

    private string PhosphorusAverageExcessText => _nutritionActiveDays == 0
        ? "--"
        : $"{_phosphorusAverageExcess:N0} mg/day";

    private string PhosphorusHighestDayText => _phosphorusHighestMg.HasValue
        ? $"{_phosphorusHighestMg.Value:N0} mg on {_phosphorusHighestDate:M/d}"
        : "--";

    private string PhosphorusLowestDayText => _phosphorusLowestMg.HasValue
        ? $"{_phosphorusLowestMg.Value:N0} mg on {_phosphorusLowestDate:M/d}"
        : "--";

    private string PhosphorusStatusText => _nutritionActiveDays == 0
        ? "Waiting"
        : _phosphorusAverage <= _phosphorusTargetMg ? "On Track" : "Over";

