    private int MonthlyEntryCount
    {
        get
        {
            var start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            return _bloodPressureHistory.Count(x => x.ReadingTime >= start)
                + _glucoseHistory.Count(x => x.ReadingTime >= start)
                + _weightHistory.Count(x => x.ReadingTime >= start)
                + _exerciseHistory.Count(x => x.StartTime >= start)
                + _nutritionHistory.Count(x => x.ConsumedAt >= start);
        }
    }

