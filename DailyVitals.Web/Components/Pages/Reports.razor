        new("Nutrition compliance", _nutritionActiveDays > 0 ? $"Compared logged days against current phosphorus and sodium targets." : "Add nutrition entries to build compliance reporting."),
        new("Exercise consistency", _recentExercise.Count > 0 ? $"{_recentExercise.Count} sessions logged in the last 30 days." : "Add exercise sessions to measure consistency."),
        new("Monthly summary", $"{DateTime.Today:MMMM yyyy} includes {MonthlyEntryCount} logged records across active sections.")
    ];

    private void LoadReports()
    {
        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            return;
        }

        try
        {
            var personId = LoginSession.PersonId.Value;
            var person = PersonService.GetPersonById(personId);
            _showKidneyLabs = person?.TrackKidneyLabs == true;
            _nutritionGoal = NutritionGoalService.GetActiveGoal(personId, DateTime.Today);

            _weightHistory.Clear();
            _exerciseHistory.Clear();
            _nutritionHistory.Clear();
            _bloodPressureHistory.Clear();
            _glucoseHistory.Clear();
            _recentExercise.Clear();
            _recentNutrition.Clear();

            _weightHistory.AddRange(WeightService.GetHistory(personId));
            _exerciseHistory.AddRange(ExerciseService.GetHistory(personId));
            _nutritionHistory.AddRange(FoodService.GetHistory(personId));
            _bloodPressureHistory.AddRange(BloodPressureService.GetHistoryForPerson(personId));
            _glucoseHistory.AddRange(BloodGlucoseService.GetHistory(personId));

            var recentStart = DateTime.Today.AddDays(-29);
            _recentExercise.AddRange(_exerciseHistory.Where(x => x.StartTime.Date >= recentStart));
            _recentNutrition.AddRange(_nutritionHistory.Where(x => x.ConsumedAt.Date >= recentStart));

            BuildNutritionReport();
            BuildExerciseReport();
            _coachSnapshot = NutritionCoachService.BuildSnapshot(
                _nutritionHistory,
                _nutritionGoal,
                DateTime.Today);
            var storedCoachReview = NutritionCoachService.GetLatestSuccessfulReview(
                personId,
                _coachSnapshot.PeriodStart,
                _coachSnapshot.PeriodEnd);
            _coachReview = storedCoachReview?.Review;
            _coachReviewCreatedAt = storedCoachReview?.CreatedAt;
            _coachError = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reports data load failed.");
            ShowError("Reports could not be loaded. Please try again.");
        }
    }

    private void BuildNutritionReport()
    {
        var daily = _recentNutrition
            .GroupBy(x => x.ConsumedAt.Date)
            .Select(group => new
            {
                Day = group.Key,
                Phosphorus = group.Sum(x => x.PhosphorusMg),
                Sodium = group.Sum(x => x.SodiumMg ?? 0),
                Calories = group.Sum(x => x.Calories ?? 0),
                Protein = group.Sum(x => x.ProteinG ?? 0),
                Potassium = group.Sum(x => x.PotassiumMg ?? 0)
            })
            .ToList();

        _nutritionActiveDays = daily.Count;
        _nutritionTotalPhosphorus = daily.Sum(x => x.Phosphorus);
        _nutritionTotalSodium = daily.Sum(x => x.Sodium);
        _nutritionTotalCalories = daily.Sum(x => x.Calories);
        _nutritionTotalProtein = daily.Sum(x => x.Protein);
        _nutritionTotalPotassium = daily.Sum(x => x.Potassium);
        _nutritionAverageCalories = AveragePerActiveDay(_nutritionTotalCalories);

        var phosphorusLimit = _nutritionGoal?.PhosphorusLimitMg ?? 1000;
        var sodiumLimit = _nutritionGoal?.SodiumLimitMg ?? 2000;
        var proteinTarget = _nutritionGoal?.ProteinTargetG ?? 60;
        var potassiumLimit = _nutritionGoal?.PotassiumLimitMg ?? 2000;
        _nutritionPhosphorusDaysInTarget = daily.Count(x => x.Phosphorus <= phosphorusLimit);
        _nutritionSodiumDaysInTarget = daily.Count(x => x.Sodium <= sodiumLimit);

        _sodiumTargetMg = sodiumLimit;
        _sodiumDaysInWindow = 30;
        _sodiumDaysWithinGoal = daily.Count(x => x.Sodium <= sodiumLimit);
        _sodiumAverage = AveragePerActiveDay(_nutritionTotalSodium);
        _sodiumAverageExcess = Math.Max(0, _sodiumAverage - sodiumLimit);
        BuildMealSodiumReport();

        var highestSodiumDay = daily
            .OrderByDescending(x => x.Sodium)
            .ThenByDescending(x => x.Day)
            .FirstOrDefault();
        _sodiumHighestDate = highestSodiumDay?.Day;
        _sodiumHighestMg = highestSodiumDay?.Sodium;

        var lowestSodiumDay = daily
            .Where(x => x.Sodium > 0)
            .OrderBy(x => x.Sodium)
            .ThenByDescending(x => x.Day)
            .FirstOrDefault();
        _sodiumLowestDate = lowestSodiumDay?.Day;
        _sodiumLowestMg = lowestSodiumDay?.Sodium;

        _topSodiumSources.Clear();
        _topSodiumSources.AddRange(_recentNutrition
            .Where(x => (x.SodiumMg ?? 0) > 0)
            .GroupBy(x => x.FoodName.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(group => new NutrientSource(
                group.First().FoodName.Trim(),
                group.Sum(x => x.SodiumMg ?? 0)))
            .OrderByDescending(x => x.Amount)
            .ThenBy(x => x.FoodName)
            .Take(4));

        _phosphorusTargetMg = phosphorusLimit;
        _phosphorusDaysWithinGoal = daily.Count(x => x.Phosphorus <= phosphorusLimit);
        _phosphorusAverage = AveragePerActiveDay(_nutritionTotalPhosphorus);
        _phosphorusAverageExcess = Math.Max(0, _phosphorusAverage - phosphorusLimit);

        var highestPhosphorusDay = daily
            .OrderByDescending(x => x.Phosphorus)
            .ThenByDescending(x => x.Day)
            .FirstOrDefault();
        _phosphorusHighestDate = highestPhosphorusDay?.Day;
        _phosphorusHighestMg = highestPhosphorusDay?.Phosphorus;

        var lowestPhosphorusDay = daily
            .Where(x => x.Phosphorus > 0)
            .OrderBy(x => x.Phosphorus)
            .ThenByDescending(x => x.Day)
            .FirstOrDefault();
        _phosphorusLowestDate = lowestPhosphorusDay?.Day;
        _phosphorusLowestMg = lowestPhosphorusDay?.Phosphorus;

        _topPhosphorusSources.Clear();
        _topPhosphorusSources.AddRange(_recentNutrition
            .Where(x => x.PhosphorusMg > 0)
            .GroupBy(x => x.FoodName.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(group => new NutrientSource(
                group.First().FoodName.Trim(),
                group.Sum(x => x.PhosphorusMg)))
            .OrderByDescending(x => x.Amount)
            .ThenBy(x => x.FoodName)
            .Take(4));

        _proteinTargetG = proteinTarget;
        _proteinDaysMeetingTarget = daily.Count(x => x.Protein >= proteinTarget);
        _proteinAverage = AveragePerActiveDay(_nutritionTotalProtein);
        _proteinAverageGap = Math.Max(0, proteinTarget - _proteinAverage);

        var highestProteinDay = daily
            .OrderByDescending(x => x.Protein)
            .ThenByDescending(x => x.Day)
            .FirstOrDefault();
        _proteinHighestDate = highestProteinDay?.Day;
        _proteinHighestG = highestProteinDay?.Protein;

        var lowestProteinDay = daily
            .Where(x => x.Protein > 0)
            .OrderBy(x => x.Protein)
            .ThenByDescending(x => x.Day)
            .FirstOrDefault();
        _proteinLowestDate = lowestProteinDay?.Day;
        _proteinLowestG = lowestProteinDay?.Protein;

        _topProteinSources.Clear();
        _topProteinSources.AddRange(_recentNutrition
            .Where(x => (x.ProteinG ?? 0) > 0)
            .GroupBy(x => x.FoodName.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(group => new NutrientSource(
                group.First().FoodName.Trim(),
                group.Sum(x => x.ProteinG ?? 0)))
            .OrderByDescending(x => x.Amount)
            .ThenBy(x => x.FoodName)
            .Take(4));

        _potassiumTargetMg = potassiumLimit;
        _potassiumDaysWithinGoal = daily.Count(x => x.Potassium <= potassiumLimit);
        _potassiumAverage = AveragePerActiveDay(_nutritionTotalPotassium);
        _potassiumAverageExcess = Math.Max(0, _potassiumAverage - potassiumLimit);

        var highestPotassiumDay = daily
            .OrderByDescending(x => x.Potassium)
            .ThenByDescending(x => x.Day)
            .FirstOrDefault();
        _potassiumHighestDate = highestPotassiumDay?.Day;
        _potassiumHighestMg = highestPotassiumDay?.Potassium;

        var lowestPotassiumDay = daily
            .Where(x => x.Potassium > 0)
            .OrderBy(x => x.Potassium)
            .ThenByDescending(x => x.Day)
            .FirstOrDefault();
        _potassiumLowestDate = lowestPotassiumDay?.Day;
        _potassiumLowestMg = lowestPotassiumDay?.Potassium;

        _topPotassiumSources.Clear();
        _topPotassiumSources.AddRange(_recentNutrition
            .Where(x => (x.PotassiumMg ?? 0) > 0)
            .GroupBy(x => x.FoodName.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(group => new NutrientSource(
                group.First().FoodName.Trim(),
                group.Sum(x => x.PotassiumMg ?? 0)))
            .OrderByDescending(x => x.Amount)
            .ThenBy(x => x.FoodName)
            .Take(4));
    }

    private void BuildMealSodiumReport()
    {
        var totals = _recentNutrition
            .Where(x => (x.SodiumMg ?? 0) > 0)
            .GroupBy(x => NormalizeMealType(x.MealType))
            .ToDictionary(group => group.Key, group => group.Sum(x => x.SodiumMg ?? 0));

        _mealSodiumSummaries.Clear();
        foreach (var name in new[] { "Breakfast", "Lunch", "Dinner", "Snacks", "Unassigned" })
        {
            var total = totals.GetValueOrDefault(name);
            if (name == "Unassigned" && total == 0)
                continue;

            var percentage = _nutritionTotalSodium <= 0
                ? 0
                : Math.Round(total / _nutritionTotalSodium * 100m);

            _mealSodiumSummaries.Add(new MealSodiumSummary(
                name,
                AveragePerActiveDay(total),
                percentage));
        }
    }

    private static string NormalizeMealType(string? mealType) => mealType switch
    {
        "Breakfast" => "Breakfast",
        "Lunch" => "Lunch",
        "Dinner" => "Dinner",
        "Snack" => "Snacks",
        _ => "Unassigned"
    };

    private void BuildExerciseReport()
    {
        _exerciseTotalMinutes = _recentExercise.Sum(x => x.DurationMinutes);
        _exerciseAverageMinutes = _recentExercise.Count == 0
            ? 0
            : _exerciseTotalMinutes / _recentExercise.Count;
        _exerciseActiveDays = _recentExercise.Select(x => x.StartTime.Date).Distinct().Count();
    }

    private decimal AveragePerActiveDay(decimal value) => _nutritionActiveDays == 0
        ? 0
        : value / _nutritionActiveDays;

    private static string FormatMinutes(decimal minutes)
    {
        var rounded = (int)Math.Round(minutes);
        var hours = rounded / 60;
        var mins = rounded % 60;

        return hours > 0
            ? $"{hours} hr {mins} min"
            : $"{mins} min";
    }

