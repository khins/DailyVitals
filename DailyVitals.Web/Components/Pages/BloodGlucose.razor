@page "/blood-glucose"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using DailyVitals.Data.Services
@using DailyVitals.Domain.Models
@using DailyVitals.Web.Services
@inject BloodGlucoseService BloodGlucoseService
@inject PersonService PersonService
@inject LocalLoginSession LoginSession
@inject NavigationManager Navigation

<PageTitle>Blood Glucose | DailyVitals</PageTitle>

@if (LoginSession.IsSignedIn)
{
    <section class="dashboard-shell">
        <aside class="dashboard-rail" aria-label="Primary navigation">
            <div class="rail-brand">
                <span class="brand-mark brand-mark--compact" aria-hidden="true">DV</span>
                <span>DailyVitals</span>
            </div>

            <nav class="rail-nav">
                <a href="dashboard">Dashboard</a>
                <a href="blood-pressure">Blood Pressure</a>
                <a class="is-active" href="blood-glucose">Glucose</a>
                <a href="weight">Weight</a>
                <a href="exercise">Exercise</a>
                <a href="nutrition">Nutrition</a>
                @if (_showKidneyLabs)
                {
                    <a href="labs">Kidney Labs</a>
                }
            </nav>

            <a class="rail-profile" href="profile" aria-label="Profile">
                <span class="profile-icon" aria-hidden="true"></span>
                <span>Profile</span>
            </a>

            <button type="button" class="rail-signout" @onclick="SignOut">Sign out</button>
        </aside>

        <main class="dashboard-main">
            <header class="dashboard-topbar">
                <div>
                    <p class="eyebrow">DailyVitals Web</p>
                    <h1>Blood Glucose</h1>
                </div>

                <div class="dashboard-actions">
                    <div class="person-switcher">
                        <span>Person</span>
                        <strong>@LoginSession.UserName</strong>
                    </div>
                    <button type="button" class="primary-action" @onclick="BeginNewReading">New Reading</button>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="@_messageClass" role="status">@_message</div>
            }

            <section class="@SeverityBandClass" aria-label="Current blood glucose status">
                <div>
                    <span class="status-dot"></span>
                    <strong>@SeverityText</strong>
                    <p>@SeveritySummary</p>
                </div>
                <div>
                    <span>Latest reading</span>
                    <strong>@LatestReadingText</strong>
                </div>
            </section>

            <section class="entry-grid">
                <article class="dashboard-card entry-panel">
                    <div class="card-heading">
                        <div>
                            <span>@(_editingId.HasValue ? "Edit Reading" : "New Reading")</span>
                            <h2>Details</h2>
                        </div>
                    </div>

                    <EditForm Model="_form" FormName="blood-glucose-entry-form" OnValidSubmit="SaveReading" class="bp-form">
                        <DataAnnotationsValidator />

                        <div class="form-row">
                            <label for="reading-time">Reading Time</label>
                            <input id="reading-time" class="form-input" type="datetime-local" value="@_readingTimeText" @onchange="SetReadingTime" />
                        </div>

                        <div class="glucose-number-grid">
                            <div class="field-group">
                                <label for="glucose">Glucose (mg/dL)</label>
                                <InputNumber id="glucose" class="form-input" @bind-Value="_form.GlucoseValue" />
                                <ValidationMessage For="() => _form.GlucoseValue" />
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="notes">Notes</label>
                            <InputTextArea id="notes" class="form-input notes-input" @bind-Value="_form.Notes" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(AuditText))
                        {
                            <p class="audit-text">@AuditText</p>
                        }

                        <div class="form-command-row">
                            <button type="button" class="secondary-link" @onclick="BeginNewReading">New</button>
                            <button type="button" class="secondary-link" @onclick="DeleteSelected" disabled="@(!_editingId.HasValue)">Delete</button>
                            <button type="submit" class="primary-action">Save</button>
                        </div>
                    </EditForm>
                </article>

                <article class="dashboard-card history-panel">
                    <div class="card-heading">
                        <div>
                            <span>History</span>
                            <h2>Recent Readings</h2>
                        </div>
                        <strong>@_history.Count entries</strong>
                    </div>

                    @if (_history.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No readings yet</h2>
                            <p>Save a blood glucose reading to start this person's history.</p>
                        </div>
                    }
                    else
                    {
                        <div class="data-table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Glucose</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var reading in _history)
                                    {
                                        <tr class="@(reading.GlucoseId == _editingId ? "is-selected" : null)" @onclick="() => SelectReading(reading)">
                                            <td>@reading.ReadingTime.ToString("M/d/yyyy h:mm tt")</td>
                                            <td>@reading.GlucoseValue</td>
                                            <td>@reading.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            </section>
        </main>
    </section>
}

@code {
    private readonly BloodGlucoseForm _form = new();
    private readonly List<BloodGlucoseReading> _history = [];
    private long? _editingId;
    private DateTime? _createdAt;
    private DateTime? _updatedAt;
    private bool _showKidneyLabs = true;
    private string _readingTimeText = ToDateTimeLocal(DateTime.Now);
    private string? _message;
    private string _messageClass = "page-message";

    protected override void OnInitialized()
    {
        ResetForm();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoginSession.RestoreAsync();

        if (!LoginSession.IsSignedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            StateHasChanged();
            return;
        }

        LoadPersonPreferences();
        LoadHistory();
        StateHasChanged();
    }

    private void LoadPersonPreferences()
    {
        if (!LoginSession.PersonId.HasValue)
            return;

        _showKidneyLabs = PersonService.GetPersonById(LoginSession.PersonId.Value)?.TrackKidneyLabs ?? true;
    }

    private string SeverityText
    {
        get
        {
            if (!_form.GlucoseValue.HasValue)
                return "Ready";

            if (_form.GlucoseValue.Value < 70)
                return "Low";

            if (_form.GlucoseValue.Value <= 140)
                return "In range";

            return "High";
        }
    }

    private string SeverityBandClass =>
        SeverityText switch
        {
            "In range" => "status-band status-band--ok",
            "Low" => "status-band status-band--watch",
            "High" => "status-band status-band--high",
            _ => "status-band"
        };

    private string SeveritySummary =>
        SeverityText switch
        {
            "In range" => "This reading is inside the common tracking range.",
            "Low" => "This reading is below the common tracking range.",
            "High" => "This reading is above the common tracking range.",
            _ => "Enter a glucose value to classify the reading."
        };

    private string LatestReadingText =>
        _history.Count == 0
            ? "None yet"
            : $"{_history[0].GlucoseValue} mg/dL on {_history[0].ReadingTime:M/d/yyyy}";

    private string AuditText
    {
        get
        {
            if (_updatedAt.HasValue)
                return $"Updated at: {_updatedAt.Value:g}";

            if (_createdAt.HasValue)
                return $"Created at: {_createdAt.Value:g}";

            return string.Empty;
        }
    }

    private void LoadHistory()
    {
        _history.Clear();

        if (!LoginSession.PersonId.HasValue)
            return;

        _history.AddRange(BloodGlucoseService.GetHistory(LoginSession.PersonId.Value));
    }

    private void SelectReading(BloodGlucoseReading reading)
    {
        _editingId = reading.GlucoseId;
        _form.GlucoseValue = Convert.ToInt32(reading.GlucoseValue);
        _form.Notes = reading.Notes ?? string.Empty;
        _readingTimeText = ToDateTimeLocal(reading.ReadingTime);
        _createdAt = reading.CreatedAt;
        _updatedAt = reading.UpdatedAt;
        _message = null;
    }

    private void BeginNewReading()
    {
        ResetForm();
        _message = null;
    }

    private void SetReadingTime(ChangeEventArgs args)
    {
        _readingTimeText = args.Value?.ToString() ?? string.Empty;
    }

    private void ResetForm()
    {
        _editingId = null;
        _form.GlucoseValue = null;
        _form.Notes = "Morning reading";
        _readingTimeText = ToDateTimeLocal(DateTime.Now);
        _createdAt = null;
        _updatedAt = null;
    }

    private void SaveReading()
    {
        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            return;
        }

        if (!TryGetReadingTime(out var readingTime))
            return;

        if (!_form.GlucoseValue.HasValue || _form.GlucoseValue.Value <= 0)
        {
            ShowError("Enter a valid glucose value.");
            return;
        }

        var personId = LoginSession.PersonId.Value;
        var notes = _form.Notes ?? string.Empty;

        try
        {
            if (_editingId.HasValue)
            {
                BloodGlucoseService.Update(
                    _editingId.Value,
                    personId,
                    _form.GlucoseValue.Value,
                    readingTime,
                    notes,
                    LoginSession.UserName ?? string.Empty);

                ShowSuccess("Blood glucose reading updated.");
            }
            else
            {
                _editingId = BloodGlucoseService.Insert(
                    personId,
                    _form.GlucoseValue.Value,
                    readingTime,
                    notes,
                    LoginSession.UserName ?? string.Empty);

                ShowSuccess("Blood glucose reading saved.");
            }

            LoadHistory();

            var selected = _history.FirstOrDefault(x => x.GlucoseId == _editingId);
            if (selected is not null)
                SelectReading(selected);
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private void DeleteSelected()
    {
        if (!_editingId.HasValue || !LoginSession.PersonId.HasValue)
            return;

        try
        {
            var deleted = BloodGlucoseService.DeleteBloodGlucoseForPerson(
                LoginSession.PersonId.Value,
                _editingId.Value);

            if (!deleted)
            {
                ShowError("The selected blood glucose record could not be deleted.");
                return;
            }

            LoadHistory();
            ResetForm();
            ShowSuccess("Blood glucose reading deleted.");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private bool TryGetReadingTime(out DateTime readingTime)
    {
        if (DateTime.TryParse(_readingTimeText, out readingTime))
            return true;

        ShowError("Enter a valid reading time.");
        return false;
    }

    private void ShowSuccess(string message)
    {
        _messageClass = "page-message";
        _message = message;
    }

    private void ShowError(string message)
    {
        _messageClass = "page-message page-message--error";
        _message = message;
    }

    private async Task SignOut()
    {
        await LoginSession.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private static string ToDateTimeLocal(DateTime value) => value.ToString("yyyy-MM-ddTHH:mm");

    private sealed class BloodGlucoseForm
    {
        [Required]
        [Range(1, 1000)]
        public int? GlucoseValue { get; set; }

        public string? Notes { get; set; }
    }
}
