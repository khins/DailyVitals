@page "/contact"
@layout MarketingLayout

<PageTitle>Contact and Support | My Active Vitals</PageTitle>

<section class="contact-page">
    <p class="marketing-kicker">Contact and support</p>
    <h1>How can we help?</h1>
    <p>Send us a message about account access, product questions, privacy requests, billing plans, or technical problems. Please do not include medical details, passwords, or full payment information in email.</p>

    <div class="contact-grid">
        <article class="contact-card">
            <h2>Product support</h2>
            <p>For sign-in issues, questions about tracking, or help using My Active Vitals.</p>
            <a href="mailto:support@myactivevitals.com?subject=My%20Active%20Vitals%20support">support@myactivevitals.com</a>
        </article>
        <article class="contact-card">
            <h2>Privacy requests</h2>
            <p>For questions about personal information, access, correction, export, or deletion.</p>
            <a href="mailto:support@myactivevitals.com?subject=Privacy%20request">Send a privacy request</a>
        </article>
    </div>

    <div class="marketing-feature-panel" style="margin-top: 42px;">
        <strong>My Active Vitals is not an emergency service.</strong>
        <p>If you believe you may be experiencing a medical emergency, contact local emergency services immediately. Product support cannot provide medical advice.</p>
    </div>
</section>
