@page "/fluid-intake"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using DailyVitals.Data.Services
@using DailyVitals.Domain.Models
@using FluidIntakeEntry = DailyVitals.Domain.Models.FluidIntake
@using DailyVitals.Web.Services
@inject FluidIntakeService FluidService
@inject PersonService PersonService
@inject LocalLoginSession LoginSession
@inject NavigationManager Navigation
@inject ILogger<FluidIntake> Logger

<PageTitle>Fluid Intake | DailyVitals</PageTitle>

@if (LoginSession.IsSignedIn)
{
    <section class="dashboard-shell @(LoginSession.IsDemo ? "demo-mode" : null)">
        <aside class="dashboard-rail" aria-label="Primary navigation">
            <div class="rail-brand">
                <span class="brand-mark brand-mark--compact" aria-hidden="true">DV</span>
                <span>DailyVitals</span>
            </div>

            <nav class="rail-nav">
                <a href="dashboard">Dashboard</a>
                <a href="blood-pressure">Blood Pressure</a>
                <a href="blood-glucose">Glucose</a>
                <a href="weight">Weight</a>
                <a href="exercise">Exercise</a>
                <a href="reports">Reports</a>
                <a href="nutrition">Nutrition</a>
                <a class="is-active" href="fluid-intake">Fluid Intake</a>
                @if (_showKidneyLabs)
                {
                    <a href="renal-foods">Renal Friendly Foods</a>
                    <a href="labs">Kidney Labs</a>
                }
            </nav>

            <a class="rail-profile" href="profile" aria-label="Profile">
                <span class="profile-icon" aria-hidden="true"></span>
                <span>Profile</span>
            </a>

            <button type="button" class="rail-signout" @onclick="SignOut">Sign out</button>
        </aside>

        <main class="dashboard-main">
            <DemoModeBanner />
            <header class="dashboard-topbar">
                <div>
                    <p class="eyebrow">DailyVitals Web</p>
                    <h1>Fluid Intake</h1>
                </div>

                <div class="dashboard-actions">
                    <div class="person-switcher">
                        <span>Person</span>
                        <strong>@LoginSession.UserName</strong>
                    </div>
                    <button type="button" class="primary-action" @onclick="BeginNewEntry">Add Fluid</button>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="@_messageClass" role="status">@_message</div>
            }

            <section class="status-band status-band--ok" aria-label="Fluid intake summary">
                <div>
                    <span class="status-dot"></span>
                    <strong>@TodayFluidMl.ToString("N0") mL today</strong>
                    <p>@TodayFluidCount fluid @(TodayFluidCount == 1 ? "entry" : "entries") logged for @DateTime.Today.ToString("M/d/yyyy").</p>
                </div>
                <div>
                    <span>Fluid weight estimate</span>
                    <strong>@TodayFluidWeightText</strong>
                </div>
            </section>

            <aside class="renal-fluid-notice" role="note" aria-labelledby="renal-fluid-notice-title">
                <svg class="renal-fluid-notice-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 3 2.7 20h18.6L12 3Zm0 5.2c.6 0 1 .4 1 1v5.2a1 1 0 0 1-2 0V9.2c0-.6.4-1 1-1Zm0 9.8a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4Z" />
                </svg>
                <div>
                    <h2 id="renal-fluid-notice-title">Important for Kidney Disease and Dialysis</h2>
                    <p>Fluid needs and limits can differ substantially for people on dialysis or managing advanced chronic kidney disease. Too much fluid can contribute to fluid overload, breathing problems, blood pressure changes, heart strain, and rapid weight gain between treatments.</p>
                    <p><strong>Do not use general hydration targets to set your intake.</strong> Follow the daily fluid limit prescribed by your nephrologist or care team based on your treatment plan, urine output, and target dry weight.</p>
                </div>
            </aside>

            <section class="entry-grid">
                <article class="dashboard-card entry-panel">
                    <div class="card-heading">
                        <div>
                            <span>@(_editingId.HasValue ? "Edit Intake" : "New Intake")</span>
                            <h2>Fluid Details</h2>
                        </div>
                    </div>

                    <EditForm Model="_form" FormName="fluid-intake-entry-form" OnValidSubmit="SaveEntry" class="bp-form">
                        <DataAnnotationsValidator />

                        <div class="form-row">
                            <label for="consumed-at">Time</label>
                            <input id="consumed-at" class="form-input" type="datetime-local" value="@_consumedAtText" @onchange="SetConsumedAt" />
                        </div>
                        @if (_editingId.HasValue)
                        {
                            <p class="field-hint">Change the time to save a new intake; keep it unchanged to update this entry.</p>
                        }

                        <div class="glucose-number-grid">
                            <div class="field-group">
                                <label for="beverage">Beverage</label>
                                <InputText id="beverage" class="form-input" @bind-Value="_form.BeverageName" />
                                <ValidationMessage For="() => _form.BeverageName" />
                            </div>
                        </div>

                        <div class="fluid-amount-grid">
                            <div class="field-group">
                                <label for="fluid-amount">Amount</label>
                                <InputNumber id="fluid-amount" class="form-input" step="0.1" @bind-Value="_form.Amount" />
                                <ValidationMessage For="() => _form.Amount" />
                            </div>

                            <div class="field-group">
                                <label for="fluid-unit">Unit</label>
                                <InputSelect id="fluid-unit" class="form-input" @bind-Value="_form.Unit">
                                    <option value="fl oz">fl oz</option>
                                    <option value="mL">mL</option>
                                </InputSelect>
                            </div>
                        </div>

                        <p class="helper-text">Enter the amount printed on your container. Fluid ounces are converted to mL automatically.</p>
                        @if (!string.IsNullOrWhiteSpace(FluidConversionPreview))
                        {
                            <p class="field-hint fluid-conversion-preview">@FluidConversionPreview</p>
                        }

                        <div class="field-group">
                            <label for="notes">Notes</label>
                            <InputTextArea id="notes" class="form-input notes-input" @bind-Value="_form.Notes" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(AuditText))
                        {
                            <p class="audit-text">@AuditText</p>
                        }

                        <div class="form-command-row">
                            <button type="button" class="secondary-link" @onclick="BeginNewEntry" disabled="@LoginSession.IsDemo">New</button>
                            <button type="button" class="secondary-link" @onclick="RequestDeleteSelected" disabled="@(LoginSession.IsDemo || !_editingId.HasValue)">Delete</button>
                            <button type="submit" class="primary-action">Save</button>
                        </div>

                    </EditForm>
                </article>

                <article class="dashboard-card history-panel">
                    <div class="card-heading">
                        <div>
                            <span>History</span>
                            <h2>Recent Fluid Intake</h2>
                        </div>
                        <strong>@_history.Count entries</strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_formToast))
                    {
                        <div class="profile-toast history-toast @(_formToastIsError ? "profile-toast--error" : null)" role="status">
                            <span class="profile-toast-icon" aria-hidden="true">@(_formToastIsError ? "!" : "✓")</span>
                            <span class="history-toast-copy">
                                <strong>@_formToast</strong>
                                @if (!string.IsNullOrWhiteSpace(FormToastTimestampText))
                                {
                                    <small>@FormToastTimestampText</small>
                                }
                            </span>
                            <button type="button" aria-label="Dismiss fluid intake message" @onclick="DismissFormToast">×</button>
                        </div>
                    }

                    @if (_history.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No fluid entries yet</h2>
                            <p>Save a fluid intake entry to start this person's history.</p>
                        </div>
                    }
                    else
                    {
                        <div class="data-table-wrap blood-pressure-history-table">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Time</th>
                                        <th>Beverage</th>
                                        <th>Amount</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in _history)
                                    {
                                        <tr class="@(entry.FluidIntakeId == _editingId ? "is-selected" : null)" @onclick="() => SelectEntry(entry)">
                                            <td>@entry.ConsumedAt.ToString("M/d/yyyy h:mm tt")</td>
                                            <td>@entry.BeverageName</td>
                                            <td>
                                                <span>@entry.EnteredAmount.ToString("0.##") @entry.EnteredUnit</span>
                                                @if (entry.EnteredUnit == FluidOuncesUnit)
                                                {
                                                    <small class="fluid-normalized-amount">@entry.FluidMl.ToString("N0") mL</small>
                                                }
                                            </td>
                                            <td>@entry.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            </section>

            @if (_showDeleteConfirm)
            {
                <div class="modal-backdrop" role="presentation" @onclick="CancelDelete">
                    <section class="info-modal confirm-modal" role="dialog" aria-modal="true" aria-labelledby="fluid-delete-title" @onclick:stopPropagation="true">
                        <div class="info-modal-header">
                            <div>
                                <span>Confirm Delete</span>
                                <h2 id="fluid-delete-title">Delete this fluid intake?</h2>
                            </div>
                            <button type="button" class="modal-close-button" aria-label="Cancel delete" @onclick="CancelDelete">×</button>
                        </div>

                        <p class="info-modal-note">This will permanently remove the selected fluid intake entry from history.</p>
                        <p class="confirm-modal-detail">@DeleteEntrySummary</p>

                        <div class="confirm-modal-actions">
                            <button type="button" class="secondary-link" @onclick="CancelDelete">Cancel</button>
                            <button type="button" class="danger-action" @onclick="ConfirmDelete">Delete Intake</button>
                        </div>
                    </section>
                </div>
            }
        </main>
    </section>
}

@code {
    private readonly FluidForm _form = new();
    private readonly List<FluidIntakeEntry> _history = [];
    private long? _editingId;
    private DateTime? _editingConsumedAt;
    private DateTime? _createdAt;
    private DateTime? _updatedAt;
    private bool _showKidneyLabs = true;
    private bool _showDeleteConfirm;
    private string _consumedAtText = ToDateTimeLocal(DateTime.Now);
    private string? _message;
    private string _messageClass = "page-message";
    private string? _formToast;
    private DateTime? _formToastTimestamp;
    private string _formToastTimestampLabel = "Saved at";
    private bool _formToastIsError;

    protected override void OnInitialized()
    {
        ResetForm();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoginSession.RestoreAsync();

        if (!LoginSession.IsSignedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            StateHasChanged();
            return;
        }

        _showKidneyLabs = PersonService.GetPersonById(LoginSession.PersonId.Value)?.TrackKidneyLabs ?? true;
        LoadHistory();
        StateHasChanged();
    }

    private IReadOnlyList<FluidIntakeEntry> TodayEntries =>
        _history
            .Where(x => x.ConsumedAt.Date == DateTime.Today)
            .ToList();

    private int TodayFluidMl => TodayEntries.Sum(x => x.FluidMl);

    private int TodayFluidCount => TodayEntries.Count;

    private string TodayFluidWeightText => TodayFluidMl == 0
        ? "--"
        : $"{TodayFluidMl / 1000m:0.##} kg / {TodayFluidMl / 1000m * 2.20462m:0.##} lb";

    private string DeleteEntrySummary => _editingId.HasValue
        ? $"{_form.BeverageName}, {GetConvertedFluidMl():N0} mL, {_consumedAtText}"
        : "No fluid intake selected.";

    private string FluidConversionPreview
    {
        get
        {
            if (!_form.Amount.HasValue || _form.Amount.Value <= 0)
                return string.Empty;

            var convertedMl = GetConvertedFluidMl();
            return _form.Unit == FluidOuncesUnit
                ? $"{_form.Amount.Value:0.#} fl oz will be stored as {convertedMl:N0} mL."
                : $"This entry will be stored as {convertedMl:N0} mL.";
        }
    }

    private string FormToastTimestampText => _formToastTimestamp.HasValue
        ? $"{_formToastTimestampLabel}: {_formToastTimestamp.Value:g}"
        : string.Empty;

    private string AuditText
    {
        get
        {
            if (_updatedAt.HasValue)
                return $"Updated at: {_updatedAt.Value:g}";

            if (_createdAt.HasValue)
                return $"Created at: {_createdAt.Value:g}";

            return string.Empty;
        }
    }

    private void LoadHistory()
    {
        _history.Clear();

        if (!LoginSession.PersonId.HasValue)
            return;

        _history.AddRange(FluidService.GetHistory(LoginSession.PersonId.Value));
    }

    private void SelectEntry(FluidIntakeEntry entry, bool clearToast = true)
    {
        _editingId = entry.FluidIntakeId;
        _editingConsumedAt = TruncateToMinute(entry.ConsumedAt);
        _consumedAtText = ToDateTimeLocal(entry.ConsumedAt);
        _form.BeverageName = entry.BeverageName;
        _form.Amount = entry.EnteredAmount;
        _form.Unit = entry.EnteredUnit;
        _form.Notes = entry.Notes ?? string.Empty;
        _createdAt = entry.CreatedAt;
        _updatedAt = entry.UpdatedAt;
        _message = null;
        _showDeleteConfirm = false;
        if (clearToast)
            _formToast = null;
    }

    private void BeginNewEntry()
    {
        ResetForm();
        _message = null;
        _formToast = null;
        _showDeleteConfirm = false;
    }

    private void SetConsumedAt(ChangeEventArgs args)
    {
        _consumedAtText = args.Value?.ToString() ?? string.Empty;
    }

    private void ResetForm()
    {
        _editingId = null;
        _editingConsumedAt = null;
        _consumedAtText = ToDateTimeLocal(DateTime.Now);
        _form.BeverageName = "Water";
        _form.Amount = null;
        _form.Unit = FluidOuncesUnit;
        _form.Notes = string.Empty;
        _createdAt = null;
        _updatedAt = null;
    }

    private void SaveEntry()
    {
        if (LoginSession.IsDemo)
        {
            ShowError(DemoModeGuard.ReadOnlyMessage);
            return;
        }

        _showDeleteConfirm = false;

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            return;
        }

        var beverageName = _form.BeverageName?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(beverageName))
        {
            ShowError("Enter a beverage before saving.");
            return;
        }

        if (beverageName.Length > 120)
        {
            ShowError("Beverage must be 120 characters or less.");
            return;
        }

        if (!TryGetConsumedAt(out var consumedAt))
            return;

        if (!TryGetFluidMl(out var fluidMl))
            return;

        var notes = _form.Notes?.Trim();
        var shouldInsert = !_editingId.HasValue ||
            !_editingConsumedAt.HasValue ||
            _editingConsumedAt.Value != TruncateToMinute(consumedAt);
        var wasEditing = _editingId.HasValue;
        long? savedId = shouldInsert ? null : _editingId;
        var successMessage = string.Empty;

        try
        {
            if (!shouldInsert)
            {
                var updated = FluidService.UpdateForPerson(
                    _editingId!.Value,
                    LoginSession.PersonId.Value,
                    consumedAt,
                    fluidMl,
                    _form.Amount!.Value,
                    _form.Unit,
                    beverageName,
                    notes,
                    LoginSession.UserName ?? string.Empty);

                if (!updated)
                {
                    ShowError("The selected fluid intake could not be updated.");
                    return;
                }

                successMessage = "Fluid intake updated.";
            }
            else
            {
                savedId = FluidService.Insert(
                    LoginSession.PersonId.Value,
                    consumedAt,
                    fluidMl,
                    _form.Amount!.Value,
                    _form.Unit,
                    beverageName,
                    notes,
                    LoginSession.UserName ?? string.Empty);

                successMessage = wasEditing
                    ? "Fluid intake saved as a new entry because the intake time changed."
                    : "Fluid intake saved.";
            }

            LoadHistory();

            var selected = _history.FirstOrDefault(x => x.FluidIntakeId == savedId);
            if (selected is null)
            {
                ShowError("The fluid intake was saved, but it could not be reloaded in history. Refresh the page and try again.");
                return;
            }

            SelectEntry(selected, clearToast: false);
            ShowSuccess(
                successMessage,
                shouldInsert ? selected.CreatedAt : selected.UpdatedAt ?? selected.CreatedAt,
                shouldInsert ? "Saved at" : "Updated at");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fluid intake save failed.");
            ShowError("Fluid intake entry could not be saved. Please try again.");
        }
    }

    private void RequestDeleteSelected()
    {
        if (!_editingId.HasValue)
            return;

        _message = null;
        _formToast = null;
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
    }

    private void ConfirmDelete()
    {
        _showDeleteConfirm = false;
        DeleteSelected();
    }

    private void DeleteSelected()
    {
        if (LoginSession.IsDemo)
        {
            ShowError(DemoModeGuard.ReadOnlyMessage);
            return;
        }

        if (!_editingId.HasValue || !LoginSession.PersonId.HasValue)
            return;

        try
        {
            var deleted = FluidService.DeleteForPerson(
                LoginSession.PersonId.Value,
                _editingId.Value);

            if (!deleted)
            {
                ShowError("The selected fluid intake could not be deleted.");
                return;
            }

            LoadHistory();
            ResetForm();
            ShowSuccess("Fluid intake deleted.", DateTime.Now, "Deleted at");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fluid intake delete failed.");
            ShowError("Fluid intake entry could not be deleted. Please try again.");
        }
    }

    private bool TryGetConsumedAt(out DateTime consumedAt)
    {
        if (DateTime.TryParse(_consumedAtText, out consumedAt))
            return true;

        ShowError("Enter a valid intake time.");
        return false;
    }

    private void ShowSuccess(string message, DateTime? timestamp = null, string timestampLabel = "Saved at")
    {
        _messageClass = "page-message";
        _message = null;
        _formToast = message;
        _formToastTimestamp = timestamp;
        _formToastTimestampLabel = timestampLabel;
        _formToastIsError = false;
    }

    private void ShowError(string message)
    {
        _messageClass = "page-message page-message--error";
        _message = message;
        _formToast = message;
        _formToastTimestamp = null;
        _formToastIsError = true;
    }

    private void DismissFormToast()
    {
        _formToast = null;
        _formToastTimestamp = null;
        _formToastIsError = false;
    }

    private async Task SignOut()
    {
        await LoginSession.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private static string ToDateTimeLocal(DateTime value) => value.ToString("yyyy-MM-ddTHH:mm");

    private static DateTime TruncateToMinute(DateTime value) =>
        new(value.Year, value.Month, value.Day, value.Hour, value.Minute, 0, value.Kind);

    private const string FluidOuncesUnit = "fl oz";
    private const string MillilitersUnit = "mL";
    private const decimal MillilitersPerUsFluidOunce = 29.5735295625m;

    private decimal GetConvertedFluidMl()
    {
        var amount = _form.Amount ?? 0m;
        var milliliters = _form.Unit == FluidOuncesUnit
            ? amount * MillilitersPerUsFluidOunce
            : amount;

        return Math.Round(milliliters, 0, MidpointRounding.AwayFromZero);
    }

    private bool TryGetFluidMl(out int fluidMl)
    {
        fluidMl = 0;
        var convertedMl = GetConvertedFluidMl();

        if (convertedMl < 1m || convertedMl > 10000m)
        {
            ShowError("Fluid amount must convert to between 1 and 10,000 mL.");
            return false;
        }

        fluidMl = decimal.ToInt32(convertedMl);
        return true;
    }

    private sealed class FluidForm
    {
        [Required(ErrorMessage = "Enter a beverage.")]
        [StringLength(120, ErrorMessage = "Beverage must be 120 characters or less.")]
        public string? BeverageName { get; set; }

        [Required(ErrorMessage = "Enter the fluid amount.")]
        [Range(typeof(decimal), "0.1", "10000", ErrorMessage = "Fluid amount must be greater than 0.")]
        public decimal? Amount { get; set; }

        public string Unit { get; set; } = FluidOuncesUnit;

        public string? Notes { get; set; }
    }
}

