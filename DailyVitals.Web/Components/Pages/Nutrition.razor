    private const decimal BinderMgPerPill = 800m;
    private const decimal BinderBindingEfficiency = 0.075m;
    private const decimal BinderPhosphorusReductionMg = BinderMgPerPill * BinderBindingEfficiency;

    private bool IsEstimateDisabled => LoginSession.IsDemo || _isEstimating || string.IsNullOrWhiteSpace(_form.FoodName);

    private void SetPhosphorusMg(ChangeEventArgs args)
    {
        var phosphorusText = args.Value?.ToString();
        int? phosphorusMg = int.TryParse(phosphorusText, out var parsedPhosphorus)
            ? Math.Max(parsedPhosphorus, 0)
            : null;

        _form.PhosphorusMg = phosphorusMg;
        _phosphorusBeforeBinderAdjustment = phosphorusMg;

        if (_form.Binders > 0)
            ApplyBinderAdjustmentToPhosphorus();
    }

    private void SetBindersTaken(ChangeEventArgs args)
    {
        var binderText = args.Value?.ToString();
        var binders = int.TryParse(binderText, out var parsedBinders)
            ? parsedBinders
            : 0;

        _form.Binders = Math.Max(binders, 0);

        if (!_form.PhosphorusMg.HasValue)
            return;

        _phosphorusBeforeBinderAdjustment ??= _form.PhosphorusMg;

        if (_form.Binders == 0)
        {
            _form.PhosphorusMg = _phosphorusBeforeBinderAdjustment;
            _phosphorusBeforeBinderAdjustment = null;
            return;
        }

        ApplyBinderAdjustmentToPhosphorus();
    }

    private void ApplyBinderAdjustmentToPhosphorus()
    {
        if (!_phosphorusBeforeBinderAdjustment.HasValue)
            return;

        var binderReduction = _form.Binders * BinderPhosphorusReductionMg;
        var adjustedPhosphorus = Math.Max(_phosphorusBeforeBinderAdjustment.Value - binderReduction, 0);
        _form.PhosphorusMg = Convert.ToInt32(Math.Round(adjustedPhosphorus));
    }

