    private async Task EstimateFood()
    {
        if (LoginSession.IsDemo)
        {
            ShowError(DemoModeGuard.ReadOnlyMessage);
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.FoodName))
        {
            ShowError("Enter a food item before estimating.");
            return;
        }

        _isEstimating = true;
        _message = null;
        _estimateGuidance = null;

        try
        {
            var estimate = await EstimateService.EstimateAsync(_form.FoodName);
            _form.FoodName = estimate.FoodName;
            _form.PhosphorusMg = estimate.EstimatedPhosphorusMg;
            _phosphorusBeforeBinderAdjustment = estimate.EstimatedPhosphorusMg;
            if (_form.Binders > 0)
                ApplyBinderAdjustmentToPhosphorus();
            _form.Calories = estimate.EstimatedCalories ?? _form.Calories;
            _form.SodiumMg = estimate.EstimatedSodiumMg ?? _form.SodiumMg;
            _form.ProteinG = estimate.EstimatedProteinG ?? _form.ProteinG;
            _form.PotassiumMg = estimate.EstimatedPotassiumMg ?? _form.PotassiumMg;
            _form.ServingDescription = estimate.ServingDescription ?? _form.ServingDescription;
            _form.EstimatedByAi = true;
            _form.AiConfidence = null;
            _form.SourceNotes = null;
            _estimateGuidance = BuildEstimateGuidance(estimate);
            ShowSuccess($"Estimate ready: {estimate.EstimatedPhosphorusMg} mg phosphorus.");
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "Nutrition estimate was rejected.");
            ShowError(ex.Message);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Nutrition estimate could not reach OpenAI.");
            ShowError("AI Lookup could not reach OpenAI. Check the deployment network and try again.");
        }
        catch (JsonException ex)
        {
            Logger.LogError(ex, "Nutrition estimate returned an unreadable response.");
            ShowError("AI Lookup received an unexpected response. Check the configured model and try again.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nutrition estimate failed.");
            ShowError("Nutrition estimate could not be completed. Please try again.");
        }
        finally
        {
            _isEstimating = false;
        }
    }

    private static string? BuildEstimateGuidance(FoodPhosphorusEstimate estimate)
    {
        var guidance = new List<string>();

        if (estimate.RenalRating is >= 1 and <= 5 && !string.IsNullOrWhiteSpace(estimate.RenalReason))
        {
            guidance.Add(
                $"Renal Rating: {BuildStarRating(estimate.RenalRating)}" +
                $"{Environment.NewLine}{Environment.NewLine}" +
                $"Reason: {estimate.RenalReason.Trim()}");
        }

        if (!string.IsNullOrWhiteSpace(estimate.SourceNotes))
            guidance.Add($"Estimate notes: {estimate.SourceNotes.Trim()}");

        return guidance.Count == 0
            ? null
            : string.Join($"{Environment.NewLine}{Environment.NewLine}", guidance);
    }

    private static string BuildStarRating(int rating)
    {
        rating = Math.Clamp(rating, 1, 5);
        return new string('★', rating) + new string('☆', 5 - rating);
    }

    private void SaveEntry()
    {
        if (LoginSession.IsDemo)
        {
            ShowError(DemoModeGuard.ReadOnlyMessage);
            return;
        }

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            return;
        }

        if (!TryGetConsumedAt(out var consumedAt))
        {
            ShowError("Enter a valid date eaten.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.MealType))
        {
            ShowError("Select a meal before saving.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.FoodName))
        {
            ShowError("Food item is required.");
            return;
        }

        if (!_form.PhosphorusMg.HasValue || _form.PhosphorusMg.Value < 0)
        {
            ShowError("Phosphorus must be a non-negative whole number.");
            return;
        }

        if (_form.Calories is < 0 || _form.SodiumMg is < 0 || _form.ProteinG is < 0 || _form.PotassiumMg is < 0 || _form.Binders < 0)
        {
            ShowError("Nutrition values cannot be negative.");
            return;
        }

        var personId = LoginSession.PersonId.Value;
        var shouldInsert = !_editingId.HasValue || (_editingConsumedAt.HasValue && _editingConsumedAt.Value != consumedAt);
        long? savedId = shouldInsert ? null : _editingId;

        try
        {
            if (shouldInsert)
            {
                savedId = FoodService.Insert(
                    personId,
                    _form.FoodName.Trim(),
                    _form.PhosphorusMg.Value,
                    _form.Calories,
                    _form.SodiumMg,
                    _form.ProteinG,
                    _form.PotassiumMg,
                    null,
                    _form.Binders,
                    consumedAt,
                    null,
                    _form.ServingDescription,
                    _form.EstimatedByAi,
                    _form.EstimatedByAi ? "OpenAI" : null,
                    _form.AiConfidence,
                    _form.SourceNotes,
                    LoginSession.UserName ?? string.Empty,
                    _form.MealType);
            }
            else
            {
                FoodService.Update(
                    _editingId!.Value,
                    personId,
                    _form.FoodName.Trim(),
                    _form.PhosphorusMg.Value,
                    _form.Calories,
                    _form.SodiumMg,
                    _form.ProteinG,
                    _form.PotassiumMg,
                    null,
                    _form.Binders,
                    consumedAt,
                    null,
                    _form.ServingDescription,
                    _form.EstimatedByAi,
                    _form.EstimatedByAi ? "OpenAI" : null,
                    _form.AiConfidence,
                    _form.SourceNotes,
                    LoginSession.UserName ?? string.Empty,
                    _form.MealType);
            }

            LoadHistory();
            var selected = _history.FirstOrDefault(x => x.FoodPhosphorusIntakeId == savedId);
            if (selected is not null)
            {
                SaveFoodNotesFor(selected);
                LoadHistory();
                selected = _history.FirstOrDefault(x => x.FoodPhosphorusIntakeId == savedId);
                if (selected is not null)
                    SelectEntry(selected);
            }

            RefreshSelectedDayTotal();
            ShowSuccess(shouldInsert
                ? "Food entry saved. Nutrition values are estimates only and are not intended to be exact results."
                : "Food entry updated. Nutrition values are estimates only and are not intended to be exact results.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nutrition entry save failed.");
            ShowError("Nutrition entry could not be saved. Please try again.");
        }
    }

    private void SaveFoodNotesFor(FoodPhosphorusIntake item)
    {
        var profileId = item.FoodPhosphorusFoodId ?? FoodService.EnsureFoodProfileForIntake(item);
        FoodService.SaveFoodNote(profileId, _foodNotes);
    }

    private void RequestDeleteSelected()
    {
        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            return;
        }

        if (!_editingId.HasValue)
        {
            ShowError("Select an existing food entry from Today's Foods or Nutrition History before deleting.");
            return;
        }

        var item = FindEntryById(_editingId.Value);
        if (item is not null)
            RequestDeleteEntry(item);
        else
            ShowError("The selected food entry is no longer available. Select another entry and try again.");
    }

    private void RequestDeleteEntry(FoodPhosphorusIntake item)
    {
        _message = null;
        _pendingDeleteEntry = item;
    }

    private void CancelDelete()
    {
        _pendingDeleteEntry = null;
    }

    private void ConfirmDelete()
    {
        if (_pendingDeleteEntry is null)
            return;

        var foodPhosphorusIntakeId = _pendingDeleteEntry.FoodPhosphorusIntakeId;
        _pendingDeleteEntry = null;
        DeleteEntryById(foodPhosphorusIntakeId);
    }

    private void DeleteEntryById(long foodPhosphorusIntakeId)
    {
        if (LoginSession.IsDemo)
        {
            ShowError(DemoModeGuard.ReadOnlyMessage);
            return;
        }

        if (!LoginSession.PersonId.HasValue)
            return;

        try
        {
            var deleted = FoodService.DeleteForPerson(LoginSession.PersonId.Value, foodPhosphorusIntakeId);
            if (!deleted)
            {
                ShowError("The selected food entry could not be deleted.");
                return;
            }

            LoadHistory();
            if (_editingId == foodPhosphorusIntakeId)
                ResetForm();
            RefreshSelectedDayTotal();
            EnsureSelectedHistoryRangeIsAvailable();
            ShowSuccess("Food entry deleted.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nutrition entry delete failed.");
            ShowError("Nutrition entry could not be deleted. Please try again.");
        }
    }

    private void RefreshSelectedDayTotal()
