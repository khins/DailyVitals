    private static string ToDateTimeLocal(DateTime value) => value.ToString("yyyy-MM-ddTHH:mm");

    private static string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "--" : value;

    private static NutritionDaySummary BuildDaySummary(DateTime date, IReadOnlyList<FoodPhosphorusIntake> entries) =>
        new()
        {
            Date = date,
            Entries = entries.Count,
            PhosphorusMg = entries.Sum(x => x.PhosphorusMg),
            Calories = entries.Sum(x => x.Calories ?? 0),
            SodiumMg = entries.Sum(x => x.SodiumMg ?? 0),
            ProteinG = entries.Sum(x => x.ProteinG ?? 0),
            PotassiumMg = entries.Sum(x => x.PotassiumMg ?? 0),
            Binders = entries.Sum(x => x.Binders)
        };

    private RenderFragment RenderFoodTable(IReadOnlyList<FoodPhosphorusIntake> entries, bool includeServing, bool includeActions) => @<div class="data-table-wrap nutrition-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Meal</th>
                    <th>Food Item</th>
                    <th>Phos</th>
                    <th>Calories</th>
                    <th>Sodium</th>
                    <th>Protein</th>
                    <th>Potassium</th>
                    @if (_showKidneyLabs)
                    {
                        <th>Binders</th>
                    }
                    @if (includeServing)
                    {
                        <th>Serving</th>
                    }
                    @if (includeActions)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in entries)
                {
                    <tr class="@(item.FoodPhosphorusIntakeId == _editingId ? "is-selected" : null)" @onclick="() => SelectEntry(item)">
                        <td>@item.ConsumedAt.ToString("M/d/yyyy h:mm tt")</td>
                        <td>@DisplayValue(item.MealType)</td>
                        <td>@item.FoodName</td>
                        <td>@item.PhosphorusMg</td>
                        <td>@item.Calories</td>
                        <td>@item.SodiumMg</td>
                        <td>@(item.ProteinG?.ToString("0.##"))</td>
                        <td>@item.PotassiumMg</td>
                        @if (_showKidneyLabs)
                        {
                            <td>@item.Binders</td>
                        }
                        @if (includeServing)
                        {
                            <td>@DisplayValue(item.ServingDescription)</td>
                        }
                        @if (includeActions)
                        {
                            <td>
                                <button type="button" class="secondary-link compact-action" @onclick="() => RequestDeleteEntry(item)" @onclick:stopPropagation="true" disabled="@LoginSession.IsDemo">Delete</button>
                            </td>
