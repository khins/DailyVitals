    private static string GetSectionQueryValue(NutritionSection section) =>
        section switch
        {
            NutritionSection.AddFood => "add-food",
            NutritionSection.TodaysFoods => "todays-foods",
            NutritionSection.LastSevenDays => "last-7-days",
            NutritionSection.History => "history",
            _ => "todays-totals"
        };

    private static bool TryParseSection(string? value, out NutritionSection section)
    {
        section = NutritionSection.TodaysTotals;

        if (string.IsNullOrWhiteSpace(value))
            return false;

        switch (value.Trim().ToLowerInvariant())
        {
            case "todays-totals":
            case "today":
            case "totals":
                section = NutritionSection.TodaysTotals;
                return true;
            case "add-food":
            case "add":
                section = NutritionSection.AddFood;
                return true;
            case "todays-foods":
            case "foods":
                section = NutritionSection.TodaysFoods;
                return true;
            case "last-7-days":
            case "last-seven-days":
            case "seven-days":
                section = NutritionSection.LastSevenDays;
                return true;
            case "history":
            case "nutrition-history":
                section = NutritionSection.History;
                return true;
            default:
                return false;
        }
    }

    private void SetHistoryRange(int months)
