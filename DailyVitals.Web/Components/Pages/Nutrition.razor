    private void EnsureSelectedHistoryRangeIsAvailable()
    {
        if (!IsHistoryRangeAvailable(_historyRangeMonths))
        {
            _historyRangeMonths = 3;
            _historyPage = 1;
        }
    }

    private bool IsHistoryRangeAvailable(int months)
    {
        return months switch
        {
            3 => true,
            6 => HasEntriesOlderThan(3),
            12 => HasEntriesOlderThan(6),
            _ => false
        };
    }

    private bool HasEntriesOlderThan(int months)
    {
        var cutoff = DateTime.Today.AddMonths(-months);
        return _history.Any(x => x.ConsumedAt.Date < cutoff);
    }

    private int GetHistoryRangeCount(int months)
    {
        var rangeMonths = months is 6 or 12 ? months : 3;
        var cutoff = DateTime.Today.AddMonths(-rangeMonths);
        return _history.Count(x => x.ConsumedAt.Date >= cutoff);
    }

