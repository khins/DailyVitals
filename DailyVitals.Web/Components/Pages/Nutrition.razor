@page "/nutrition"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using DailyVitals.Data.Services
@using DailyVitals.Domain.Models
@using DailyVitals.Web.Services
@inject FoodPhosphorusIntakeService FoodService
@inject FoodPhosphorusEstimateService EstimateService
@inject PersonService PersonService
@inject LocalLoginSession LoginSession
@inject NavigationManager Navigation
@inject ILogger<Nutrition> Logger

<PageTitle>Nutrition | DailyVitals</PageTitle>

@if (LoginSession.IsSignedIn)
{
    <section class="dashboard-shell @(LoginSession.IsDemo ? "demo-mode" : null)">
        <aside class="dashboard-rail" aria-label="Primary navigation">
            <div class="rail-brand">
                <span class="brand-mark brand-mark--compact" aria-hidden="true">MAV</span>
                <span>My Active Vitals</span>
            </div>

            <nav class="rail-nav">
                <a href="dashboard">Dashboard</a>
                <a href="blood-pressure">Blood Pressure</a>
                @if (LoginSession.IsDiabetic)
                {
                    <a href="blood-glucose">Glucose</a>
                }
                <a href="weight">Weight</a>
                <a href="exercise">Exercise</a>
                <a href="reports">Reports</a>
                <button type="button" class="rail-nav-toggle is-active" aria-expanded="@_isNutritionMenuOpen" @onclick="ToggleNutritionMenu">
                    <span>Nutrition</span>
                    <span aria-hidden="true">@(_isNutritionMenuOpen ? "-" : "+")</span>
                </button>
                @if (_isNutritionMenuOpen)
                {
                    <div class="rail-subnav" aria-label="Nutrition sections">
                        <a class="@GetSectionButtonClass(NutritionSection.TodaysTotals)" href="@GetSectionHref(NutritionSection.TodaysTotals)">Today's Totals</a>
                        <a class="@GetSectionButtonClass(NutritionSection.AddFood)" href="@GetSectionHref(NutritionSection.AddFood)">Add Food</a>
                        <a class="@GetSectionButtonClass(NutritionSection.TodaysFoods)" href="@GetSectionHref(NutritionSection.TodaysFoods)">Today's Foods</a>
                        <a class="@GetSectionButtonClass(NutritionSection.LastSevenDays)" href="@GetSectionHref(NutritionSection.LastSevenDays)">Last 7 Days</a>
                        <a class="@GetSectionButtonClass(NutritionSection.History)" href="@GetSectionHref(NutritionSection.History)">Nutrition History</a>
                    </div>
                    @if (_activeSection == NutritionSection.History)
                    {
                        <div class="rail-subpanel" aria-label="Nutrition history range">
                            <button type="button"
                                    class="rail-subpanel-heading"
                                    aria-expanded="@_isHistoryRangeOpen"
                                    @onclick="ToggleHistoryRange">
                                <span>Range</span>
                                <span aria-hidden="true">@(_isHistoryRangeOpen ? "^" : "v")</span>
                            </button>
                            @if (_isHistoryRangeOpen)
                            {
                                <label class="rail-range-option">
                                    <input type="radio" name="nutrition-history-range" checked="@(_historyRangeMonths == 3)" @onchange="() => SetHistoryRange(3)" />
                                    <span>Past 3 Months (@GetHistoryRangeCount(3))</span>
                                </label>
                                <label class="@GetHistoryRangeOptionClass(6)" title="@GetHistoryRangeOptionTitle(6)">
                                    <input type="radio" name="nutrition-history-range" checked="@(_historyRangeMonths == 6)" disabled="@(!IsHistoryRangeAvailable(6))" @onchange="() => SetHistoryRange(6)" />
                                    <span>Past 6 Months (@GetHistoryRangeCount(6))</span>
                                </label>
                                <label class="@GetHistoryRangeOptionClass(12)" title="@GetHistoryRangeOptionTitle(12)">
                                    <input type="radio" name="nutrition-history-range" checked="@(_historyRangeMonths == 12)" disabled="@(!IsHistoryRangeAvailable(12))" @onchange="() => SetHistoryRange(12)" />
                                    <span>Past 12 Months (@GetHistoryRangeCount(12))</span>
                                </label>
                            }
                        </div>
                    }
                }
                <a href="fluid-intake">Fluid Intake</a>
                @if (_showKidneyLabs)
                {
                    <a href="labs">Kidney Labs</a>
                }
            </nav>

            <a class="rail-profile" href="profile" aria-label="Profile">
                <span class="profile-icon" aria-hidden="true"></span>
                <span>Profile</span>
            </a>

            <a class="rail-signout" href="signout">Sign out</a>
        </aside>

        <main class="dashboard-main">
            <DemoModeBanner />
            <header class="dashboard-topbar">
                <div>
                    <p class="eyebrow">My Active Vitals</p>
                    <h1>Nutrition</h1>
                </div>

                <div class="dashboard-actions">
                    <div class="person-switcher">
                        <span>Person</span>
                        <strong>@LoginSession.PersonDisplayName</strong>
                    </div>
                    <button type="button" class="primary-action" @onclick="BeginNewEntry">Add Food</button>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message) && !ShowInlineFormMessage)
            {
                <div class="@_messageClass" role="status">@_message</div>
            }

            <section class="status-band" aria-label="Today nutrition summary">
                <div>
                    <span class="status-dot"></span>
                    <strong>Today: @TodaySummary.PhosphorusMg mg net phosphorus</strong>
                    <p>@TodaySummary.Entries food @(TodaySummary.Entries == 1 ? "entry" : "entries") logged for @DateTime.Today.ToString("M/d/yyyy").</p>
                </div>
                <div>
                    <span>Calories</span>
                    <strong>@TodaySummary.Calories</strong>
                </div>
            </section>

            @if (_activeSection == NutritionSection.TodaysTotals)
            {
                <section class="nutrition-section-grid">
                    <article class="dashboard-card nutrition-overview-panel">
                        <div class="card-heading">
                            <div>
                                <span>Today's Totals</span>
                                <h2>@DateTime.Today.ToString("MMMM d, yyyy")</h2>
                            </div>
                            <strong>@TodaySummary.Entries entries</strong>
                        </div>

                        <div class="nutrition-total-grid">
                            <div>
                                <span>Net Phosphorus</span>
                                <strong>@TodaySummary.PhosphorusMg mg</strong>
                            </div>
                            <div>
                                <span>Calories</span>
                                <strong>@TodaySummary.Calories cal</strong>
                            </div>
                            <div>
                                <span>Sodium</span>
                                <strong>@TodaySummary.SodiumMg mg</strong>
                            </div>
                            <div>
                                <span>Protein</span>
                                <strong>@TodaySummary.ProteinG.ToString("0.#") g</strong>
                            </div>
                            <div>
                                <span>Potassium</span>
                                <strong>@TodaySummary.PotassiumMg mg</strong>
                            </div>
                            @if (_showKidneyLabs)
                            {
                                <div>
                                    <span>Binders</span>
                                    <strong>@TodaySummary.Binders</strong>
                                </div>
                            }
                        </div>

                        <div class="form-command-row nutrition-section-actions">
                            <button type="button" class="primary-action" @onclick="BeginNewEntry">Add Food</button>
                            <button type="button" class="secondary-link" @onclick="() => SetActiveSection(NutritionSection.TodaysFoods)">Review Today's Foods</button>
                        </div>
                    </article>
                </section>
            }
            else if (_activeSection == NutritionSection.AddFood)
            {
                <section class="entry-grid nutrition-entry-grid">
                    <article class="dashboard-card entry-panel">
                    <div class="card-heading">
                        <div>
                            <span>@(_editingId.HasValue ? "Edit Food" : "New Food")</span>
                            <h2>Food Details</h2>
                        </div>
                    </div>

                    <EditForm Model="_form"
                              FormName="nutrition-entry-form"
                              class="bp-form">
                        <DataAnnotationsValidator />

                        <div class="form-row">
                            <label for="consumed-at">Date Eaten</label>
                            <input id="consumed-at" class="form-input" type="datetime-local" value="@_consumedAtText" @onchange="SetConsumedAt" />
                        </div>

                        <div class="field-group">
                            <label for="meal-type">Meal</label>
                            <InputSelect id="meal-type" class="form-input" @bind-Value="_form.MealType">
                                <option value="">Select a meal</option>
                                <option value="Breakfast">Breakfast</option>
                                <option value="Lunch">Lunch</option>
                                <option value="Dinner">Dinner</option>
                                <option value="Snack">Snack</option>
                            </InputSelect>
                            <ValidationMessage For="() => _form.MealType" />
                            <p class="field-hint">Used by meal-based nutrition reports; it is not inferred from entry time.</p>
                        </div>

                        <div class="food-lookup-row">
                            <div class="field-group">
                                <label for="food-name">Food Item</label>
                                <InputText id="food-name" class="form-input" @bind-Value="_form.FoodName" />
                                <ValidationMessage For="() => _form.FoodName" />
                            </div>

                            <button type="button" class="secondary-link estimate-action" @onclick="EstimateFood" disabled="@IsEstimateDisabled">
                                @(_isEstimating ? "Estimating..." : "Estimate")
                            </button>
                        </div>

                        <div class="advanced-toggle-row">
                            <span>AI lookup estimates nutrition and serving details from the food description.</span>
                            <button type="button" class="help-icon-button" aria-label="AI lookup note" @onclick="ShowLookupTip">?</button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_lookupTip))
                        {
                            <div class="inline-toast" role="status">
                                <span>@_lookupTip</span>
                                <button type="button" aria-label="Dismiss AI lookup note" @onclick="DismissLookupTip">Close</button>
                            </div>
                        }

                        <div class="nutrition-number-grid">
                            <div class="field-group">
                                <label for="phosphorus">Phosphorus (mg)</label>
                                <input id="phosphorus"
                                       class="form-input"
                                       type="number"
                                       min="0"
                                       value="@_form.PhosphorusMg"
                                       @onchange="SetPhosphorusMg" />
                                <ValidationMessage For="() => _form.PhosphorusMg" />
                            </div>

                            <div class="field-group">
                                <label for="calories">Calories</label>
                                <InputNumber id="calories" class="form-input" @bind-Value="_form.Calories" />
                            </div>

                            <div class="field-group">
                                <label for="sodium">Sodium (mg)</label>
                                <InputNumber id="sodium" class="form-input" @bind-Value="_form.SodiumMg" />
                            </div>

                            <div class="field-group">
                                <label for="protein">Protein (g)</label>
                                <InputNumber id="protein" class="form-input" @bind-Value="_form.ProteinG" />
                            </div>

                            <div class="field-group">
                                <label for="potassium">Potassium (mg)</label>
                                <InputNumber id="potassium" class="form-input" @bind-Value="_form.PotassiumMg" />
                            </div>

                            @if (_showKidneyLabs)
                            {
                                <div class="field-group">
                                    <label for="binders">Binders Taken</label>
                                    <input id="binders"
                                           class="form-input"
                                           type="number"
                                           min="0"
                                           value="@_form.Binders"
                                           @onchange="SetBindersTaken" />
                                    <ValidationMessage For="() => _form.Binders" />
                                </div>
                            }
                        </div>

                        <div class="field-group">
                            <label for="serving">Serving</label>
                            <InputText id="serving" class="form-input" @bind-Value="_form.ServingDescription" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_estimateGuidance))
                        {
                            <aside class="estimate-guidance" aria-live="polite">
                                <strong>AI estimate guidance</strong>
                                <span>Shown for reference only—not saved with the food entry.</span>
                                <p>@_estimateGuidance</p>
                            </aside>
                        }

                        <div class="field-group">
                            <label for="food-notes">Food Notes</label>
                            <InputTextArea id="food-notes" class="form-input notes-input nutrition-notes-input" @bind-Value="_foodNotes" />
                            <p class="field-hint">Food notes belong to the food profile, so repeat entries do not duplicate the same reference note.</p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(AuditText))
                        {
                            <p class="audit-text">@AuditText</p>
                        }

                        <div class="form-command-row">
                            <button type="button" class="secondary-link" @onclick="BeginNewEntry" disabled="@LoginSession.IsDemo">New</button>
                            <button type="button" class="secondary-link" @onclick="RequestDeleteSelected" disabled="@LoginSession.IsDemo">Delete</button>
                            <button type="button" class="primary-action" @onclick="SaveEntry">Save</button>
                        </div>
                        @if (ShowInlineFormMessage)
                        {
                            <div class="@($"{_messageClass} nutrition-inline-message")" role="status">@_message</div>
                        }
                    </EditForm>
                </article>

                <article class="dashboard-card history-panel">
                    <div class="card-heading">
                        <div>
                            <span>Today's Foods</span>
                            <h2>@DateTime.Today.ToString("MMMM d, yyyy")</h2>
                        </div>
                        <strong>@TodayEntries.Count entries</strong>
                    </div>

                    @if (TodayEntries.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No foods logged today</h2>
                            <p>Saved food entries for today will appear here.</p>
                        </div>
                    }
                    else
                    {
                        @RenderFoodTable(TodayEntries, includeServing: true, includeActions: true)
                    }
                </article>
                </section>
            }
            else if (_activeSection == NutritionSection.TodaysFoods)
            {
                <article class="dashboard-card history-panel">
                    <div class="card-heading">
                        <div>
                            <span>Today's Foods</span>
                            <h2>@DateTime.Today.ToString("MMMM d, yyyy")</h2>
                        </div>
                        <strong>@TodayEntries.Count entries</strong>
                    </div>

                    @if (TodayEntries.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No foods logged today</h2>
                            <p>Add food to start today's nutrition tracking.</p>
                        </div>
                    }
                    else
                    {
                        @RenderFoodTable(TodayEntries, includeServing: true, includeActions: true)
                    }
                </article>
            }
            else if (_activeSection == NutritionSection.LastSevenDays)
            {
                <article class="dashboard-card history-panel">
                    <div class="card-heading">
                        <div>
                            <span>Last 7 Days</span>
                            <h2>Daily Nutrition Summary</h2>
                        </div>
                        <strong>@LastSevenDaySummaries.Sum(x => x.Entries) entries</strong>
                    </div>

                    <div class="data-table-wrap nutrition-table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Entries</th>
                                    <th>Net Phos</th>
                                    <th>Calories</th>
                                    <th>Sodium</th>
                                    <th>Protein</th>
                                    <th>Potassium</th>
                                    @if (_showKidneyLabs)
                                    {
                                        <th>Binders</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var day in LastSevenDaySummaries)
                                {
                                    <tr>
                                        <td>@day.Date.ToString("M/d/yyyy")</td>
                                        <td>@day.Entries</td>
                                        <td>@day.PhosphorusMg</td>
                                        <td>@day.Calories</td>
                                        <td>@day.SodiumMg</td>
                                        <td>@day.ProteinG.ToString("0.#")</td>
                                        <td>@day.PotassiumMg</td>
                                        @if (_showKidneyLabs)
                                        {
                                            <td>@day.Binders</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            }
            else
            {
                <article class="dashboard-card history-panel">
                    <div class="card-heading">
                        <div>
                            <span>Nutrition History</span>
                            <h2>Food Entries</h2>
                        </div>
                        <div class="history-heading-actions">
                            <strong>@FilteredHistory.Count entries</strong>
                            @if (FilteredHistory.Count > 0)
                            {
                                <button type="button" class="secondary-link compact-action" @onclick="OpenHistoryModal">Pop out</button>
                            }
                        </div>
                    </div>

                    <div class="field-group table-search">
                        <label for="nutrition-search">Search</label>
                        <input id="nutrition-search" class="form-input" value="@_searchText" @oninput="SetSearchText" />
                    </div>

                    @if (FilteredHistory.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No food entries</h2>
                            <p>Save a food entry to start this person's nutrition history.</p>
                        </div>
                    }
                    else
                    {
                        @RenderFoodTable(PagedHistory, includeServing: false, includeActions: true)
                        @RenderHistoryPager()
                    }
                </article>
            }

            @if (_showHistoryModal)
            {
                <div class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="nutrition-history-title">
                    <article class="info-modal nutrition-history-modal">
                        <div class="info-modal-header">
                            <div>
                                <span>History</span>
                                <h2 id="nutrition-history-title">Food Entries</h2>
                            </div>
                            <button type="button" class="modal-close-button" aria-label="Close food entries" @onclick="CloseHistoryModal">x</button>
                        </div>

                        <div class="nutrition-history-modal-toolbar">
                            <div class="field-group">
                                <label for="nutrition-modal-search">Search</label>
                                <input id="nutrition-modal-search" class="form-input" value="@_searchText" @oninput="SetSearchText" />
                            </div>
                            <strong>@FilteredHistory.Count entries</strong>
                        </div>

                        <div class="data-table-wrap nutrition-history-modal-table">
                            <table class="data-table nutrition-history-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Meal</th>
                                        <th>Food Item</th>
                                        <th>Phos</th>
                                        <th>Calories</th>
                                        <th>Sodium</th>
                                        <th>Protein</th>
                                        <th>Potassium</th>
                                        @if (_showKidneyLabs)
                                        {
                                            <th>Binders</th>
                                        }
                                        <th>Serving</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in PagedHistory)
                                    {
                                        <tr class="@(item.FoodPhosphorusIntakeId == _editingId ? "is-selected" : null)" @onclick="() => SelectEntryFromHistoryModal(item)">
                                            <td>@item.ConsumedAt.ToString("M/d/yyyy")</td>
                                            <td>@DisplayValue(item.MealType)</td>
                                            <td>@item.FoodName</td>
                                            <td>@item.PhosphorusMg</td>
                                            <td>@item.Calories</td>
                                            <td>@item.SodiumMg</td>
                                            <td>@(item.ProteinG?.ToString("0.##"))</td>
                                            <td>@item.PotassiumMg</td>
                                            @if (_showKidneyLabs)
                                            {
                                                <td>@item.Binders</td>
                                            }
                                            <td>@DisplayValue(item.ServingDescription)</td>
                                            <td>
                                                <button type="button" class="secondary-link compact-action" @onclick="() => RequestDeleteEntry(item)" @onclick:stopPropagation="true" disabled="@LoginSession.IsDemo">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @RenderHistoryPager()
                    </article>
                </div>
            }

            @if (_pendingDeleteEntry is not null)
            {
                <div class="modal-backdrop" role="presentation" @onclick="CancelDelete">
                    <section class="info-modal confirm-modal" role="dialog" aria-modal="true" aria-labelledby="nutrition-delete-title" @onclick:stopPropagation="true">
                        <div class="info-modal-header">
                            <div>
                                <span>Confirm Delete</span>
                                <h2 id="nutrition-delete-title">Delete this food entry?</h2>
                            </div>
                            <button type="button" class="modal-close-button" aria-label="Cancel delete" @onclick="CancelDelete">×</button>
                        </div>

                        <p class="info-modal-note">This will permanently remove the selected food from your nutrition history.</p>
                        <p class="confirm-modal-detail">@DeleteEntrySummary</p>

                        <div class="confirm-modal-actions">
                            <button type="button" class="secondary-link" @onclick="CancelDelete">Cancel</button>
                            <button type="button" class="danger-action" @onclick="ConfirmDelete">Delete Food</button>
                        </div>
                    </section>
                </div>
            }
        </main>
    </section>
}

@code {
    private readonly NutritionForm _form = new();
    private readonly List<FoodPhosphorusIntake> _history = [];
    private long? _editingId;
    private DateTime? _editingConsumedAt;
    private DateTime? _createdAt;
    private DateTime? _updatedAt;
    private string _consumedAtText = string.Empty;
    private string _foodNotes = string.Empty;
    private string? _estimateGuidance;
    private string _searchText = string.Empty;
    private string? _message;
    private string _messageClass = "page-message";
    private string? _lookupTip;
    private int _selectedDayTotal;
    private bool _isEstimating;
    private bool _showKidneyLabs = true;
    private bool _draftApplied;
    private bool _showHistoryModal;
    private FoodPhosphorusIntake? _pendingDeleteEntry;
    private int? _phosphorusBeforeBinderAdjustment;
    private bool _isNutritionMenuOpen = true;
    private bool _isHistoryRangeOpen = true;
    private NutritionSection _activeSection = NutritionSection.TodaysTotals;
    private int _historyPage = 1;
    private int _historyRangeMonths = 3;
    private const int HistoryPageSize = 20;

    [SupplyParameterFromQuery(Name = "draftFood")]
    public string? DraftFoodName { get; set; }

    [SupplyParameterFromQuery(Name = "draftServing")]
    public string? DraftServingDescription { get; set; }

    [SupplyParameterFromQuery(Name = "draftCalories")]
    public int? DraftCalories { get; set; }

    [SupplyParameterFromQuery(Name = "draftSodium")]
    public int? DraftSodiumMg { get; set; }

    [SupplyParameterFromQuery(Name = "draftPotassium")]
    public int? DraftPotassiumMg { get; set; }

    [SupplyParameterFromQuery(Name = "draftPhosphorus")]
    public int? DraftPhosphorusMg { get; set; }

    [SupplyParameterFromQuery(Name = "draftProtein")]
    public decimal? DraftProteinG { get; set; }

    [SupplyParameterFromQuery(Name = "draftNotes")]
    public string? DraftFoodNotes { get; set; }

    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    protected override void OnInitialized()
    {
        ResetForm();
    }

    protected override void OnParametersSet()
    {
        ApplySectionFromQuery();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoginSession.RestoreAsync();

        if (!LoginSession.IsSignedIn)
        {
            Navigation.NavigateTo("/signin");
            return;
        }

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            StateHasChanged();
            return;
        }

        ResetForm();
        LoadPersonPreferences();
        LoadHistory();
        ApplyDraftFoodFromQuery();
        RefreshSelectedDayTotal();
        StateHasChanged();
    }

    private void ApplySectionFromQuery()
    {
        if (!TryParseSection(Section, out var requestedSection))
            return;

        _isNutritionMenuOpen = true;
        _activeSection = requestedSection;
        if (requestedSection == NutritionSection.History)
            _historyPage = 1;
    }

    private void ApplyDraftFoodFromQuery()
    {
        if (_draftApplied || string.IsNullOrWhiteSpace(DraftFoodName))
            return;

        _draftApplied = true;
        ResetForm();
        _form.FoodName = DraftFoodName.Trim();
        _form.ServingDescription = DraftServingDescription ?? string.Empty;
        _form.Calories = DraftCalories;
        _form.SodiumMg = DraftSodiumMg;
        _form.PotassiumMg = DraftPotassiumMg;
        _form.PhosphorusMg = DraftPhosphorusMg;
        _form.ProteinG = DraftProteinG;
        _foodNotes = DraftFoodNotes ?? string.Empty;
        _form.SourceNotes = "Selected from the renal friendly foods catalog.";
        _activeSection = NutritionSection.AddFood;
        ShowSuccess("Renal friendly food loaded as a new nutrition entry. Review the values before saving.");
    }

    private void LoadPersonPreferences()
    {
        if (!LoginSession.PersonId.HasValue)
            return;

        _showKidneyLabs = PersonService.GetPersonById(LoginSession.PersonId.Value)?.TrackKidneyLabs ?? true;
    }

    private List<FoodPhosphorusIntake> FilteredHistory
    {
        get
        {
            var historyStart = DateTime.Today.AddMonths(-_historyRangeMonths);
            var rangeHistory = _history.Where(x => x.ConsumedAt.Date >= historyStart).ToList();

            if (string.IsNullOrWhiteSpace(_searchText))
                return rangeHistory;

            return rangeHistory
                .Where(x => x.FoodName.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private List<FoodPhosphorusIntake> PagedHistory =>
        FilteredHistory
            .Skip((_historyPage - 1) * HistoryPageSize)
            .Take(HistoryPageSize)
            .ToList();

    private int HistoryPageCount =>
