@page "/blood-pressure"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using DailyVitals.Data.Services
@using DailyVitals.Domain.Models
@using DailyVitals.Web.Services
@inject BloodPressureService BloodPressureService
@inject VitalThresholdService VitalThresholdService
@inject PersonService PersonService
@inject LocalLoginSession LoginSession
@inject NavigationManager Navigation
@inject ILogger<BloodPressure> Logger

<PageTitle>Blood Pressure | DailyVitals</PageTitle>

@if (LoginSession.IsSignedIn)
{
    <section class="dashboard-shell @(LoginSession.IsDemo ? "demo-mode" : null)">
        <aside class="dashboard-rail" aria-label="Primary navigation">
            <div class="rail-brand">
                <span class="brand-mark brand-mark--compact" aria-hidden="true">DV</span>
                <span>DailyVitals</span>
            </div>

            <nav class="rail-nav">
                <a href="dashboard">Dashboard</a>
                <button type="button" class="rail-nav-toggle is-active" aria-expanded="@_isBloodPressureMenuOpen" @onclick="ToggleBloodPressureMenu">
                    <span>Blood Pressure</span>
                    <span aria-hidden="true">@(_isBloodPressureMenuOpen ? "-" : "+")</span>
                </button>
                @if (_isBloodPressureMenuOpen)
                {
                    <div class="rail-subnav" aria-label="Blood pressure sections">
                        <a class="rail-subnav-button is-active" href="blood-pressure">Entry</a>
                        <a class="rail-subnav-button" href="blood-pressure-trend">Trend</a>
                    </div>
                }
                <a href="blood-glucose">Glucose</a>
                <a href="weight">Weight</a>
                <a href="exercise">Exercise</a>
                <a href="reports">Reports</a>
                <a href="nutrition">Nutrition</a>
                <a href="fluid-intake">Fluid Intake</a>
                @if (_showKidneyLabs)
                {
                    <a href="renal-foods">Renal Friendly Foods</a>
                    <a href="labs">Kidney Labs</a>
                }
            </nav>

            <a class="rail-profile" href="profile" aria-label="Profile">
                <span class="profile-icon" aria-hidden="true"></span>
                <span>Profile</span>
            </a>

            <a class="rail-signout" href="signout">Sign out</a>
        </aside>

        <main class="dashboard-main">
            <DemoModeBanner />
            <header class="dashboard-topbar">
                <div>
                    <p class="eyebrow">DailyVitals Web</p>
                    <h1>Blood Pressure</h1>
                </div>

                <div class="dashboard-actions">
                    <div class="person-switcher">
                        <span>Person</span>
                        <strong>@LoginSession.UserName</strong>
                    </div>
                    <button type="button" class="primary-action" @onclick="BeginNewReading">New Reading</button>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="@_messageClass" role="status">@_message</div>
            }

            <section class="@SeverityBandClass" aria-label="Current blood pressure status">
                <div>
                    <span class="status-dot"></span>
                    <strong>@SeverityText</strong>
                    <p>@SeveritySummary</p>
                </div>
                <div>
                    <span>Latest reading</span>
                    <strong>@LatestReadingText</strong>
                </div>
            </section>

            <section class="entry-grid">
                <article class="dashboard-card entry-panel">
                    <div class="card-heading">
                        <div>
                            <span>@(_editingId.HasValue ? "Edit Reading" : "New Reading")</span>
                            <h2>Details</h2>
                        </div>
                    </div>

                    <EditForm Model="_form" FormName="blood-pressure-entry-form" OnValidSubmit="SaveReading" class="bp-form">
                        <DataAnnotationsValidator />

                        <div class="form-row">
                            <label for="reading-time">Reading Time</label>
                            <input id="reading-time" class="form-input" type="datetime-local" value="@_readingTimeText" @onchange="SetReadingTime" />
                        </div>

                        <div class="bp-number-grid">
                            <div class="field-group">
                                <label for="systolic">Systolic</label>
                                <InputNumber id="systolic" class="form-input" @bind-Value="_form.Systolic" />
                                <ValidationMessage For="() => _form.Systolic" />
                            </div>

                            <div class="field-group">
                                <label for="diastolic">Diastolic</label>
                                <InputNumber id="diastolic" class="form-input" @bind-Value="_form.Diastolic" />
                                <ValidationMessage For="() => _form.Diastolic" />
                            </div>

                            <div class="field-group">
                                <label for="pulse">Pulse</label>
                                <InputNumber id="pulse" class="form-input" @bind-Value="_form.Pulse" />
                                <ValidationMessage For="() => _form.Pulse" />
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="notes">Notes</label>
                            <InputTextArea id="notes" class="form-input notes-input" @bind-Value="_form.Notes" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(AuditText))
                        {
                            <p class="audit-text">@AuditText</p>
                        }

                        <div class="form-command-row">
                            <button type="button" class="secondary-link" @onclick="BeginNewReading" disabled="@LoginSession.IsDemo">New</button>
                            <button type="button" class="secondary-link" @onclick="RequestDeleteSelected" disabled="@(LoginSession.IsDemo || !_editingId.HasValue)">Delete</button>
                            <button type="submit" class="primary-action">Save</button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_formToast))
                        {
                            <div class="profile-toast form-toast" role="status">
                                <span class="profile-toast-icon" aria-hidden="true">✓</span>
                                <span>@_formToast</span>
                                <button type="button" aria-label="Dismiss blood pressure update message" @onclick="DismissFormToast">×</button>
                            </div>
                        }
                    </EditForm>
                </article>

                <article class="dashboard-card history-panel">
                    <div class="card-heading">
                        <div>
                            <span>History</span>
                            <h2>Recent Readings</h2>
                        </div>
                        <strong>@_history.Count entries</strong>
                    </div>

                    @if (_history.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No readings yet</h2>
                            <p>Save a blood pressure reading to start this person's history.</p>
                        </div>
                    }
                    else
                    {
                        <div class="data-table-wrap blood-pressure-history-table">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Sys</th>
                                        <th>Dia</th>
                                        <th>Pulse</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var reading in PagedHistory)
                                    {
                                        <tr class="@(reading.BloodPressureId == _editingId ? "is-selected" : null)" @onclick="() => SelectReading(reading)">
                                            <td>@reading.ReadingTime.ToString("M/d/yyyy h:mm tt")</td>
                                            <td>@reading.Systolic</td>
                                            <td>@reading.Diastolic</td>
                                            <td>@reading.Pulse</td>
                                            <td>@reading.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @RenderHistoryPager()
                    }
                </article>
            </section>

            @if (_showDeleteConfirm)
            {
                <div class="modal-backdrop" role="presentation" @onclick="CancelDelete">
                    <section class="info-modal confirm-modal" role="dialog" aria-modal="true" aria-labelledby="bp-delete-title" @onclick:stopPropagation="true">
                        <div class="info-modal-header">
                            <div>
                                <span>Confirm Delete</span>
                                <h2 id="bp-delete-title">Delete this blood pressure reading?</h2>
                            </div>
                            <button type="button" class="modal-close-button" aria-label="Cancel delete" @onclick="CancelDelete">×</button>
                        </div>

                        <p class="info-modal-note">This will permanently remove the selected reading from your blood pressure history.</p>
                        <p class="confirm-modal-detail">@DeleteReadingSummary</p>

                        <div class="confirm-modal-actions">
                            <button type="button" class="secondary-link" @onclick="CancelDelete">Cancel</button>
                            <button type="button" class="danger-action" @onclick="ConfirmDelete">Delete Reading</button>
                        </div>
                    </section>
                </div>
            }
        </main>
    </section>
}

@code {
    private readonly BloodPressureForm _form = new();
    private readonly List<BloodPressureReading> _history = [];
    private const int HistoryPageSize = 20;
    private long? _editingId;
    private int _historyPage = 1;
    private DateTime? _createdAt;
    private DateTime? _updatedAt;
    private int _systolicAlertMax = 130;
    private int _diastolicAlertMax = 80;
    private bool _showKidneyLabs = true;
    private bool _isBloodPressureMenuOpen = true;
    private string _readingTimeText = ToDateTimeLocal(DateTime.Now);
    private string? _message;
    private string _messageClass = "page-message";
    private string? _formToast;
    private bool _showDeleteConfirm;

    protected override void OnInitialized()
    {
        ResetForm();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoginSession.RestoreAsync();

        if (!LoginSession.IsSignedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!LoginSession.PersonId.HasValue)
        {
            _messageClass = "page-message page-message--error";
            _message = "This login is not linked to a person record yet.";
            StateHasChanged();
            return;
        }

        LoadPersonPreferences();
        LoadHistory();
        StateHasChanged();
    }

    private void LoadPersonPreferences()
    {
        if (!LoginSession.PersonId.HasValue)
            return;

        _showKidneyLabs = PersonService.GetPersonById(LoginSession.PersonId.Value)?.TrackKidneyLabs ?? true;
    }

    private string SeverityText
    {
        get
        {
            if (!_form.Systolic.HasValue || !_form.Diastolic.HasValue)
                return "Ready";

            if (_form.Systolic > _systolicAlertMax || _form.Diastolic > _diastolicAlertMax)
                return "High";

            return "In range";
        }
    }

    private string SeverityBandClass =>
        SeverityText switch
        {
            "In range" => "status-band status-band--ok",
            "High" => "status-band status-band--high",
            _ => "status-band"
        };

    private string SeveritySummary =>
        SeverityText switch
        {
            "In range" => $"This reading is within the profile alert targets of {_systolicAlertMax}/{_diastolicAlertMax}.",
            "High" => $"This reading is above the profile alert targets of {_systolicAlertMax}/{_diastolicAlertMax}.",
            _ => "Enter systolic and diastolic values to classify the reading."
        };

    private string LatestReadingText =>
        _history.Count == 0
            ? "None yet"
            : $"{_history[0].Systolic}/{_history[0].Diastolic} on {_history[0].ReadingTime:M/d/yyyy}";

    private string DeleteReadingSummary =>
        _editingId.HasValue
            ? $"{_form.Systolic}/{_form.Diastolic}, pulse {_form.Pulse}, {_readingTimeText}"
            : "No reading selected.";

    private List<BloodPressureReading> PagedHistory =>
        _history
            .Skip((_historyPage - 1) * HistoryPageSize)
            .Take(HistoryPageSize)
            .ToList();

    private int HistoryPageCount =>
        Math.Max(1, (int)Math.Ceiling(_history.Count / (double)HistoryPageSize));

    private string AuditText
    {
        get
        {
            if (_updatedAt.HasValue)
                return $"Updated at: {_updatedAt.Value:g}";

            if (_createdAt.HasValue)
                return $"Created at: {_createdAt.Value:g}";

            return string.Empty;
        }
    }

    private void LoadHistory()
    {
        _history.Clear();

        if (!LoginSession.PersonId.HasValue)
            return;

        LoadThresholds(LoginSession.PersonId.Value);
        _history.AddRange(BloodPressureService.GetHistoryForPerson(LoginSession.PersonId.Value));
        EnsureHistoryPageInRange();
    }

    private void LoadThresholds(long personId)
    {
        var systolic = VitalThresholdService.GetActiveThreshold(personId, VitalThresholdService.BloodPressureSystolic);
        var diastolic = VitalThresholdService.GetActiveThreshold(personId, VitalThresholdService.BloodPressureDiastolic);

        _systolicAlertMax = systolic?.MaxValue.HasValue == true
            ? Convert.ToInt32(systolic.MaxValue.Value)
            : 130;

        _diastolicAlertMax = diastolic?.MaxValue.HasValue == true
            ? Convert.ToInt32(diastolic.MaxValue.Value)
            : 80;
    }

    private void SelectReading(BloodPressureReading reading, bool clearToast = true)
    {
        _editingId = reading.BloodPressureId;
        _form.Systolic = reading.Systolic;
        _form.Diastolic = reading.Diastolic;
        _form.Pulse = reading.Pulse;
        _form.Notes = reading.Notes ?? string.Empty;
        _readingTimeText = ToDateTimeLocal(reading.ReadingTime);
        _createdAt = reading.CreatedAt;
        _updatedAt = reading.UpdatedAt;
        _message = null;
        _showDeleteConfirm = false;
        if (clearToast)
            _formToast = null;
    }

    private void BeginNewReading()
    {
        ResetForm();
        _message = null;
        _formToast = null;
        _showDeleteConfirm = false;
    }

    private void SetReadingTime(ChangeEventArgs args)
    {
        _readingTimeText = args.Value?.ToString() ?? string.Empty;
        if (DateTime.TryParse(_readingTimeText, out var readingTime))
            SyncSeatedAtNote(readingTime);
    }

    private void ResetForm()
    {
        var now = DateTime.Now;
        _editingId = null;
        _form.Systolic = null;
        _form.Diastolic = null;
        _form.Pulse = null;
        _form.Notes = $"Morning reading, seated at {now:h:mm tt}";
        _readingTimeText = ToDateTimeLocal(now);
        _createdAt = null;
        _updatedAt = null;
    }

    private void SaveReading()
    {
        if (LoginSession.IsDemo)
        {
            ShowError(DemoModeGuard.ReadOnlyMessage);
            return;
        }

        _showDeleteConfirm = false;

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            return;
        }

        if (!TryGetReadingTime(out var readingTime))
            return;

        if (!_form.Systolic.HasValue || !_form.Diastolic.HasValue || !_form.Pulse.HasValue)
        {
            ShowError("Enter systolic, diastolic, and pulse values.");
            return;
        }

        if (_form.Systolic.Value <= _form.Diastolic.Value)
        {
            ShowError("Systolic must be greater than diastolic.");
            return;
        }

        var personId = LoginSession.PersonId.Value;
        var notes = _form.Notes ?? string.Empty;

        try
        {
            if (_editingId.HasValue)
            {
                var updated = BloodPressureService.UpdateBloodPressureForPerson(
                    personId,
                    _editingId.Value,
                    _form.Systolic.Value,
                    _form.Diastolic.Value,
                    _form.Pulse.Value,
                    readingTime,
                    notes,
                    LoginSession.UserName ?? string.Empty);

                if (!updated)
                {
                    ShowError("The selected blood pressure record could not be updated.");
                    return;
                }

                ShowSuccess("Blood pressure reading updated.");
            }
            else
            {
                var insertedId = BloodPressureService.InsertBloodPressure(
                    personId,
                    _form.Systolic.Value,
                    _form.Diastolic.Value,
                    _form.Pulse.Value,
                    readingTime,
                    notes,
                    LoginSession.UserName ?? string.Empty);

                _editingId = insertedId;
                _historyPage = 1;
                ShowSuccess("Blood pressure reading saved.");
            }

            LoadHistory();

            var selected = _history.FirstOrDefault(x => x.BloodPressureId == _editingId);
            if (selected is not null)
                SelectReading(selected, clearToast: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Blood pressure save failed.");
            ShowError("Blood pressure entry could not be saved. Please try again.");
        }
    }

    private void RequestDeleteSelected()
    {
        if (!_editingId.HasValue)
            return;

        _message = null;
        _formToast = null;
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
    }

    private void ConfirmDelete()
    {
        _showDeleteConfirm = false;
        DeleteSelected();
    }

    private void DeleteSelected()
    {
        if (LoginSession.IsDemo)
        {
            ShowError(DemoModeGuard.ReadOnlyMessage);
            return;
        }

        if (!_editingId.HasValue || !LoginSession.PersonId.HasValue)
            return;

        try
        {
            var deleted = BloodPressureService.DeleteBloodPressureForPerson(
                LoginSession.PersonId.Value,
                _editingId.Value);

            if (!deleted)
            {
                ShowError("The selected blood pressure record could not be deleted.");
                return;
            }

            LoadHistory();
            ResetForm();
            ShowSuccess("Blood pressure reading deleted.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Blood pressure delete failed.");
            ShowError("Blood pressure entry could not be deleted. Please try again.");
        }
    }

    private bool TryGetReadingTime(out DateTime readingTime)
    {
        if (DateTime.TryParse(_readingTimeText, out readingTime))
            return true;

        ShowError("Enter a valid reading time.");
        return false;
    }

    private void ShowSuccess(string message)
    {
        _messageClass = "page-message";
        _message = null;
        _formToast = message;
    }

    private void ShowError(string message)
    {
        _messageClass = "page-message page-message--error";
        _message = message;
        _formToast = null;
    }

    private void DismissFormToast()
    {
        _formToast = null;
    }

    private void ToggleBloodPressureMenu()
    {
        _isBloodPressureMenuOpen = !_isBloodPressureMenuOpen;
    }

    private void PreviousHistoryPage()
    {
        if (_historyPage > 1)
            _historyPage--;
    }

    private void NextHistoryPage()
    {
        if (_historyPage < HistoryPageCount)
            _historyPage++;
    }

    private void EnsureHistoryPageInRange()
    {
        if (_historyPage > HistoryPageCount)
            _historyPage = HistoryPageCount;

        if (_historyPage < 1)
            _historyPage = 1;
    }

    private async Task SignOut()
    {
        await LoginSession.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private RenderFragment RenderHistoryPager() => @<div class="table-pager">
        <button type="button" class="secondary-link compact-action" @onclick="PreviousHistoryPage" disabled="@(_historyPage <= 1)">Previous</button>
        <span>Page @_historyPage of @HistoryPageCount</span>
        <button type="button" class="secondary-link compact-action" @onclick="NextHistoryPage" disabled="@(_historyPage >= HistoryPageCount)">Next</button>
    </div>;

    private static string ToDateTimeLocal(DateTime value) => value.ToString("yyyy-MM-ddTHH:mm");

    private void SyncSeatedAtNote(DateTime readingTime)
    {
        var seatedText = $"seated at {readingTime:h:mm tt}";
        var currentNotes = _form.Notes ?? string.Empty;

        if (string.IsNullOrWhiteSpace(currentNotes))
        {
            _form.Notes = $"Morning reading, {seatedText}";
            return;
        }

        if (currentNotes.Contains("seated at", StringComparison.OrdinalIgnoreCase))
        {
            _form.Notes = Regex.Replace(
                currentNotes,
                @"seated at\s+\d{1,2}:\d{2}\s*(AM|PM)",
                seatedText,
                RegexOptions.IgnoreCase);
        }
    }

    private sealed class BloodPressureForm
    {
        [Required]
        [Range(1, 300)]
        public int? Systolic { get; set; }

        [Required]
        [Range(1, 200)]
        public int? Diastolic { get; set; }

        [Required]
        [Range(1, 250)]
        public int? Pulse { get; set; }

        public string? Notes { get; set; }
    }
}


