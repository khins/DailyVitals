@page "/profile"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using DailyVitals.Data.Services
@using DailyVitals.Domain.Models
@using DailyVitals.Web.Services
@inject PersonService PersonService
@inject LoginUserService LoginUserService
@inject NutritionGoalService NutritionGoalService
@inject VitalThresholdService VitalThresholdService
@inject LocalLoginSession LoginSession
@inject NavigationManager Navigation
@inject ILogger<Profile> Logger

<PageTitle>Profile | DailyVitals</PageTitle>

@if (LoginSession.IsSignedIn)
{
    <section class="dashboard-shell @(LoginSession.IsDemo ? "demo-mode" : null)">
        <aside class="dashboard-rail" aria-label="Primary navigation">
            <div class="rail-brand">
                <span class="brand-mark brand-mark--compact" aria-hidden="true">DV</span>
                <span>DailyVitals</span>
            </div>

            <nav class="rail-nav">
                <a href="dashboard">Dashboard</a>
                <a href="blood-pressure">Blood Pressure</a>
                <a href="blood-glucose">Glucose</a>
                <a href="weight">Weight</a>
                <a href="exercise">Exercise</a>
                <a href="reports">Reports</a>
                <a href="nutrition">Nutrition</a>
                <a href="fluid-intake">Fluid Intake</a>
                @if (Model.TrackKidneyLabs)
                {
                    <a href="renal-foods">Renal Friendly Foods</a>
                    <a href="labs">Kidney Labs</a>
                }
            </nav>

            <a class="rail-profile is-active" href="profile" aria-label="Profile">
                <span class="profile-icon" aria-hidden="true"></span>
                <span>Profile</span>
            </a>

            <a class="rail-signout" href="signout">Sign out</a>
        </aside>

        <main class="dashboard-main">
            <DemoModeBanner />
            <header class="dashboard-topbar">
                <div>
                    <p class="eyebrow">DailyVitals Web</p>
                    <h1>Profile</h1>
                </div>

                <div class="dashboard-actions">
                    <div class="person-switcher">
                        <span>Signed in</span>
                        <strong>@LoginSession.UserName</strong>
                    </div>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message) && _messageClass.Contains("error", StringComparison.OrdinalIgnoreCase))
            {
                <div class="@_messageClass" role="status">@_message</div>
            }

            <section class="profile-grid">
                <article class="dashboard-card profile-summary-card">
                    <div class="profile-avatar" aria-hidden="true">@Initials</div>
                    <h2>@DisplayName</h2>
                    <p>@ProfileDetails</p>
                    @if (!string.IsNullOrWhiteSpace(AuditText))
                    {
                        <span class="audit-text">@AuditText</span>
                    }
                </article>

                <article class="dashboard-card entry-panel">
                    <div class="card-heading">
                        <div>
                            <span>Manage Person</span>
                            <h2>Profile Details</h2>
                        </div>
                    </div>

                    <EditForm Model="Model" FormName="profile-form" OnValidSubmit="SaveProfile" class="bp-form">
                        <DataAnnotationsValidator />

                        <div class="account-form-grid">
                            <div class="field-group">
                                <label for="profile-first-name">First Name</label>
                                <InputText id="profile-first-name" class="form-input" @bind-Value="Model.FirstName" />
                                <ValidationMessage For="() => Model.FirstName" />
                            </div>

                            <div class="field-group">
                                <label for="profile-last-name">Last Name</label>
                                <InputText id="profile-last-name" class="form-input" @bind-Value="Model.LastName" />
                                <ValidationMessage For="() => Model.LastName" />
                            </div>

                            <div class="field-group form-grid-span-all">
                                <label for="profile-user-name">Email</label>
                                <InputText id="profile-user-name" type="email" class="form-input" autocomplete="email" @bind-Value="Model.UserName" />
                                <ValidationMessage For="() => Model.UserName" />
                            </div>

                            <div class="field-group">
                                <label for="profile-birth-date">Birth Date</label>
                                <InputText id="profile-birth-date" type="date" class="form-input" @bind-Value="Model.BirthDateText" />
                            </div>

                            <div class="field-group">
                                <label>Height</label>
                                <div class="height-picker">
                                    <InputSelect class="form-input" @bind-Value="Model.HeightFeet">
                                        @for (var feet = 3; feet <= 8; feet++)
                                        {
                                            <option value="@feet">@feet ft</option>
                                        }
                                    </InputSelect>
                                    <InputSelect class="form-input" @bind-Value="Model.HeightInches">
                                        @for (var inches = 0; inches <= 11; inches++)
                                        {
                                            <option value="@inches">@inches in</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>

                        <fieldset class="gender-options profile-gender-options">
                            <legend>Gender</legend>
                            <InputRadioGroup @bind-Value="Model.Gender">
                                <div class="profile-radio-options">
                                    <label>
                                        <InputRadio Value="@("Male")" />
                                        <span>Male</span>
                                    </label>
                                    <label>
                                        <InputRadio Value="@("Female")" />
                                        <span>Female</span>
                                    </label>
                                </div>
                            </InputRadioGroup>
                        </fieldset>

                        <section class="profile-preferences-panel" aria-label="Profile preferences">
                            <div class="card-heading">
                                <div>
                                    <span>Additional Attributes</span>
                                    <h2>Tracking Preferences</h2>
                                </div>
                            </div>

                            <div class="profile-toggle-grid">
                                <label class="toggle-card">
                                    <InputCheckbox @bind-Value="Model.IsDiabetic" />
                                    <span>
                                        <strong>Diabetic</strong>
                                        <small>Enable glucose-focused dashboard alerts.</small>
                                    </span>
                                </label>

                                <label class="toggle-card">
                                    <InputCheckbox @bind-Value="Model.TrackKidneyLabs" />
                                    <span>
                                        <strong>Kidney program</strong>
                                        <small>Show kidney lab tracking and monthly lab alerts.</small>
                                    </span>
                                </label>

                                <label class="toggle-card">
                                    <InputCheckbox @bind-Value="Model.TrackWeightLoss" />
                                    <span>
                                        <strong>Weight-loss focus</strong>
                                        <small>Keep weight trend tracking prominent for this person.</small>
                                    </span>
                                </label>
                            </div>

                            <div class="nutrition-goal-fields">
                                <div class="field-group">
                                    <label for="goal-effective-date">Goal Effective Date</label>
                                    <InputText id="goal-effective-date" type="date" class="form-input" @bind-Value="Model.GoalEffectiveDateText" />
                                </div>

                                <div class="field-group">
                                    <label for="phosphorus-limit">Phosphorus Limit (mg)</label>
                                    <InputNumber id="phosphorus-limit" class="form-input" @bind-Value="Model.PhosphorusLimitMg" />
                                    <ValidationMessage For="() => Model.PhosphorusLimitMg" />
                                </div>

                                <div class="field-group">
                                    <label for="sodium-limit">Sodium Limit (mg)</label>
                                    <InputNumber id="sodium-limit" class="form-input" @bind-Value="Model.SodiumLimitMg" />
                                    <ValidationMessage For="() => Model.SodiumLimitMg" />
                                </div>

                                <div class="field-group">
                                    <label for="calorie-limit">Calorie Limit</label>
                                    <InputNumber id="calorie-limit" class="form-input" @bind-Value="Model.CalorieLimit" />
                                    <ValidationMessage For="() => Model.CalorieLimit" />
                                </div>

                                <div class="field-group">
                                    <label for="protein-target">Protein Target (g)</label>
                                    <InputNumber id="protein-target" class="form-input" @bind-Value="Model.ProteinTargetG" />
                                </div>

                                <div class="field-group">
                                    <label for="potassium-limit">Potassium Limit (mg)</label>
                                    <InputNumber id="potassium-limit" class="form-input" @bind-Value="Model.PotassiumLimitMg" />
                                </div>

                                <div class="field-group">
                                    <label for="fluid-limit">Fluid Limit (ml)</label>
                                    <InputNumber id="fluid-limit" class="form-input" @bind-Value="Model.FluidLimitMl" />
                                </div>

                                <div class="field-group">
                                    <label for="glucose-target">Glucose Target (mg/dL)</label>
                                    <InputNumber id="glucose-target" class="form-input" @bind-Value="Model.GlucoseTargetMgDl" />
                                </div>

                                <div class="field-group">
                                    <label for="systolic-threshold">Systolic Alert Max</label>
                                    <InputNumber id="systolic-threshold" class="form-input" @bind-Value="Model.SystolicThresholdMax" />
                                </div>

                                <div class="field-group">
                                    <label for="diastolic-threshold">Diastolic Alert Max</label>
                                    <InputNumber id="diastolic-threshold" class="form-input" @bind-Value="Model.DiastolicThresholdMax" />
                                </div>
                            </div>

                            <p class="profile-disclaimer app-disclosure">
                                ActiveVitals is a personal health tracking and awareness tool. It helps users record and review their own wellness data over time. It does not provide medical diagnosis, treatment recommendations, or clinical advice.
                            </p>
                        </section>

                        <div class="form-command-row">
                            @if (!string.IsNullOrWhiteSpace(_profileToast))
                            {
                                <div class="profile-toast" role="status">
                                    <span class="profile-toast-icon" aria-hidden="true">✓</span>
                                    <span>@_profileToast</span>
                                    <button type="button" aria-label="Dismiss profile update message" @onclick="DismissProfileToast">×</button>
                                </div>
                            }
                            <button type="submit" class="primary-action" disabled="@LoginSession.IsDemo">Save Profile</button>
                        </div>
                    </EditForm>
                </article>
            </section>
        </main>
    </section>
}

@code {
    [SupplyParameterFromForm(FormName = "profile-form")]
    private ProfileForm Model { get; set; } = default!;

    private long? _nutritionGoalId;
    private DateTime? _createdAt;
    private DateTime? _updatedAt;
    private string? _message;
    private string _messageClass = "page-message";
    private string? _profileToast;

    protected override async Task OnParametersSetAsync()
    {
        Model ??= new ProfileForm();

        await LoginSession.RestoreAsync();

        if (!LoginSession.IsSignedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            return;
        }

        if (ModelIsEmpty)
            LoadProfile();
    }

    private bool ModelIsEmpty =>
        string.IsNullOrWhiteSpace(Model.FirstName) &&
        string.IsNullOrWhiteSpace(Model.LastName) &&
        string.IsNullOrWhiteSpace(Model.UserName);

    private string DisplayName =>
        string.IsNullOrWhiteSpace(Model.FirstName) && string.IsNullOrWhiteSpace(Model.LastName)
            ? "Profile"
            : $"{Model.FirstName} {Model.LastName}".Trim();

    private string Initials
    {
        get
        {
            var first = string.IsNullOrWhiteSpace(Model.FirstName) ? string.Empty : Model.FirstName.Trim()[0].ToString();
            var last = string.IsNullOrWhiteSpace(Model.LastName) ? string.Empty : Model.LastName.Trim()[0].ToString();
            return string.IsNullOrWhiteSpace(first + last) ? "DV" : (first + last).ToUpperInvariant();
        }
    }

    private string ProfileDetails
    {
        get
        {
            var parts = new List<string>();

            if (Model.BirthDate.HasValue)
                parts.Add(Model.BirthDate.Value.ToString("M/d/yyyy"));

            if (!string.IsNullOrWhiteSpace(Model.Gender))
                parts.Add(Model.Gender);

            if (SelectedHeightFt.HasValue)
                parts.Add($"{Model.HeightFeet} ft {Model.HeightInches} in ({SelectedHeightFt.Value:0.##} ft)");

            if (Model.IsDiabetic)
                parts.Add("Diabetic");

            if (Model.TrackKidneyLabs)
                parts.Add("Kidney labs on");

            if (Model.TrackWeightLoss)
                parts.Add("Weight focus");

            return parts.Count == 0 ? "No profile details entered yet." : string.Join(" | ", parts);
        }
    }

    private string AuditText
    {
        get
        {
            if (_updatedAt.HasValue)
                return $"Updated at: {_updatedAt.Value:g}";

            if (_createdAt.HasValue)
                return $"Created at: {_createdAt.Value:g}";

            return string.Empty;
        }
    }

    private void LoadProfile()
    {
        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            return;
        }

        try
        {
            var person = PersonService.GetPersonById(LoginSession.PersonId.Value);
            if (person is null)
            {
                ShowError("Profile could not be found.");
                return;
            }

            Model.FirstName = person.FirstName;
            Model.LastName = person.LastName;
            Model.UserName = LoginSession.UserName;
            Model.BirthDate = person.BirthDate;
            Model.Gender = person.Gender;
            Model.IsDiabetic = person.IsDiabetic;
            Model.GlucoseTargetMgDl = person.GlucoseTargetMgDl ?? 100;
            Model.TrackKidneyLabs = person.TrackKidneyLabs;
            Model.TrackWeightLoss = person.TrackWeightLoss;
            Model.BirthDateText = person.BirthDate?.ToString("yyyy-MM-dd") ?? string.Empty;
            _createdAt = person.CreatedAt;
            _updatedAt = person.UpdatedAt;
            SetHeightSelectors(person.HeightFt);
            LoadNutritionGoal(person.PersonId);
            LoadBloodPressureThresholds(person.PersonId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Profile load failed.");
            ShowError("Profile could not be loaded. Please try again.");
        }
    }

    private void LoadNutritionGoal(long personId)
    {
        var goal = NutritionGoalService.GetActiveGoal(personId, DateTime.Today);
        _nutritionGoalId = goal?.NutritionGoalId;
        Model.GoalEffectiveDateText = (goal?.EffectiveDate ?? DateTime.Today).ToString("yyyy-MM-dd");
        Model.PhosphorusLimitMg = goal?.PhosphorusLimitMg ?? 1000;
        Model.SodiumLimitMg = goal?.SodiumLimitMg ?? 2000;
        Model.CalorieLimit = goal?.CalorieLimit ?? 2200;
        Model.ProteinTargetG = goal?.ProteinTargetG ?? 100;
        Model.PotassiumLimitMg = goal?.PotassiumLimitMg ?? 2500;
        Model.FluidLimitMl = goal?.FluidLimitMl ?? 2500;
    }

    private void LoadBloodPressureThresholds(long personId)
    {
        var systolic = VitalThresholdService.GetActiveThreshold(personId, VitalThresholdService.BloodPressureSystolic);
        var diastolic = VitalThresholdService.GetActiveThreshold(personId, VitalThresholdService.BloodPressureDiastolic);

        Model.SystolicThresholdMax = systolic?.MaxValue.HasValue == true
            ? Convert.ToInt32(systolic.MaxValue.Value)
            : 130;

        Model.DiastolicThresholdMax = diastolic?.MaxValue.HasValue == true
            ? Convert.ToInt32(diastolic.MaxValue.Value)
            : 80;
    }

    private async Task SaveProfile()
    {
        if (LoginSession.IsDemo)
        {
            ShowError(DemoModeGuard.ReadOnlyMessage);
            return;
        }

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            return;
        }

        if (string.IsNullOrWhiteSpace(Model.BirthDateText))
        {
            ShowError("Birth date is required for account recovery.");
            return;
        }

        if (!DateTime.TryParse(Model.BirthDateText, out var parsedBirthDate))
        {
            ShowError("Enter a valid birth date.");
            return;
        }

        var birthDate = parsedBirthDate.Date;

        try
        {
            if (!DateTime.TryParse(Model.GoalEffectiveDateText, out var goalEffectiveDate))
            {
                ShowError("Enter a valid nutrition goal effective date.");
                return;
            }

            PersonService.UpdatePerson(
                LoginSession.PersonId.Value,
                Model.FirstName!.Trim(),
                Model.LastName!.Trim(),
                SelectedHeightFt,
                birthDate,
                Model.Gender,
                Model.IsDiabetic,
                Model.GlucoseTargetMgDl,
                Model.TrackKidneyLabs,
                Model.TrackWeightLoss);

            var trimmedUserName = Model.UserName!.Trim();
            if (!string.Equals(trimmedUserName, LoginSession.UserName, StringComparison.OrdinalIgnoreCase))
            {
                LoginUserService.UpdateUserNameForPerson(LoginSession.PersonId.Value, trimmedUserName);
                await LoginSession.UpdateUserNameAsync(trimmedUserName);
                Model.UserName = trimmedUserName;
            }

            _nutritionGoalId = NutritionGoalService.SaveGoal(new NutritionGoal
            {
                NutritionGoalId = _nutritionGoalId ?? 0,
                PersonId = LoginSession.PersonId.Value,
                SodiumLimitMg = Model.SodiumLimitMg!.Value,
                PhosphorusLimitMg = Model.PhosphorusLimitMg!.Value,
                CalorieLimit = Model.CalorieLimit!.Value,
                EffectiveDate = goalEffectiveDate.Date,
                ProteinTargetG = Model.ProteinTargetG,
                PotassiumLimitMg = Model.PotassiumLimitMg,
                FluidLimitMl = Model.FluidLimitMl
            });

            VitalThresholdService.SavePersonThreshold(
                LoginSession.PersonId.Value,
                VitalThresholdService.BloodPressureSystolic,
                minValue: null,
                maxValue: Model.SystolicThresholdMax);

            VitalThresholdService.SavePersonThreshold(
                LoginSession.PersonId.Value,
                VitalThresholdService.BloodPressureDiastolic,
                minValue: null,
                maxValue: Model.DiastolicThresholdMax);

            Model.BirthDate = birthDate;
            _updatedAt = DateTime.Now;
            _messageClass = "page-message";
            _message = null;
            _profileToast = "Profile and nutrition targets updated.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Profile save failed.");
            ShowError("Profile could not be saved. Please try again.");
        }
    }

    private void ShowError(string message)
    {
        _messageClass = "page-message page-message--error";
        _message = message;
        _profileToast = null;
    }

    private void DismissProfileToast()
    {
        _profileToast = null;
    }

    private async Task SignOut()
    {
        await LoginSession.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private decimal? SelectedHeightFt => Model.HeightFeet <= 0 ? null : Model.HeightFeet + (Model.HeightInches / 12m);

    private void SetHeightSelectors(decimal? heightFt)
    {
        if (!heightFt.HasValue || heightFt.Value <= 0)
        {
            Model.HeightFeet = 5;
            Model.HeightInches = 0;
            return;
        }

        var feet = (int)Math.Truncate(heightFt.Value);
        var inches = (int)Math.Round((heightFt.Value - feet) * 12m);

        if (inches >= 12)
        {
            feet += inches / 12;
            inches %= 12;
        }

        Model.HeightFeet = Math.Clamp(feet, 3, 8);
        Model.HeightInches = Math.Clamp(inches, 0, 11);
    }

    private sealed class ProfileForm
    {
        [Required(ErrorMessage = "Enter a first name.")]
        public string? FirstName { get; set; }

        [Required(ErrorMessage = "Enter a last name.")]
        public string? LastName { get; set; }

        [Required(ErrorMessage = "Enter an email.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? UserName { get; set; }

        public DateTime? BirthDate { get; set; }

        public string BirthDateText { get; set; } = string.Empty;

        public string? Gender { get; set; }

        public int HeightFeet { get; set; } = 5;

        public int HeightInches { get; set; }

        public bool IsDiabetic { get; set; }

        public int? GlucoseTargetMgDl { get; set; } = 100;

        public bool TrackKidneyLabs { get; set; }

        public bool TrackWeightLoss { get; set; }

        [Required(ErrorMessage = "Enter a phosphorus limit.")]
        [Range(1, int.MaxValue, ErrorMessage = "Phosphorus limit must be greater than zero.")]
        public int? PhosphorusLimitMg { get; set; } = 1000;

        public string GoalEffectiveDateText { get; set; } = DateTime.Today.ToString("yyyy-MM-dd");

        [Required(ErrorMessage = "Enter a sodium limit.")]
        [Range(1, int.MaxValue, ErrorMessage = "Sodium limit must be greater than zero.")]
        public int? SodiumLimitMg { get; set; } = 2000;

        [Required(ErrorMessage = "Enter a calorie limit.")]
        [Range(1, int.MaxValue, ErrorMessage = "Calorie limit must be greater than zero.")]
        public int? CalorieLimit { get; set; } = 2200;

        public int? ProteinTargetG { get; set; } = 100;

        public int? PotassiumLimitMg { get; set; } = 2500;

        public int? FluidLimitMl { get; set; } = 2500;

        public int? SystolicThresholdMax { get; set; } = 130;

        public int? DiastolicThresholdMax { get; set; } = 80;
    }
}



