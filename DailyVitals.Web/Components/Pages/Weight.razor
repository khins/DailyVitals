@page "/weight"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using DailyVitals.Data.Services
@using DailyVitals.Domain.Models
@using DailyVitals.Domain.Models.Calculations
@using DailyVitals.Web.Services
@inject WeightService WeightService
@inject PersonService PersonService
@inject LocalLoginSession LoginSession
@inject NavigationManager Navigation

<PageTitle>Weight | DailyVitals</PageTitle>

@if (LoginSession.IsSignedIn)
{
    <section class="dashboard-shell">
        <aside class="dashboard-rail" aria-label="Primary navigation">
            <div class="rail-brand">
                <span class="brand-mark brand-mark--compact" aria-hidden="true">DV</span>
                <span>DailyVitals</span>
            </div>

            <nav class="rail-nav">
                <a href="dashboard">Dashboard</a>
                <a href="blood-pressure">Blood Pressure</a>
                <a href="blood-glucose">Glucose</a>
                <a class="is-active" href="weight">Weight</a>
                <a href="exercise">Exercise</a>
                <a href="nutrition">Nutrition</a>
                @if (_showKidneyLabs)
                {
                    <a href="renal-foods">Renal Friendly Foods</a>
                    <a href="labs">Kidney Labs</a>
                }
            </nav>

            <a class="rail-profile" href="profile" aria-label="Profile">
                <span class="profile-icon" aria-hidden="true"></span>
                <span>Profile</span>
            </a>

            <button type="button" class="rail-signout" @onclick="SignOut">Sign out</button>
        </aside>

        <main class="dashboard-main">
            <header class="dashboard-topbar">
                <div>
                    <p class="eyebrow">DailyVitals Web</p>
                    <h1>Weight</h1>
                </div>

                <div class="dashboard-actions">
                    <div class="person-switcher">
                        <span>Person</span>
                        <strong>@LoginSession.UserName</strong>
                    </div>
                    <button type="button" class="primary-action" @onclick="BeginNewReading">New Reading</button>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="@_messageClass" role="status">@_message</div>
            }

            <section class="@BmiBandClass" aria-label="Current BMI status">
                <div>
                    <span class="status-dot"></span>
                    <span class="bmi-status-heading">
                        <strong>@BmiStatusText</strong>
                        <button type="button" class="help-icon-button bmi-help-button" title="Show BMI reference chart" aria-label="Show BMI reference chart" @onclick="ShowBmiHelp">?</button>
                    </span>
                    <p>@HeightDisplay</p>
                </div>
                <div>
                    <span>Latest weight</span>
                    <strong>@LatestWeightText</strong>
                </div>
            </section>

            <section class="entry-grid">
                <article class="dashboard-card entry-panel">
                    <div class="card-heading">
                        <div>
                            <span>@(_editingId.HasValue ? "Edit Reading" : "New Reading")</span>
                            <h2>Details</h2>
                        </div>
                    </div>

                    <EditForm Model="_form" FormName="weight-entry-form" OnValidSubmit="SaveReading" class="bp-form">
                        <DataAnnotationsValidator />

                        <div class="form-row">
                            <label for="reading-time">Reading Time</label>
                            <input id="reading-time" class="form-input" type="datetime-local" value="@_readingTimeText" @onchange="SetReadingTime" />
                        </div>

                        <div class="weight-number-grid">
                            <div class="field-group">
                                <label for="weight-value">Weight</label>
                                <InputNumber id="weight-value" class="form-input" @bind-Value="_form.WeightValue" />
                                <ValidationMessage For="() => _form.WeightValue" />
                            </div>

                            <div class="field-group">
                                <label for="weight-unit">Unit</label>
                                <InputSelect id="weight-unit" class="form-input" @bind-Value="_form.WeightUnit">
                                    <option value="lb">lb</option>
                                    <option value="kg">kg</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="bmi-panel @BmiPanelClass">
                            <strong>BMI: @BmiText</strong>
                            <span>@BmiCategory</span>
                        </div>

                        <div class="field-group">
                            <label for="notes">Notes</label>
                            <InputTextArea id="notes" class="form-input notes-input" @bind-Value="_form.Notes" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(AuditText))
                        {
                            <p class="audit-text">@AuditText</p>
                        }

                        <div class="form-command-row">
                            <button type="button" class="secondary-link" @onclick="BeginNewReading">New</button>
                            <button type="button" class="secondary-link" @onclick="DeleteSelected" disabled="@(!_editingId.HasValue)">Delete</button>
                            <button type="submit" class="primary-action">Save</button>
                        </div>
                    </EditForm>
                </article>

                <article class="dashboard-card history-panel">
                    <div class="card-heading">
                        <div>
                            <span>History</span>
                            <h2>Recent Weights</h2>
                        </div>
                        <strong>@_history.Count entries</strong>
                    </div>

                    @if (_history.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No readings yet</h2>
                            <p>Save a weight reading to start this person's history.</p>
                        </div>
                    }
                    else
                    {
                        <div class="data-table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Weight</th>
                                        <th>BMI</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var reading in _history)
                                    {
                                        <tr class="@(reading.WeightId == _editingId ? "is-selected" : null)" @onclick="() => SelectReading(reading)">
                                            <td>@reading.ReadingTime.ToString("M/d/yyyy h:mm tt")</td>
                                            <td>@reading.WeightValue.ToString("0.##") @reading.WeightUnit</td>
                                            <td>@FormatBmi(reading.WeightValue, reading.HeightFt)</td>
                                            <td>@reading.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            </section>
        </main>
    </section>

    @if (_showBmiHelp)
    {
        <div class="modal-backdrop" role="presentation" @onclick="HideBmiHelp">
            <section class="info-modal bmi-info-modal" role="dialog" aria-modal="true" aria-labelledby="bmi-help-title" @onclick:stopPropagation="true">
                <div class="info-modal-header">
                    <div>
                        <span>Informational Reference</span>
                        <h2 id="bmi-help-title">Adult BMI Categories</h2>
                    </div>
                    <button type="button" class="modal-close-button" aria-label="Close BMI reference chart" @onclick="HideBmiHelp">×</button>
                </div>

                <p class="info-modal-note">
                    BMI is a screening estimate based on height and weight. It does not diagnose health status or account for muscle mass, fluid changes, or individual medical context.
                </p>

                <div class="bmi-chart-grid">
                    <div class="bmi-chart-column">
                        <h3>Men</h3>
                        <table class="bmi-reference-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>BMI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in BmiReferenceRows)
                                {
                                    <tr>
                                        <td>@item.Category</td>
                                        <td>@item.Range</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="bmi-chart-column">
                        <h3>Women</h3>
                        <table class="bmi-reference-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>BMI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in BmiReferenceRows)
                                {
                                    <tr>
                                        <td>@item.Category</td>
                                        <td>@item.Range</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>
    }
}

@code {
    private static readonly BmiReferenceRow[] BmiReferenceRows =
    [
        new("Underweight", "Below 18.5"),
        new("Normal", "18.5 to 24.9"),
        new("Overweight", "25.0 to 29.9"),
        new("Obese", "30.0 and above")
    ];

    private readonly WeightForm _form = new();
    private readonly List<WeightReading> _history = [];
    private long? _editingId;
    private decimal? _heightFt;
    private bool _showKidneyLabs = true;
    private bool _showBmiHelp;
    private DateTime? _createdAt;
    private DateTime? _updatedAt;
    private string _readingTimeText = ToDateTimeLocal(DateTime.Now);
    private string? _message;
    private string _messageClass = "page-message";

    protected override void OnInitialized()
    {
        ResetForm();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoginSession.RestoreAsync();

        if (!LoginSession.IsSignedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            StateHasChanged();
            return;
        }

        LoadPersonPreferences();
        LoadPersonHeight();
        LoadHistory();
        StateHasChanged();
    }

    private void LoadPersonPreferences()
    {
        if (!LoginSession.PersonId.HasValue)
            return;

        _showKidneyLabs = PersonService.GetPersonById(LoginSession.PersonId.Value)?.TrackKidneyLabs ?? true;
    }

    private string BmiText => CurrentBmi?.ToString("0.0") ?? "--";

    private decimal? CurrentBmi
    {
        get
        {
            if (!_form.WeightValue.HasValue || !_heightFt.HasValue)
                return null;

            return HealthMetrics.CalculateBMI(_form.WeightValue.Value, _heightFt.Value);
        }
    }

    private string BmiCategory
    {
        get
        {
            if (!_heightFt.HasValue)
                return "Height required";

            if (!CurrentBmi.HasValue)
                return "Enter weight";

            var bmi = CurrentBmi.Value;
            if (bmi < 18.5m) return "Underweight";
            if (bmi < 25.0m) return "Normal";
            if (bmi < 30.0m) return "Overweight";
            return "Obese";
        }
    }

    private string BmiStatusText => CurrentBmi.HasValue ? $"BMI {BmiText} {BmiCategory}" : BmiCategory;

    private string BmiBandClass =>
        BmiCategory switch
        {
            "Normal" => "status-band status-band--ok",
            "Underweight" => "status-band status-band--watch",
            "Overweight" => "status-band status-band--watch",
            "Obese" => "status-band status-band--high",
            _ => "status-band"
        };

    private string BmiPanelClass =>
        BmiCategory switch
        {
            "Normal" => "bmi-panel--ok",
            "Underweight" => "bmi-panel--watch",
            "Overweight" => "bmi-panel--watch",
            "Obese" => "bmi-panel--high",
            _ => string.Empty
        };

    private string LatestWeightText =>
        _history.Count == 0
            ? "None yet"
            : $"{_history[0].WeightValue:0.##} {_history[0].WeightUnit} on {_history[0].ReadingTime:M/d/yyyy}";

    private string HeightDisplay =>
        _heightFt.HasValue
            ? $"Height: {FormatHeight(_heightFt.Value)} ({_heightFt.Value:0.00} ft)"
            : "Set height on Profile before using BMI.";

    private string AuditText
    {
        get
        {
            if (_updatedAt.HasValue)
                return $"Updated at: {_updatedAt.Value:g}";

            if (_createdAt.HasValue)
                return $"Created at: {_createdAt.Value:g}";

            return string.Empty;
        }
    }

    private void LoadPersonHeight()
    {
        if (!LoginSession.PersonId.HasValue)
            return;

        var person = PersonService.GetPersonById(LoginSession.PersonId.Value);
        _heightFt = person?.HeightFt;
    }

    private void LoadHistory()
    {
        _history.Clear();

        if (!LoginSession.PersonId.HasValue)
            return;

        _history.AddRange(WeightService.GetHistory(LoginSession.PersonId.Value));
    }

    private void SelectReading(WeightReading reading)
    {
        _editingId = reading.WeightId;
        _form.WeightValue = reading.WeightValue;
        _form.WeightUnit = string.IsNullOrWhiteSpace(reading.WeightUnit) ? "lb" : reading.WeightUnit;
        _form.Notes = reading.Notes ?? string.Empty;
        _readingTimeText = ToDateTimeLocal(reading.ReadingTime);
        _createdAt = reading.CreatedAt;
        _updatedAt = reading.UpdatedAt;
        _message = null;
    }

    private void BeginNewReading()
    {
        ResetForm();
        _message = null;
    }

    private void SetReadingTime(ChangeEventArgs args)
    {
        _readingTimeText = args.Value?.ToString() ?? string.Empty;
    }

    private void ResetForm()
    {
        var now = DateTime.Now;
        _editingId = null;
        _form.WeightValue = null;
        _form.WeightUnit = "lb";
        _form.Notes = "Morning weigh-in";
        _readingTimeText = ToDateTimeLocal(now);
        _createdAt = null;
        _updatedAt = null;
    }

    private void SaveReading()
    {
        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            return;
        }

        if (!_heightFt.HasValue)
        {
            ShowError("Set height on Profile before saving weight.");
            return;
        }

        if (!TryGetReadingTime(out var readingTime))
            return;

        if (!IsWeightInValidRange())
        {
            ShowError(WeightRangeMessage);
            return;
        }

        var personId = LoginSession.PersonId.Value;
        var weightValue = _form.WeightValue.GetValueOrDefault();
        var notes = _form.Notes ?? string.Empty;

        try
        {
            if (_editingId.HasValue)
            {
                var updated = WeightService.UpdateWeightForPerson(
                    personId,
                    _editingId.Value,
                    weightValue,
                    _form.WeightUnit,
                    readingTime,
                    notes,
                    LoginSession.UserName ?? string.Empty);

                if (!updated)
                {
                    ShowError("The selected weight record could not be updated.");
                    return;
                }

                ShowSuccess("Weight reading updated.");
            }
            else
            {
                var insertedId = WeightService.InsertWeight(
                    personId,
                    weightValue,
                    _form.WeightUnit,
                    _heightFt.Value,
                    readingTime,
                    notes,
                    LoginSession.UserName ?? string.Empty);

                _editingId = insertedId;
                ShowSuccess("Weight reading saved.");
            }

            LoadHistory();

            var selected = _history.FirstOrDefault(x => x.WeightId == _editingId);
            if (selected is not null)
                SelectReading(selected);
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private void DeleteSelected()
    {
        if (!_editingId.HasValue || !LoginSession.PersonId.HasValue)
            return;

        try
        {
            var deleted = WeightService.DeleteWeightForPerson(
                LoginSession.PersonId.Value,
                _editingId.Value);

            if (!deleted)
            {
                ShowError("The selected weight record could not be deleted.");
                return;
            }

            LoadHistory();
            ResetForm();
            ShowSuccess("Weight reading deleted.");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private bool TryGetReadingTime(out DateTime readingTime)
    {
        if (DateTime.TryParse(_readingTimeText, out readingTime))
            return true;

        ShowError("Enter a valid reading time.");
        return false;
    }

    private void ShowSuccess(string message)
    {
        _messageClass = "page-message";
        _message = message;
    }

    private void ShowError(string message)
    {
        _messageClass = "page-message page-message--error";
        _message = message;
    }

    private void ShowBmiHelp()
    {
        _showBmiHelp = true;
    }

    private void HideBmiHelp()
    {
        _showBmiHelp = false;
    }

    private async Task SignOut()
    {
        await LoginSession.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private static string ToDateTimeLocal(DateTime value) => value.ToString("yyyy-MM-ddTHH:mm");

    private static string FormatBmi(decimal weight, decimal? heightFt)
    {
        if (!heightFt.HasValue)
            return string.Empty;

        return HealthMetrics.CalculateBMI(weight, heightFt.Value)?.ToString("0.0") ?? string.Empty;
    }

    private static string FormatHeight(decimal heightFt)
    {
        var feet = (int)Math.Truncate(heightFt);
        var inches = (int)Math.Round((heightFt - feet) * 100m);

        if (inches >= 12)
        {
            feet += inches / 12;
            inches %= 12;
        }

        return $"{feet} ft {inches} in";
    }

    private bool IsWeightInValidRange()
    {
        if (!_form.WeightValue.HasValue)
            return false;

        return string.Equals(_form.WeightUnit, "kg", StringComparison.OrdinalIgnoreCase)
            ? _form.WeightValue.Value is >= 3.0m and <= 500.0m
            : _form.WeightValue.Value is >= 6.6m and <= 1102.3m;
    }

    private const string WeightRangeMessage = "Range: 6.6 to 1102.3 lbs. Or 3.0 to 500.0 kg.";

    private sealed class WeightForm
    {
        [Required]
        [Range(typeof(decimal), "3.0", "1102.3", ErrorMessage = WeightRangeMessage)]
        public decimal? WeightValue { get; set; }

        public string WeightUnit { get; set; } = "lb";

        public string? Notes { get; set; }
    }

    private sealed record BmiReferenceRow(string Category, string Range);
}
