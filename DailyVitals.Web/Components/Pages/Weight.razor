@page "/weight"
@attribute [Authorize]
@rendermode InteractiveServer
@using DailyVitals.Data.Services
@using DailyVitals.Domain.Models
@using DailyVitals.Domain.Models.Calculations
@using DailyVitals.Web.Services
@inject WeightService WeightService
@inject PersonService PersonService
@inject LocalLoginSession LoginSession
@inject NavigationManager Navigation
@inject ILogger<Weight> Logger

<PageTitle>Weight | DailyVitals</PageTitle>

@if (LoginSession.IsSignedIn)
{
    <section class="dashboard-shell @(LoginSession.IsDemo ? "demo-mode" : null)">
        <aside class="dashboard-rail" aria-label="Primary navigation">
            <div class="rail-brand">
                <span class="brand-mark brand-mark--compact" aria-hidden="true">MAV</span>
                <span>My Active Vitals</span>
            </div>

            <nav class="rail-nav">
                <a href="dashboard">Dashboard</a>
                <a href="blood-pressure">Blood Pressure</a>
                <a href="blood-glucose">Glucose</a>
                <button type="button" class="rail-nav-toggle is-active" aria-expanded="@_isWeightMenuOpen" @onclick="ToggleWeightMenu">
                    <span>Weight</span>
                    <span aria-hidden="true">@(_isWeightMenuOpen ? "-" : "+")</span>
                </button>
                @if (_isWeightMenuOpen)
                {
                    <div class="rail-subnav" aria-label="Weight sections">
                        <a class="rail-subnav-button is-active" href="weight">Entry</a>
                        <a class="rail-subnav-button" href="weight-trend">Trend</a>
                    </div>
                }
                <a href="exercise">Exercise</a>
                <a href="reports">Reports</a>
                <a href="nutrition">Nutrition</a>
                <a href="fluid-intake">Fluid Intake</a>
                @if (_showKidneyLabs)
                {
                    <a href="labs">Kidney Labs</a>
                }
            </nav>

            <a class="rail-profile" href="profile" aria-label="Profile">
                <span class="profile-icon" aria-hidden="true"></span>
                <span>Profile</span>
            </a>

            <a class="rail-signout" href="signout">Sign out</a>
        </aside>

        <main class="dashboard-main">
            <DemoModeBanner />
            <header class="dashboard-topbar">
                <div>
                    <p class="eyebrow">My Active Vitals</p>
                    <h1>Weight</h1>
                </div>

                <div class="dashboard-actions">
                    <div class="person-switcher">
                        <span>Person</span>
                        <strong>@LoginSession.PersonDisplayName</strong>
                    </div>
                    <button type="button" class="primary-action" @onclick="BeginNewReading">New Reading</button>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="@_messageClass" role="status">@_message</div>
            }

            <section class="@BmiBandClass" aria-label="Current BMI status">
                <div>
                    <span class="status-dot"></span>
                    <span class="bmi-status-heading">
                        <strong>@BmiStatusText</strong>
                        <button type="button" class="help-icon-button bmi-help-button" title="Show BMI reference chart" aria-label="Show BMI reference chart" @onclick="ShowBmiHelp">?</button>
                    </span>
                    <p>@HeightDisplay</p>
                </div>
                <div>
                    <span>Latest weight</span>
                    <strong>@LatestWeightText</strong>
                </div>
            </section>

            <section class="entry-grid">
                <article class="dashboard-card entry-panel">
                    <div class="card-heading">
                        <div>
                            <span>@(_editingId.HasValue ? "Edit Reading" : "New Reading")</span>
                            <h2>Details</h2>
                        </div>
                    </div>

                    <form method="post" action="/weight/save" class="bp-form">
                        <input type="hidden" name="EditingId" value="@_editingId" />

                        <div class="form-row">
                            <label for="reading-time">Reading Time</label>
                            <input id="reading-time" name="ReadingTimeText" class="form-input" type="datetime-local" value="@_readingTimeText" required />
                        </div>

                        <div class="weight-number-grid">
                            <div class="field-group">
                                <label for="weight-value">Weight</label>
                                <input id="weight-value" name="WeightValue" type="number" step="0.1" min="3.0" max="1102.3" class="form-input" value="@_form.WeightValue" data-bmi-weight-input required />
                            </div>

                            <div class="field-group">
                                <label for="weight-unit">Unit</label>
                                <select id="weight-unit" name="WeightUnit" class="form-input" data-bmi-unit-input>
                                    <option value="lb" selected="@IsWeightUnitSelected("lb")">lb</option>
                                    <option value="kg" selected="@IsWeightUnitSelected("kg")">kg</option>
                                </select>
                            </div>
                        </div>

                        <div class="bmi-panel @BmiPanelClass" data-bmi-panel data-height-ft="@(_heightFt?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)">
                            <strong>BMI: <span data-bmi-value>@BmiText</span></strong>
                            <span data-bmi-category>@BmiCategory</span>
                        </div>

                        <div class="field-group">
                            <label for="notes">Notes</label>
                            <textarea id="notes" name="Notes" class="form-input notes-input">@_form.Notes</textarea>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(AuditText))
                        {
                            <p class="audit-text">@AuditText</p>
                        }

                        <div class="form-command-row">
                            <button type="button" class="secondary-link" @onclick="BeginNewReading" disabled="@LoginSession.IsDemo">New</button>
                            <button type="submit" class="primary-action">Save</button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_formToast))
                        {
                            <div class="profile-toast form-toast" role="status">
                                <span class="profile-toast-icon" aria-hidden="true">✓</span>
                                <span>@_formToast</span>
                                <button type="button" aria-label="Dismiss weight update message" @onclick="DismissFormToast">×</button>
                            </div>
                        }
                    </form>
                </article>

                <article class="dashboard-card history-panel">
                    <div class="card-heading">
                        <div>
                            <span>History</span>
                            <h2>Recent Weights</h2>
                        </div>
                        <strong>@_history.Count entries</strong>
                    </div>

                    @if (_history.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No readings yet</h2>
                            <p>Save a weight reading to start this person's history.</p>
                        </div>
                    }
                    else
                    {
                        <div class="data-table-wrap weight-history-table">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Weight</th>
                                        <th>BMI</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var reading in PagedHistory)
                                    {
                                        <tr class="@(reading.WeightId == _editingId ? "is-selected" : null)" @onclick="() => SelectReading(reading)">
                                            <td>@reading.ReadingTime.ToString("M/d/yyyy h:mm tt")</td>
                                            <td>@reading.WeightValue.ToString("0.##") @reading.WeightUnit</td>
                                            <td>@FormatBmi(reading.WeightValue, reading.HeightFt)</td>
                                            <td>@reading.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @RenderHistoryPager()
                    }
                </article>
            </section>

            @if (_showDeleteConfirm)
            {
                <div class="modal-backdrop" role="presentation" @onclick="CancelDelete">
                    <section class="info-modal confirm-modal" role="dialog" aria-modal="true" aria-labelledby="weight-delete-title" @onclick:stopPropagation="true">
                        <div class="info-modal-header">
                            <div>
                                <span>Confirm Delete</span>
                                <h2 id="weight-delete-title">Delete this weight reading?</h2>
                            </div>
                            <button type="button" class="modal-close-button" aria-label="Cancel delete" @onclick="CancelDelete">×</button>
                        </div>

                        <p class="info-modal-note">This will permanently remove the selected reading from your weight history.</p>
                        <p class="confirm-modal-detail">@DeleteReadingSummary</p>

                        <div class="confirm-modal-actions">
                            <button type="button" class="secondary-link" @onclick="CancelDelete">Cancel</button>
                            <button type="button" class="danger-action" @onclick="ConfirmDelete">Delete Reading</button>
                        </div>
                    </section>
                </div>
            }
        </main>
    </section>

    @if (_showBmiHelp)
    {
        <div class="modal-backdrop" role="presentation" @onclick="HideBmiHelp">
            <section class="info-modal bmi-info-modal" role="dialog" aria-modal="true" aria-labelledby="bmi-help-title" @onclick:stopPropagation="true">
                <div class="info-modal-header">
                    <div>
                        <span>Informational Reference</span>
                        <h2 id="bmi-help-title">Adult BMI Categories</h2>
                    </div>
                    <button type="button" class="modal-close-button" aria-label="Close BMI reference chart" @onclick="HideBmiHelp">×</button>
                </div>

                <p class="info-modal-note">
                    BMI is a screening estimate based on height and weight. It does not diagnose health status or account for muscle mass, fluid changes, or individual medical context.
                </p>

                <div class="bmi-chart-grid">
                    <div class="bmi-chart-column">
                        <h3>Men</h3>
                        <table class="bmi-reference-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>BMI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in BmiReferenceRows)
                                {
                                    <tr>
                                        <td>@item.Category</td>
                                        <td>@item.Range</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="bmi-chart-column">
                        <h3>Women</h3>
                        <table class="bmi-reference-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>BMI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in BmiReferenceRows)
                                {
                                    <tr>
                                        <td>@item.Category</td>
                                        <td>@item.Range</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "status")]
    private string? Status { get; set; }

    private static readonly BmiReferenceRow[] BmiReferenceRows =
    [
        new("Underweight", "Below 18.5"),
        new("Normal", "18.5 to 24.9"),
        new("Overweight", "25.0 to 29.9"),
        new("Obese", "30.0 and above")
    ];

    private readonly WeightForm _form = new();
    private readonly List<WeightReading> _history = [];
    private const int HistoryPageSize = 20;
    private long? _editingId;
    private int _historyPage = 1;
    private decimal? _heightFt;
    private bool _showKidneyLabs = true;
    private bool _isWeightMenuOpen = true;
    private bool _showBmiHelp;
    private DateTime? _createdAt;
    private DateTime? _updatedAt;
    private string _readingTimeText = ToDateTimeLocal(DateTime.Now);
    private string? _message;
    private string _messageClass = "page-message";
    private string? _formToast;
    private bool _showDeleteConfirm;

    protected override void OnInitialized()
    {
        ResetForm();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoginSession.RestoreAsync();

        if (!LoginSession.IsSignedIn)
        {
            Navigation.NavigateTo("/signin");
            return;
        }

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            StateHasChanged();
            return;
        }

        try
        {
            LoadPersonPreferences();
            LoadPersonHeight();
            LoadHistory();
            ApplyStatusMessage();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Weight page load failed.");
            ShowError("Weight data could not be loaded. Please try again.");
        }

        StateHasChanged();
    }

    private void ApplyStatusMessage()
    {
        switch (Status)
        {
            case "saved":
                ShowSuccess("Weight reading saved.");
                break;
            case "updated":
                ShowSuccess("Weight reading updated.");
                break;
            case "invalid":
                ShowError(WeightRangeMessage);
                break;
            case "height-required":
                ShowError("Set height on Profile before saving weight.");
                break;
            case "demo":
                ShowError(DemoModeGuard.ReadOnlyMessage);
                break;
            case "not-found":
                ShowError("The selected weight record could not be updated.");
                break;
            case "save-error":
                ShowError("Weight entry could not be saved. Please try again.");
                break;
        }
    }

    private void LoadPersonPreferences()
    {
        if (!LoginSession.PersonId.HasValue)
            return;

        _showKidneyLabs = PersonService.GetPersonById(LoginSession.PersonId.Value)?.TrackKidneyLabs ?? true;
    }

    private string BmiText => CurrentBmi?.ToString("0.0") ?? "--";

    private decimal? CurrentBmi
    {
        get
        {
            if (!_form.WeightValue.HasValue || !_heightFt.HasValue)
                return null;

            return HealthMetrics.CalculateBMI(_form.WeightValue.Value, _heightFt.Value);
        }
    }

    private string BmiCategory
    {
        get
        {
            if (!_heightFt.HasValue)
                return "Height required";

            if (!CurrentBmi.HasValue)
                return "Enter weight";

            var bmi = CurrentBmi.Value;
            if (bmi < 18.5m) return "Underweight";
            if (bmi < 25.0m) return "Normal";
            if (bmi < 30.0m) return "Overweight";
            return "Obese";
        }
    }

    private string BmiStatusText => CurrentBmi.HasValue ? $"BMI {BmiText} {BmiCategory}" : BmiCategory;

    private string BmiBandClass =>
        BmiCategory switch
        {
            "Normal" => "status-band status-band--ok",
            "Underweight" => "status-band status-band--watch",
            "Overweight" => "status-band status-band--watch",
            "Obese" => "status-band status-band--high",
            _ => "status-band"
        };

    private string BmiPanelClass =>
        BmiCategory switch
        {
            "Normal" => "bmi-panel--ok",
            "Underweight" => "bmi-panel--watch",
            "Overweight" => "bmi-panel--watch",
            "Obese" => "bmi-panel--high",
            _ => string.Empty
        };

    private string LatestWeightText =>
        _history.Count == 0
            ? "None yet"
            : $"{_history[0].WeightValue:0.##} {_history[0].WeightUnit} on {_history[0].ReadingTime:M/d/yyyy}";

    private string DeleteReadingSummary =>
        _editingId.HasValue
            ? $"{(_form.WeightValue.HasValue ? _form.WeightValue.Value.ToString("0.##") : "--")} {_form.WeightUnit}, {_readingTimeText}"
            : "No reading selected.";

    private List<WeightReading> PagedHistory =>
        _history
            .Skip((_historyPage - 1) * HistoryPageSize)
            .Take(HistoryPageSize)
            .ToList();

    private int HistoryPageCount =>
        Math.Max(1, (int)Math.Ceiling(_history.Count / (double)HistoryPageSize));

    private string HeightDisplay =>
        _heightFt.HasValue
            ? $"Height: {FormatHeight(_heightFt.Value)} ({_heightFt.Value:0.##} ft)"
            : "Set height on Profile before using BMI.";

    private string AuditText
    {
        get
        {
            if (_updatedAt.HasValue)
                return $"Updated at: {_updatedAt.Value:g}";

            if (_createdAt.HasValue)
                return $"Created at: {_createdAt.Value:g}";

            return string.Empty;
        }
    }

    private void LoadPersonHeight()
    {
        if (!LoginSession.PersonId.HasValue)
            return;

        var person = PersonService.GetPersonById(LoginSession.PersonId.Value);
        _heightFt = person?.HeightFt;
    }

    private void LoadHistory()
    {
        _history.Clear();

        if (!LoginSession.PersonId.HasValue)
            return;

        _history.AddRange(WeightService.GetHistory(LoginSession.PersonId.Value));
        EnsureHistoryPageInRange();
    }

    private void SelectReading(WeightReading reading, bool clearToast = true)
    {
        _editingId = reading.WeightId;
        _form.WeightValue = reading.WeightValue;
        _form.WeightUnit = string.IsNullOrWhiteSpace(reading.WeightUnit) ? "lb" : reading.WeightUnit;
        _form.Notes = reading.Notes ?? string.Empty;
        _readingTimeText = ToDateTimeLocal(reading.ReadingTime);
        _createdAt = reading.CreatedAt;
        _updatedAt = reading.UpdatedAt;
        _message = null;
        _showDeleteConfirm = false;
        if (clearToast)
            _formToast = null;
    }

    private void BeginNewReading()
    {
        ResetForm();
        _message = null;
        _formToast = null;
        _showDeleteConfirm = false;
    }

    private void ResetForm()
    {
        var now = DateTime.Now;
        _editingId = null;
        _form.WeightValue = null;
        _form.WeightUnit = "lb";
        _form.Notes = "Morning weigh-in";
        _readingTimeText = ToDateTimeLocal(now);
        _createdAt = null;
        _updatedAt = null;
    }

    private void RequestDeleteSelected()
    {
        if (!_editingId.HasValue)
            return;

        _message = null;
        _formToast = null;
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
    }

    private void ConfirmDelete()
    {
        _showDeleteConfirm = false;
        DeleteSelected();
    }

    private void DeleteSelected()
    {
        if (LoginSession.IsDemo)
        {
            ShowError(DemoModeGuard.ReadOnlyMessage);
            return;
        }

        if (!_editingId.HasValue || !LoginSession.PersonId.HasValue)
            return;

        try
        {
            var deleted = WeightService.DeleteWeightForPerson(
                LoginSession.PersonId.Value,
                _editingId.Value);

            if (!deleted)
            {
                ShowError("The selected weight record could not be deleted.");
                return;
            }

            LoadHistory();
            ResetForm();
            ShowSuccess("Weight reading deleted.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Weight entry delete failed.");
            ShowError("Weight entry could not be deleted. Please try again.");
        }
    }

    private void ShowSuccess(string message)
    {
        _messageClass = "page-message";
        _message = null;
        _formToast = message;
    }

    private void ShowError(string message)
    {
        _messageClass = "page-message page-message--error";
        _message = message;
        _formToast = null;
    }

    private void DismissFormToast()
    {
        _formToast = null;
    }

    private void ToggleWeightMenu()
    {
        _isWeightMenuOpen = !_isWeightMenuOpen;
    }

    private void PreviousHistoryPage()
    {
        if (_historyPage > 1)
            _historyPage--;
    }

    private void NextHistoryPage()
    {
        if (_historyPage < HistoryPageCount)
            _historyPage++;
    }

    private void EnsureHistoryPageInRange()
    {
        if (_historyPage > HistoryPageCount)
            _historyPage = HistoryPageCount;

        if (_historyPage < 1)
            _historyPage = 1;
    }

    private void ShowBmiHelp()
    {
        _showBmiHelp = true;
    }

    private void HideBmiHelp()
    {
        _showBmiHelp = false;
    }

    private async Task SignOut()
    {
        await LoginSession.SignOutAsync();
        Navigation.NavigateTo("/signin");
    }

    private RenderFragment RenderHistoryPager() => @<div class="table-pager">
        <button type="button" class="secondary-link compact-action" @onclick="PreviousHistoryPage" disabled="@(_historyPage <= 1)">Previous</button>
        <span>Page @_historyPage of @HistoryPageCount</span>
        <button type="button" class="secondary-link compact-action" @onclick="NextHistoryPage" disabled="@(_historyPage >= HistoryPageCount)">Next</button>
    </div>;

    private static string ToDateTimeLocal(DateTime value) => value.ToString("yyyy-MM-ddTHH:mm");

    private static string FormatBmi(decimal weight, decimal? heightFt)
    {
        if (!heightFt.HasValue)
            return string.Empty;

        return HealthMetrics.CalculateBMI(weight, heightFt.Value)?.ToString("0.0") ?? string.Empty;
    }

    private static string FormatHeight(decimal heightFt)
    {
        var feet = (int)Math.Truncate(heightFt);
        var inches = (int)Math.Round((heightFt - feet) * 12m);

        if (inches >= 12)
        {
            feet += inches / 12;
            inches %= 12;
        }

        return $"{feet} ft {inches} in";
    }

    private bool IsWeightInValidRange()
    {
        if (!_form.WeightValue.HasValue)
            return false;

        return string.Equals(_form.WeightUnit, "kg", StringComparison.OrdinalIgnoreCase)
            ? _form.WeightValue.Value is >= 3.0m and <= 500.0m
            : _form.WeightValue.Value is >= 6.6m and <= 1102.3m;
    }

    private bool IsWeightUnitSelected(string unit) =>
        string.Equals(_form.WeightUnit, unit, StringComparison.OrdinalIgnoreCase);

    private const string WeightRangeMessage = "Range: 6.6 to 1102.3 lbs. Or 3.0 to 500.0 kg.";

    private sealed class WeightForm
    {
        public decimal? WeightValue { get; set; }

        public string WeightUnit { get; set; } = "lb";

        public string? Notes { get; set; }
    }

    private sealed record BmiReferenceRow(string Category, string Range);
}


