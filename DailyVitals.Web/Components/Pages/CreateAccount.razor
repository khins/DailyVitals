@page "/create-account"
@rendermode InteractiveServer
@using DailyVitals.Web.Services
@inject LocalLoginSession LoginSession
@inject NavigationManager Navigation

<PageTitle>Create Account | DailyVitals</PageTitle>

<section class="login-page account-page">
    <div class="login-visual" aria-hidden="true">
        <div class="vitals-card">
            <div class="vitals-card__header">
                <span>New Profile</span>
                <strong>Person-scoped</strong>
            </div>
            <div class="pulse-line"></div>
            <div class="metric-grid">
                <div>
                    <span>BP</span>
                    <strong>Private</strong>
                </div>
                <div>
                    <span>Glucose</span>
                    <strong>Private</strong>
                </div>
                <div>
                    <span>Weight</span>
                    <strong>Private</strong>
                </div>
                <div>
                    <span>Labs</span>
                    <strong>Private</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="login-panel account-panel">
        <div class="brand-row">
            <div class="brand-mark" aria-hidden="true">DV</div>
            <div>
                <p class="eyebrow">DailyVitals Web</p>
                <h1>Create Account</h1>
            </div>
        </div>

        <form method="post" action="/auth/register" class="login-form account-form">
            <div class="account-form-grid">
                <div class="field-group">
                    <label for="first-name">First Name</label>
                    <input id="first-name" name="FirstName" class="form-input" autocomplete="given-name" maxlength="100" required />
                </div>

                <div class="field-group">
                    <label for="last-name">Last Name</label>
                    <input id="last-name" name="LastName" class="form-input" autocomplete="family-name" maxlength="100" required />
                </div>
            </div>

            <div class="field-group">
                <label for="account-user-name">Email</label>
                <input id="account-user-name" name="UserName" type="email" class="form-input" autocomplete="username" maxlength="255" required />
            </div>

            <div class="account-form-grid">
                <div class="field-group">
                    <label for="account-password">Password</label>
                    <input id="account-password" name="Password" type="@PasswordInputType" class="form-input" autocomplete="new-password" minlength="8" required />
                </div>

                <div class="field-group">
                    <label for="confirm-password">Confirm Password</label>
                    <input id="confirm-password" name="ConfirmPassword" type="@PasswordInputType" class="form-input" autocomplete="new-password" minlength="8" required />
                </div>
            </div>

            <label class="checkbox-row show-password-row">
                <InputCheckbox @bind-Value="_showPassword" />
                <span>Show Password</span>
            </label>

            @if (!string.IsNullOrWhiteSpace(RegistrationMessage))
            {
                <div class="login-message login-message--error" role="alert">
                    <span>@RegistrationMessage</span>
                </div>
            }

            <p class="app-disclosure app-disclosure--auth">
                ActiveVitals is a personal health tracking and awareness tool. It helps users record and review their own wellness data over time. It does not provide medical diagnosis, treatment recommendations, or clinical advice.
            </p>

            <button type="submit" class="primary-button">Create Account</button>
            <a class="form-link" href="/">Back to sign in</a>
        </form>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "registration")]
    private string? RegistrationResult { get; set; }

    private bool _showPassword;

    private string PasswordInputType => _showPassword ? "text" : "password";
    private string? RegistrationMessage => RegistrationResult switch
    {
        "missing" => "Complete all required fields.",
        "invalid" => "One or more account details are too long.",
        "invalid-email" => "Enter a valid email address.",
        "short-password" => "Password must be at least 8 characters.",
        "password-mismatch" => "Passwords must match.",
        "email-in-use" => "That email is already in use. Sign in or recover the existing account.",
        "failed" => "Account could not be created. Please try again.",
        _ => null
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoginSession.RestoreAsync();

        if (LoginSession.IsSignedIn)
            Navigation.NavigateTo("/dashboard", replace: true);
    }

}
