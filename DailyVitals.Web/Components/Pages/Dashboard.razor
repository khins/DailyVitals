@page "/dashboard"
@rendermode InteractiveServer
@using DailyVitals.Data.Services
@using DailyVitals.Data.Services.DailyVitals.App.Services
@using DailyVitals.Domain.Models
@using DailyVitals.Web.Services
@inject BloodPressureService BloodPressureService
@inject BloodGlucoseService BloodGlucoseService
@inject WeightService WeightService
@inject ExerciseService ExerciseService
@inject FoodPhosphorusIntakeService FoodService
@inject NutritionGoalService NutritionGoalService
@inject KidneyLabResultService KidneyLabService
@inject PersonService PersonService
@inject VitalThresholdService VitalThresholdService
@inject NavigationManager Navigation
@inject LocalLoginSession LoginSession

<PageTitle>Dashboard | DailyVitals</PageTitle>

@if (LoginSession.IsSignedIn)
{
    <section class="dashboard-shell">
        <aside class="dashboard-rail" aria-label="Primary navigation">
            <div class="rail-brand">
                <span class="brand-mark brand-mark--compact" aria-hidden="true">DV</span>
                <span>DailyVitals</span>
            </div>

            <nav class="rail-nav">
                <a class="is-active" href="dashboard">Dashboard</a>
                <a href="blood-pressure">Blood Pressure</a>
                <a href="blood-glucose">Glucose</a>
                <a href="weight">Weight</a>
                <a href="exercise">Exercise</a>
                <a href="reports">Reports</a>
                <a href="nutrition">Nutrition</a>
                @if (ShowKidneyLabs)
                {
                    <a href="renal-foods">Renal Friendly Foods</a>
                    <a href="labs">Kidney Labs</a>
                }
            </nav>

            <a class="rail-profile" href="profile" aria-label="Profile">
                <span class="profile-icon" aria-hidden="true"></span>
                <span>Profile</span>
            </a>

            <button type="button" class="rail-signout" @onclick="SignOut">Sign out</button>
        </aside>

        <main class="dashboard-main">
            <header class="dashboard-topbar">
                <div>
                    <p class="eyebrow">DailyVitals Web</p>
                    <h1>Vitals Dashboard</h1>
                </div>

                <div class="dashboard-actions">
                    <div class="person-switcher">
                        <span>Person</span>
                        <strong>@LoginSession.UserName</strong>
                    </div>
                    <button type="button" class="secondary-link">Today</button>
                    <a class="primary-action" href="blood-pressure">Add Reading</a>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="@_messageClass" role="status">@_message</div>
            }

            <section class="@OverallStatusBandClass" aria-label="Current status">
                <div>
                    <span class="status-dot"></span>
                    <strong>@OverallStatusTitle</strong>
                    <p>@OverallStatusDetail</p>
                </div>
                <div>
                    <span>Dashboard data</span>
                    <strong>@DashboardDataSummary</strong>
                </div>
            </section>

            <section class="metric-card-grid" aria-label="Vital summary">
                @foreach (var metric in Metrics)
                {
                    <article class="dashboard-card metric-card">
                        <div class="card-heading">
                            <span>@metric.Label</span>
                            <strong class="@metric.StatusClass">@metric.Status</strong>
                        </div>
                        <div class="metric-value">
                            @metric.Value
                            <span>@metric.Unit</span>
                        </div>
                        <p>@metric.Context</p>
                    </article>
                }
            </section>

            <section class="dashboard-grid">
                <article class="dashboard-card trend-panel">
                    <div class="card-heading">
                        <div>
                            <span>Seven-day trend</span>
                            <h2>Blood Pressure</h2>
                        </div>
                        <strong class="@BloodPressureStatusClass">@BloodPressureStatus</strong>
                    </div>

                    @if (BloodPressureTrend.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No blood pressure trend yet</h2>
                            <p>Add blood pressure readings to build this chart.</p>
                        </div>
                    }
                    else
                    {
                        <div class="bar-chart" aria-label="Blood pressure trend">
                            @foreach (var point in BloodPressureTrend)
                            {
                                <div class="bar-column">
                                    <span class="bar-value">@point.Value</span>
                                    <span class="bar-track">
                                        <span class="bar-fill" style="height:@point.Height%"></span>
                                    </span>
                                    <span class="bar-label">@point.Label</span>
                                </div>
                            }
                        </div>
                    }
                </article>

                <article class="dashboard-card attention-panel">
                    <div class="card-heading">
                        <div>
                            <span>Needs attention</span>
                            <h2>Today</h2>
                        </div>
                        <strong class="@AttentionStatusClass">@AttentionStatus</strong>
                    </div>

                    <div class="attention-list">
                        @foreach (var item in AttentionItems)
                        {
                            <div class="attention-row">
                                <span class="@item.MarkerClass"></span>
                                <div>
                                    <strong>@item.Title</strong>
                                    <p>@item.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                </article>

                <article class="dashboard-card nutrition-panel">
                    <div class="card-heading">
                        <div>
                            <span>Nutrition</span>
                            <h2>Daily Targets</h2>
                        </div>
                        <strong>@TodayNutritionEffectiveText</strong>
                    </div>

                    <p class="nutrition-target-caption">@TodayNutritionSummaryText</p>

                    <div class="nutrition-target-table" role="table" aria-label="Daily nutrition targets">
                        <div class="nutrition-target-row nutrition-target-head" role="row">
                            <span role="columnheader">Nutrient</span>
                            <span role="columnheader">Consumed</span>
                            <span role="columnheader">Daily Target</span>
                            <span role="columnheader">Remaining</span>
                        </div>

                        @foreach (var target in DailyNutritionTargets)
                        {
                            <div class="nutrition-target-row" role="row">
                                <span role="cell">@target.Nutrient</span>
                                <span role="cell">@target.Consumed</span>
                                <span role="cell">@target.Target</span>
                                <strong class="@target.RemainingClass" role="cell">@target.Remaining</strong>
                            </div>
                        }
                    </div>
                </article>

                <article class="dashboard-card activity-panel">
                    <div class="card-heading">
                        <div>
                            <span>Recent activity</span>
                            <h2>Latest Entries</h2>
                        </div>
                    </div>

                    @if (RecentEntries.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No recent activity</h2>
                            <p>Save a BP, weight, or exercise entry to populate this list.</p>
                        </div>
                    }
                    else
                    {
                        <div class="activity-list">
                            @foreach (var entry in RecentEntries)
                            {
                                <div class="activity-row">
                                    <time>@entry.Time</time>
                                    <div>
                                        <strong>@entry.Title</strong>
                                        <p>@entry.Detail</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </article>

                <article class="dashboard-card exercise-trend-panel">
                    <div class="card-heading">
                        <div>
                            <span>Exercise</span>
                            <h2>Calories Burned Per Session</h2>
                        </div>
                        <strong>@ExerciseTrendSummary</strong>
                    </div>

                    @if (ExerciseSessionTrendPoints.Count < 2)
                    {
                        <div class="empty-state compact-empty">
                            <h2>More exercise data needed</h2>
                            <p>Add at least two exercise sessions to chart session calories.</p>
                        </div>
                    }
                    else
                    {
                        <div class="exercise-line-chart" aria-label="Calories burned per exercise session">
                            <div class="chart-legend">
                                <span><i class="legend-orange"></i>Session calories</span>
                                <span><i class="legend-blue"></i>7-session rolling average</span>
                            </div>
                            <svg viewBox="0 0 100 48" preserveAspectRatio="none" role="img">
                                <polyline class="session-line" points="@ExerciseSessionPolyline" />
                                <polyline class="average-line" points="@ExerciseRollingAveragePolyline" />
                            </svg>
                            <strong>@ExerciseTrendFooter</strong>
                        </div>
                    }
                </article>

                <article class="dashboard-card exercise-month-panel">
                    <div class="card-heading">
                        <div>
                            <span>Exercise</span>
                            <h2>Total Calories Burned Per Month</h2>
                        </div>
                        <strong>@ExerciseTopMonthText</strong>
                    </div>

                    @if (ExerciseMonthlyTotals.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <h2>No monthly exercise totals</h2>
                            <p>Save exercise sessions with calories to build monthly totals.</p>
                        </div>
                    }
                    else
                    {
                        <div class="monthly-bar-chart" aria-label="Total calories burned per month">
                            @foreach (var month in ExerciseMonthlyTotals)
                            {
                                <div class="monthly-bar-column">
                                    <strong>@month.TotalCalories.ToString("N0") cal</strong>
                                    <small>@FormatDuration(month.TotalMinutes)</small>
                                    <span class="monthly-bar-track">
                                        <span class="monthly-bar-fill" style="height:@month.HeightPercent%"></span>
                                    </span>
                                    <span>@month.Label</span>
                                </div>
                            }
                        </div>
                    }
                </article>
            </section>

            <p class="dashboard-disclosure">
                ActiveVitals is for personal tracking and awareness only, not medical diagnosis or treatment advice.
            </p>
        </main>
    </section>
}

@code {
    private readonly List<BloodPressureReading> _bloodPressureHistory = [];
    private readonly List<BloodGlucoseReading> _bloodGlucoseHistory = [];
    private readonly List<WeightReading> _weightHistory = [];
    private readonly List<ExerciseSession> _exerciseHistory = [];
    private readonly List<FoodPhosphorusRunningTotal> _nutritionRows = [];
    private readonly List<KidneyLabResult> _kidneyLabHistory = [];
    private Person? _person;
    private NutritionGoal? _nutritionGoal;
    private int _systolicAlertMax = 130;
    private int _diastolicAlertMax = 80;
    private string? _message;
    private string _messageClass = "page-message";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoginSession.RestoreAsync();

        if (!LoginSession.IsSignedIn)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!LoginSession.PersonId.HasValue)
        {
            ShowError("This login is not linked to a person record yet.");
            StateHasChanged();
            return;
        }

        LoadDashboard();
        StateHasChanged();
    }

    private IReadOnlyList<MetricCard> Metrics =>
    [
        BuildBloodPressureMetric(),
        BuildBloodGlucoseMetric(),
        BuildWeightMetric(),
        BuildExerciseMetric()
    ];

    private IReadOnlyList<DashboardChartPoint> BloodPressureTrend =>
        _bloodPressureHistory
            .Take(7)
            .Reverse()
            .Select(x => new DashboardChartPoint(
                x.ReadingTime.ToString("ddd"),
                $"{x.Systolic}/{x.Diastolic}",
                ScaleBloodPressureHeight(x.Systolic)))
            .ToList();

    private IReadOnlyList<AttentionItem> AttentionItems => BuildAttentionItems();

    private IReadOnlyList<ActivityEntry> RecentEntries => BuildRecentEntries();

    private bool ShowKidneyLabs => _person?.TrackKidneyLabs ?? true;

    private bool ShowGlucoseAlerts => _person?.IsDiabetic ?? true;

    private string DashboardDataSummary
    {
        get
        {
            var sectionsWithData = 0;
            if (_bloodPressureHistory.Count > 0) sectionsWithData++;
            if (_bloodGlucoseHistory.Count > 0) sectionsWithData++;
            if (_weightHistory.Count > 0) sectionsWithData++;
            if (_exerciseHistory.Count > 0) sectionsWithData++;
            if (TodayNutritionRows.Any()) sectionsWithData++;

            return sectionsWithData == 0
                ? "No entries yet"
                : $"{sectionsWithData} of 5 sections active";
        }
    }

    private string OverallStatusBandClass
    {
        get
        {
            if (!HasDashboardData)
                return "status-band";

            return BloodPressureStatus switch
            {
                "High" => "status-band status-band--high",
                "Elevated" => "status-band status-band--watch",
                _ => AttentionItems.Any(x => x.MarkerClass.Contains("marker-watch")) ? "status-band status-band--watch" : "status-band status-band--ok"
            };
        }
    }

    private string OverallStatusTitle
    {
        get
        {
            if (!HasDashboardData)
                return "Ready to start tracking";

            if (BloodPressureStatus == "High")
                return "Blood pressure needs attention";

            return "Dashboard is current";
        }
    }

    private string OverallStatusDetail
    {
        get
        {
            if (!HasDashboardData)
                return "Add a blood pressure, glucose, weight, exercise, or nutrition entry to build this person's dashboard.";

            var latest = RecentEntries.FirstOrDefault();
            return latest is null
                ? "Records are scoped to the signed-in person."
                : $"Latest entry: {latest.Title.ToLowerInvariant()} on {latest.Time}.";
        }
    }

    private BloodPressureReading? LatestBloodPressure => _bloodPressureHistory.FirstOrDefault();

    private BloodGlucoseReading? LatestBloodGlucose => _bloodGlucoseHistory.FirstOrDefault();

    private WeightReading? LatestWeight => _weightHistory.FirstOrDefault();

    private ExerciseSession? LatestExercise => _exerciseHistory.FirstOrDefault();

    private bool HasDashboardData =>
        _bloodPressureHistory.Count > 0 ||
        _bloodGlucoseHistory.Count > 0 ||
        _weightHistory.Count > 0 ||
        _exerciseHistory.Count > 0 ||
        TodayNutritionRows.Any();

    private string BloodPressureStatus
    {
        get
        {
            var latest = LatestBloodPressure;
            if (latest is null)
                return "No data";

            if (latest.Systolic > _systolicAlertMax || latest.Diastolic > _diastolicAlertMax)
                return "High";

            if (latest.Systolic >= 120 && latest.Diastolic < 80)
                return "Elevated";

            return "Normal";
        }
    }

    private string BloodPressureStatusClass =>
        BloodPressureStatus switch
        {
            "Normal" => "status-pill status-ok",
            "No data" => "status-pill status-info",
            "Elevated" => "status-pill status-watch",
            _ => "status-pill status-watch"
        };

    private string AttentionStatus =>
        AttentionItems.Count == 0 || AttentionItems.Any(x => x.Title == "All clear")
            ? "All clear"
            : $"{AttentionItems.Count} item{(AttentionItems.Count == 1 ? "" : "s")}";

    private string AttentionStatusClass =>
        AttentionItems.Count == 0 || AttentionItems.Any(x => x.Title == "All clear")
            ? "status-pill status-ok"
            : "status-pill status-watch";

    private void LoadDashboard()
    {
            _bloodPressureHistory.Clear();
            _bloodGlucoseHistory.Clear();
            _weightHistory.Clear();
            _exerciseHistory.Clear();
            _nutritionRows.Clear();
            _kidneyLabHistory.Clear();
            _nutritionGoal = null;
            _person = null;
            _systolicAlertMax = 130;
            _diastolicAlertMax = 80;

        if (!LoginSession.PersonId.HasValue)
            return;

        try
        {
            var personId = LoginSession.PersonId.Value;
            _person = PersonService.GetPersonById(personId);
            LoadBloodPressureThresholds(personId);
            _bloodPressureHistory.AddRange(BloodPressureService.GetHistoryForPerson(personId));
            _bloodGlucoseHistory.AddRange(BloodGlucoseService.GetHistory(personId));
            _weightHistory.AddRange(WeightService.GetHistory(personId));
            _exerciseHistory.AddRange(ExerciseService.GetHistory(personId));
            _nutritionRows.AddRange(FoodService.GetRunningDailyTotals(personId));
            if (ShowKidneyLabs)
                _kidneyLabHistory.AddRange(KidneyLabService.GetHistory(personId));
            _nutritionGoal = NutritionGoalService.GetActiveGoal(personId, DateTime.Today);
            _message = null;
        }
        catch (Exception ex)
        {
            ShowError($"Dashboard data could not be loaded: {ex.Message}");
        }
    }

    private void LoadBloodPressureThresholds(long personId)
    {
        var systolic = VitalThresholdService.GetActiveThreshold(personId, VitalThresholdService.BloodPressureSystolic);
        var diastolic = VitalThresholdService.GetActiveThreshold(personId, VitalThresholdService.BloodPressureDiastolic);

        _systolicAlertMax = systolic?.MaxValue.HasValue == true
            ? Convert.ToInt32(systolic.MaxValue.Value)
            : 130;

        _diastolicAlertMax = diastolic?.MaxValue.HasValue == true
            ? Convert.ToInt32(diastolic.MaxValue.Value)
            : 80;
    }

    private MetricCard BuildBloodPressureMetric()
    {
        var latest = LatestBloodPressure;
        if (latest is null)
            return new("Blood Pressure", "--", "mmHg", "No data", "status-pill status-info", "Add a blood pressure reading to start the trend.");

        return new(
            "Blood Pressure",
            $"{latest.Systolic}/{latest.Diastolic}",
            "mmHg",
            BloodPressureStatus,
            BloodPressureStatusClass,
            $"Latest on {latest.ReadingTime:g}{(latest.Pulse > 0 ? $", pulse {latest.Pulse}" : string.Empty)}");
    }

    private MetricCard BuildBloodGlucoseMetric()
    {
        var latest = LatestBloodGlucose;
        if (latest is null)
            return new("Blood Glucose", "--", "mg/dL", "No data", "status-pill status-info", "Add a glucose reading to start tracking.");

        var status = latest.GlucoseValue switch
        {
            < 70 => "Low",
            <= 140 => "In range",
            _ => "High"
        };

        var statusClass = status switch
        {
            "In range" => "status-pill status-ok",
            "Low" => "status-pill status-watch",
            _ => "status-pill status-watch"
        };

        return new(
            "Blood Glucose",
            latest.GlucoseValue.ToString(),
            "mg/dL",
            status,
            statusClass,
            $"Latest on {latest.ReadingTime:g}");
    }

    private MetricCard BuildWeightMetric()
    {
        var latest = LatestWeight;
        if (latest is null)
            return new("Weight", "--", "lb", "No data", "status-pill status-info", "Add a weight reading to start the trend.");

        return new(
            "Weight",
            latest.WeightValue.ToString("0.##"),
            latest.WeightUnit,
            "Tracking",
            "status-pill status-info",
            $"Latest on {latest.ReadingTime:g}");
    }

    private MetricCard BuildExerciseMetric()
    {
        var weekStart = DateTime.Today.AddDays(-6);
        var weekMinutes = _exerciseHistory
            .Where(x => x.StartTime.Date >= weekStart)
            .Sum(x => x.DurationMinutes);

        if (_exerciseHistory.Count == 0)
            return new("Exercise", "--", "min", "No data", "status-pill status-info", "Add an exercise session to start weekly totals.");

        return new(
            "Exercise",
            weekMinutes.ToString("0.#"),
            "min",
            weekMinutes > 0 ? "Active" : "Quiet",
            weekMinutes > 0 ? "status-pill status-ok" : "status-pill status-watch",
            LatestExercise is null
                ? "Rolling last 7 days total. No latest session."
                : $"Rolling last 7 days total. Latest: {LatestExercise.ExerciseName} on {LatestExercise.StartTime:g}");
    }

    private List<AttentionItem> BuildAttentionItems()
    {
        var items = new List<AttentionItem>();
        var latestBloodPressure = LatestBloodPressure;
        var latestBloodGlucose = LatestBloodGlucose;

        if (latestBloodPressure is not null && BloodPressureStatus == "High")
        {
            items.Add(new("Blood pressure", $"Latest reading is {latestBloodPressure.Systolic}/{latestBloodPressure.Diastolic}, above the {_systolicAlertMax}/{_diastolicAlertMax} alert target.", "attention-marker marker-watch"));
        }
        else if (latestBloodPressure is not null && BloodPressureStatus == "Elevated")
        {
            items.Add(new("Blood pressure", $"Latest reading is elevated at {latestBloodPressure.Systolic}/{latestBloodPressure.Diastolic}.", "attention-marker marker-info"));
        }

        if (ShowGlucoseAlerts && latestBloodGlucose is not null && latestBloodGlucose.GlucoseValue < 70)
            items.Add(new("Glucose", $"Latest glucose is low at {latestBloodGlucose.GlucoseValue} mg/dL.", "attention-marker marker-watch"));

        var glucoseTarget = _person?.GlucoseTargetMgDl ?? 140;
        if (ShowGlucoseAlerts && latestBloodGlucose is not null && latestBloodGlucose.GlucoseValue > glucoseTarget)
            items.Add(new("Glucose", $"Latest glucose is {latestBloodGlucose.GlucoseValue} mg/dL, above the {glucoseTarget} mg/dL target.", "attention-marker marker-watch"));

        AddNutritionAlerts(items);

        if (LatestWeight is null || LatestWeight.ReadingTime.Date < DateTime.Today.AddDays(-7))
            items.Add(new("Weight", "No weight reading has been logged in the last 7 days.", "attention-marker marker-info"));

        if (!_exerciseHistory.Any(x => x.StartTime.Date >= DateTime.Today.AddDays(-6)))
            items.Add(new("Exercise", "No exercise sessions are logged in the last 7 days.", "attention-marker marker-info"));

        if (ShowKidneyLabs && !_kidneyLabHistory.Any(x => x.ResultMonth.Year == DateTime.Today.Year && x.ResultMonth.Month == DateTime.Today.Month))
            items.Add(new("Kidney labs", "No kidney lab panel is logged for the current month.", "attention-marker marker-info"));

        return items.Count == 0
            ? [new("All clear", $"No current alerts based on BP, {(ShowGlucoseAlerts ? "glucose, " : string.Empty)}nutrition targets, activity, weight{(ShowKidneyLabs ? ", or labs" : string.Empty)}.", "attention-marker marker-info")]
            : items;
    }

    private void AddNutritionAlerts(List<AttentionItem> items)
    {
        if (TodayPhosphorusMg > TodayPhosphorusLimitMg)
        {
            items.Add(new(
                "Phosphorus",
                $"Today is {TodayPhosphorusMg - TodayPhosphorusLimitMg:0} mg over the {TodayPhosphorusLimitMg:N0} mg target.",
                "attention-marker marker-watch"));
        }

        if (TodaySodiumMg > TodaySodiumLimitMg)
        {
            items.Add(new(
                "Sodium",
                $"Today is {TodaySodiumMg - TodaySodiumLimitMg:N0} mg over the {TodaySodiumLimitMg:N0} mg target.",
                "attention-marker marker-watch"));
        }

        if (TodayCalories > TodayCalorieLimit)
        {
            items.Add(new(
                "Calories",
                $"Today is {TodayCalories - TodayCalorieLimit:N0} cal over the {TodayCalorieLimit:N0} cal target.",
                "attention-marker marker-watch"));
        }

        if (TodayProteinTargetG.HasValue && TodayProteinG < TodayProteinTargetG.Value)
        {
            items.Add(new(
                "Protein",
                $"Today is {TodayProteinTargetG.Value - TodayProteinG:0} g below the {TodayProteinTargetG.Value:N0} g target.",
                "attention-marker marker-info"));
        }

        if (TodayPotassiumLimitMg.HasValue && TodayPotassiumMg > TodayPotassiumLimitMg.Value)
        {
            items.Add(new(
                "Potassium",
                $"Today is {TodayPotassiumMg - TodayPotassiumLimitMg.Value:N0} mg over the {TodayPotassiumLimitMg.Value:N0} mg target.",
                "attention-marker marker-watch"));
        }
    }

    private List<ActivityEntry> BuildRecentEntries()
    {
        var entries = new List<ActivityEntry>();

        entries.AddRange(_bloodPressureHistory.Take(2).Select(x => new ActivityEntry(
            x.ReadingTime,
            FormatActivityTime(x.ReadingTime),
            "Blood pressure",
            $"{x.Systolic}/{x.Diastolic} mmHg{(x.Pulse > 0 ? $", pulse {x.Pulse}" : string.Empty)}")));

        entries.AddRange(_bloodGlucoseHistory.Take(2).Select(x => new ActivityEntry(
            x.ReadingTime,
            FormatActivityTime(x.ReadingTime),
            "Blood glucose",
            $"{x.GlucoseValue} mg/dL")));

        entries.AddRange(_weightHistory.Take(2).Select(x => new ActivityEntry(
            x.ReadingTime,
            FormatActivityTime(x.ReadingTime),
            "Weight",
            $"{x.WeightValue:0.##} {x.WeightUnit}")));

        entries.AddRange(_exerciseHistory.Take(2).Select(x => new ActivityEntry(
            x.StartTime,
            FormatActivityTime(x.StartTime),
            "Exercise",
            $"{x.ExerciseName}, {x.DurationMinutes:0.#} min{(x.CaloriesExpended.HasValue ? $", {x.CaloriesExpended.Value:0.#} cal" : string.Empty)}")));

        return entries
            .OrderByDescending(x => x.SortTime)
            .Take(6)
            .ToList();
    }

    private IEnumerable<FoodPhosphorusRunningTotal> TodayNutritionRows =>
        _nutritionRows.Where(x => x.IntakeDate.Date == DateTime.Today);

    private decimal TodayPhosphorusMg => TodayNutritionRows.Sum(x => x.NetItemPhosphorusMg);

    private int TodayCalories => TodayNutritionRows.Sum(x => x.Calories);

    private int TodaySodiumMg => TodayNutritionRows.Sum(x => x.SodiumMg);

    private decimal TodayProteinG => TodayNutritionRows.Sum(x => x.ProteinG);

    private int TodayPotassiumMg => TodayNutritionRows.Sum(x => x.PotassiumMg);

    private int TodayPhosphorusLimitMg => _nutritionGoal?.PhosphorusLimitMg ?? 1000;

    private int TodaySodiumLimitMg => _nutritionGoal?.SodiumLimitMg ?? 2000;

    private int TodayCalorieLimit => _nutritionGoal?.CalorieLimit ?? 2200;

    private int? TodayProteinTargetG => _nutritionGoal?.ProteinTargetG;

    private int? TodayPotassiumLimitMg => _nutritionGoal?.PotassiumLimitMg;

    private string TodayNutritionEffectiveText =>
        _nutritionGoal is null
            ? "Default targets"
            : $"Effective {_nutritionGoal.EffectiveDate:M/d/yyyy}";

    private IReadOnlyList<DailyNutritionTargetRow> DailyNutritionTargets
    {
        get
        {
            var rows = new List<DailyNutritionTargetRow>
            {
                BuildLimitRow("Phosphorus", TodayPhosphorusMg, TodayPhosphorusLimitMg, "mg", decimals: 0),
                BuildLimitRow("Sodium", TodaySodiumMg, TodaySodiumLimitMg, "mg", decimals: 0),
                BuildLimitRow("Calories", TodayCalories, TodayCalorieLimit, "cal", decimals: 0)
            };

            if (TodayProteinTargetG.HasValue)
                rows.Add(BuildTargetRow("Protein", TodayProteinG, TodayProteinTargetG.Value, "g", decimals: 0));

            if (TodayPotassiumLimitMg.HasValue)
                rows.Add(BuildLimitRow("Potassium", TodayPotassiumMg, TodayPotassiumLimitMg.Value, "mg", decimals: 0));

            return rows;
        }
    }

    private string TodayNutritionSummaryText =>
        TodayNutritionRows.Any()
            ? $"Targets for {DateTime.Today:M/d/yyyy}. {TodayPhosphorusMg:N0} mg phosphorus logged today after binder adjustment."
            : "No food entries logged today yet.";

    private IReadOnlyList<ExerciseTrendPoint> ExerciseSessionTrendPoints =>
        _exerciseHistory
            .Where(x => x.CaloriesExpended.HasValue)
            .OrderBy(x => x.StartTime)
            .TakeLast(90)
            .Select(x => new ExerciseTrendPoint(
                x.StartTime,
                x.CaloriesExpended!.Value,
                x.DurationMinutes))
            .ToList();

    private IReadOnlyList<ExerciseTrendPoint> ExerciseRollingAveragePoints
    {
        get
        {
            var points = ExerciseSessionTrendPoints;
            var rolling = new List<ExerciseTrendPoint>();

            for (var index = 0; index < points.Count; index++)
            {
                var window = points
                    .Skip(Math.Max(0, index - 6))
                    .Take(Math.Min(7, index + 1));
                rolling.Add(points[index] with { Calories = window.Average(x => x.Calories) });
            }

            return rolling;
        }
    }

    private string ExerciseSessionPolyline => BuildExercisePolyline(ExerciseSessionTrendPoints);

    private string ExerciseRollingAveragePolyline => BuildExercisePolyline(ExerciseRollingAveragePoints);

    private string ExerciseTrendSummary
    {
        get
        {
            var points = ExerciseSessionTrendPoints;
            if (points.Count == 0)
                return "No data";

            return $"{points.Count} sessions";
        }
    }

    private string ExerciseTrendFooter
    {
        get
        {
            var points = ExerciseSessionTrendPoints;
            if (points.Count == 0)
                return "No exercise calories logged yet.";

            var latest = points[^1];
            var totalCalories = points.Sum(x => x.Calories);
            var averageCalories = points.Average(x => x.Calories);
            var highCalories = points.Max(x => x.Calories);
            var totalMinutes = _exerciseHistory.Sum(x => x.DurationMinutes);

            return $"{points.Count} sessions, {averageCalories:0} avg calories, {latest.Calories:0} latest, {highCalories:0} high, {totalCalories:N0} total, Total Exercise Time: {FormatDuration(totalMinutes)}";
        }
    }

    private IReadOnlyList<ExerciseMonthTotal> ExerciseMonthlyTotals
    {
        get
        {
            var totals = _exerciseHistory
                .Where(x => x.CaloriesExpended.HasValue)
                .GroupBy(x => new DateTime(x.StartTime.Year, x.StartTime.Month, 1))
                .OrderBy(x => x.Key)
                .TakeLast(6)
                .Select(x => new ExerciseMonthTotal(
                    x.Key.ToString("MMM yy"),
                    x.Sum(session => session.CaloriesExpended ?? 0),
                    x.Sum(session => session.DurationMinutes),
                    0))
                .ToList();

            var max = totals.Count == 0 ? 0 : totals.Max(x => x.TotalCalories);
            if (max <= 0)
                return totals;

            return totals
                .Select(x => x with { HeightPercent = Math.Max(6, (int)Math.Round(x.TotalCalories / max * 100)) })
                .ToList();
        }
    }

    private string ExerciseTopMonthText
    {
        get
        {
            var top = ExerciseMonthlyTotals
                .OrderByDescending(x => x.TotalCalories)
                .FirstOrDefault();

            return top is null
                ? "No data"
                : $"Top: {top.Label}";
        }
    }

    private static string BuildExercisePolyline(IReadOnlyList<ExerciseTrendPoint> points)
    {
        if (points.Count == 0)
            return string.Empty;

        var max = points.Max(x => x.Calories);
        var min = points.Min(x => x.Calories);
        var range = max - min;
        if (range <= 0)
            range = 1;

        return string.Join(
            " ",
            points.Select((point, index) =>
            {
                var x = points.Count == 1 ? 50 : index * 100m / (points.Count - 1);
                var y = 42m - ((point.Calories - min) / range * 36m);
                return $"{x:0.##},{y:0.##}";
            }));
    }

    private static string FormatDuration(decimal minutes)
    {
        var totalMinutes = (int)Math.Round(minutes);
        var hours = totalMinutes / 60;
        var remainingMinutes = totalMinutes % 60;
        return $"{hours} hr {remainingMinutes} min";
    }

    private static DailyNutritionTargetRow BuildLimitRow(string nutrient, decimal consumed, decimal target, string unit, int decimals)
    {
        var remaining = target - consumed;
        return new(
            nutrient,
            FormatNutritionValue(consumed, unit, decimals),
            FormatNutritionValue(target, unit, decimals),
            FormatNutritionValue(remaining, unit, decimals),
            remaining < 0 ? "remaining-negative" : "remaining-positive");
    }

    private static DailyNutritionTargetRow BuildTargetRow(string nutrient, decimal consumed, decimal target, string unit, int decimals)
    {
        var remaining = target - consumed;
        return new(
            nutrient,
            FormatNutritionValue(consumed, unit, decimals),
            FormatNutritionValue(target, unit, decimals),
            FormatNutritionValue(remaining, unit, decimals),
            remaining > 0 ? "remaining-negative" : "remaining-positive");
    }

    private static string FormatNutritionValue(decimal value, string unit, int decimals)
    {
        var format = decimals == 0 ? "N0" : $"N{decimals}";
        return $"{value.ToString(format)} {unit}";
    }

    private async Task SignOut()
    {
        await LoginSession.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private void ShowError(string message)
    {
        _messageClass = "page-message page-message--error";
        _message = message;
    }

    private static int ScaleBloodPressureHeight(int systolic)
    {
        var height = 20 + (int)Math.Round((systolic - 90) / 70.0 * 80);
        return Math.Clamp(height, 15, 100);
    }

    private static string FormatActivityTime(DateTime value)
    {
        if (value.Date == DateTime.Today)
            return value.ToString("h:mm tt");

        if (value.Date == DateTime.Today.AddDays(-1))
            return "Yesterday";

        return value.ToString("M/d/yyyy");
    }

