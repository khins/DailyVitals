@page "/pricing"
@layout MarketingLayout
@inject IConfiguration Configuration

<PageTitle>Pricing | My Active Vitals</PageTitle>

<header class="marketing-page-hero">
    <p class="marketing-kicker">Simple pricing</p>
    <h1>Choose the pace that works for you.</h1>
    <p>Both plans include the complete My Active Vitals tracking experience. Cancel anytime.</p>
</header>

<section class="marketing-section">
    <div class="pricing-grid">
        <article class="pricing-card">
            <p class="marketing-kicker">Monthly</p>
            <h2>Flexible access</h2>
            <div class="pricing-price">$7.99 <span>/ month</span></div>
            <p>Billed monthly after the trial.</p>
            <ul>
                <li>Nutrition and fluid tracking</li>
                <li>Exercise and vital tracking</li>
                <li>Kidney lab history</li>
                <li>Dashboards, reports, and trends</li>
                <li>Monthly allowance of AI nutrition estimates</li>
            </ul>
            <div class="pricing-card__actions">
                @if (RegistrationEnabled)
                {
                    <a class="marketing-button marketing-button--outline" href="create-account">Start 7-day trial</a>
                }
                else
                {
                    <span class="marketing-button marketing-button--outline marketing-button--disabled">Subscriptions coming soon</span>
                }
            </div>
        </article>

        <article class="pricing-card pricing-card--featured">
            <span class="pricing-badge">Save about 18%</span>
            <p class="marketing-kicker">Annual</p>
            <h2>Best value</h2>
            <div class="pricing-price">$79 <span>/ year</span></div>
            <p>Equivalent to about $6.58 per month.</p>
            <ul>
                <li>Everything in the monthly plan</li>
                <li>One annual payment after the trial</li>
                <li>Save $16.88 compared with monthly billing</li>
                <li>Monthly allowance of AI nutrition estimates</li>
                <li>Cancel renewal anytime</li>
            </ul>
            <div class="pricing-card__actions">
                @if (RegistrationEnabled)
                {
                    <a class="marketing-button marketing-button--primary" href="create-account">Start 7-day trial</a>
                }
                else
                {
                    <span class="marketing-button marketing-button--primary marketing-button--disabled">Subscriptions coming soon</span>
                }
            </div>
        </article>
    </div>
    <p class="pricing-note">
        A payment method will be required for the trial when subscription checkout launches. You will not be charged until the seven-day trial ends. AI estimate allowance details will be shown before purchase. Pricing and trial enrollment shown here are currently in development and are not yet an offer to purchase.
    </p>
</section>

@code {
    private bool RegistrationEnabled => Configuration.GetValue("AccountRegistration:Enabled", false);
}

<section class="marketing-section marketing-section--tint">
    <div class="marketing-section__heading">
        <p class="marketing-kicker">Frequently asked</p>
        <h2>Clear terms from the start.</h2>
    </div>
    <div class="marketing-card-grid">
        <article class="marketing-card">
            <h3>Can I cancel?</h3>
            <p>Yes. You will be able to cancel renewal at any time and retain access through the paid period.</p>
        </article>
        <article class="marketing-card">
            <h3>When am I charged?</h3>
            <p>Once billing launches, your selected plan will begin after the seven-day trial unless you cancel first.</p>
        </article>
        <article class="marketing-card">
            <h3>Are AI estimates unlimited?</h3>
            <p>No. Plans will include a clearly disclosed monthly allowance to keep pricing predictable and responsible.</p>
        </article>
    </div>
</section>
