<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <appSettings>
    <!-- Leave blank here and prefer the GEMINI_API_KEY environment variable for your real key. -->
    <add key="GeminiApiKey" value="" />
    <add key="GeminiModel" value="gemini-2.0-flash" />
  </appSettings>

  <connectionStrings>
    <add name="DailyVitals"
         connectionString="Host=localhost;Port=5433;Database=DailyVitals;Username=postgres;Password=newpassword" />
  </connectionStrings>

</configuration>
