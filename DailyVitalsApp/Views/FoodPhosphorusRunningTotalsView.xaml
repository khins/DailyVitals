<Window x:Class="DailyVitals.App.Views.FoodPhosphorusRunningTotalsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Food Running Totals"
        Height="760"
        MinHeight="680"
        Width="1180"
        MinWidth="1040"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="MainMenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D6D6D6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#EEEEEE"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding PersonName}"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding SummaryText}"
                           FontSize="13"
                           Foreground="DimGray"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock Text="Search"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Width="280"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding SearchResultsText}"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HorizontalScrollBarVisibility="Auto"
                  SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter Property="Background" Value="#0078D7"/>
                            <Setter Property="Foreground" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date"
                                    Width="95"
                                    Binding="{Binding IntakeDate, StringFormat=d}"/>
                <DataGridTextColumn Header="Food Item"
                                    Width="2*"
                                    MinWidth="300"
                                    Binding="{Binding FoodName}"/>
                <DataGridTextColumn Header="Raw Phos (mg)"
                                    Width="110"
                                    Binding="{Binding RawPhosphorusMg}"/>
                <DataGridTextColumn Header="Calories"
                                    Width="80"
                                    Binding="{Binding Calories}"/>
                <DataGridTextColumn Header="Sodium (mg)"
                                    Width="100"
                                    Binding="{Binding SodiumMg}"/>
                <DataGridTextColumn Header="Protein (g)"
                                    Width="90"
                                    Binding="{Binding ProteinG, StringFormat={}{0:0.##}}"/>
                <DataGridTextColumn Header="Potassium (mg)"
                                    Width="110"
                                    Binding="{Binding PotassiumMg}"/>
                <DataGridTextColumn Header="Fluid (ml)"
                                    Width="85"
                                    Binding="{Binding FluidMl}"/>
                <DataGridTextColumn Header="Pills"
                                    Width="60"
                                    Binding="{Binding PillsTaken}"/>
                <DataGridTextColumn Header="Net Item (mg)"
                                    Width="115"
                                    Binding="{Binding NetItemPhosphorusMg, StringFormat={}{0:F0}}"/>
                <DataGridTextColumn Header="Running Net (mg)"
                                    Width="130"
                                    Binding="{Binding RunningNetDailyMg, StringFormat={}{0:F0}}"/>
                <DataGridTextColumn Header="Running Calories"
                                    Width="130"
                                    Binding="{Binding RunningDailyCalories}"/>
                <DataGridTextColumn Header="Running Sodium (mg)"
                                    Width="145"
                                    Binding="{Binding RunningDailySodiumMg}"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="2"
                  Header="Daily Nutrition Targets"
                  Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding NutritionGoalSummary}"
                           Foreground="DimGray"
                           Margin="0,0,0,6"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding DailyNutritionTargets}"
                          Height="115"
                          Width="580"
                          HorizontalAlignment="Left"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nutrient"
                                            Width="160"
                                            Binding="{Binding Nutrient}"/>
                        <DataGridTextColumn Header="Consumed"
                                            Width="140"
                                            Binding="{Binding Consumed}"/>
                        <DataGridTextColumn Header="Daily Target"
                                            Width="140"
                                            Binding="{Binding Target}"/>
                        <DataGridTextColumn Header="Remaining"
                                            Width="140"
                                            Binding="{Binding Remaining}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Green"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverTarget}" Value="True">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3"
                  Header="Monthly Totals"
                  Margin="0,12,0,0">
            <DataGrid ItemsSource="{Binding MonthlyTotals}"
                      Height="150"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HorizontalScrollBarVisibility="Auto"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Month"
                                        Width="120"
                                        Binding="{Binding Month}"/>
                    <DataGridTextColumn Header="Entries"
                                        Width="80"
                                        Binding="{Binding Entries}"/>
                    <DataGridTextColumn Header="Raw Phos (mg)"
                                        Width="120"
                                        Binding="{Binding RawPhosphorusMg}"/>
                    <DataGridTextColumn Header="Net Phos (mg)"
                                        Width="120"
                                        Binding="{Binding NetPhosphorusMg, StringFormat={}{0:F0}}"/>
                    <DataGridTextColumn Header="Calories"
                                        Width="100"
                                        Binding="{Binding Calories}"/>
                    <DataGridTextColumn Header="Sodium (mg)"
                                        Width="110"
                                        Binding="{Binding SodiumMg}"/>
                    <DataGridTextColumn Header="Protein (g)"
                                        Width="100"
                                        Binding="{Binding ProteinG, StringFormat={}{0:0.##}}"/>
                    <DataGridTextColumn Header="Potassium (mg)"
                                        Width="115"
                                        Binding="{Binding PotassiumMg}"/>
                    <DataGridTextColumn Header="Fluid (ml)"
                                        Width="90"
                                        Binding="{Binding FluidMl}"/>
                    <DataGridTextColumn Header="Pills"
                                        Width="80"
                                        Binding="{Binding PillsTaken}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Close"
                    Width="90"
                    Height="32"
                    Style="{StaticResource MainMenuButtonStyle}"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
