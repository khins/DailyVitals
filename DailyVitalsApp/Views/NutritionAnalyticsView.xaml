<Window x:Class="DailyVitals.App.Views.NutritionAnalyticsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nutrition Analytics"
        Height="820"
        MinHeight="720"
        Width="1180"
        MinWidth="1040"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="MainMenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D6D6D6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#EEEEEE"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Person:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1"
                      Width="260"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding Persons}"
                      SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                      DisplayMemberPath="FullName"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding SummaryText}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,0,0,12">
            <TabItem Header="Calorie Balance">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Calorie Balance"
                              Margin="0,0,8,8"
                              Visibility="{Binding HasCalorieBalanceData, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Canvas Width="520"
                                    Height="190"
                                    Background="#FFF4F4F4"
                                    HorizontalAlignment="Left">
                                <Polyline Stroke="DarkOrange"
                                          StrokeThickness="3"
                                          Points="{Binding CaloriesInPoints}"/>
                                <Polyline Stroke="SteelBlue"
                                          StrokeThickness="3"
                                          Points="{Binding CalorieBalancePoints}"/>
                                <TextBlock Text="orange: calories in"
                                           Canvas.Left="8"
                                           Canvas.Top="8"
                                           Foreground="DimGray"/>
                                <TextBlock Text="blue: net balance"
                                           Canvas.Left="8"
                                           Canvas.Top="28"
                                           Foreground="DimGray"/>
                            </Canvas>
                            <TextBlock Text="{Binding CalorieChartSummary}"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1"
                              Header="Target Usage"
                              Margin="8,0,0,8"
                              Visibility="{Binding HasNutrientTargetData, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Canvas Width="520"
                                    Height="190"
                                    Background="#FFF4F4F4"
                                    HorizontalAlignment="Left">
                                <Polyline Stroke="Crimson"
                                          StrokeThickness="3"
                                          Points="{Binding SodiumUsagePoints}"/>
                                <Polyline Stroke="SeaGreen"
                                          StrokeThickness="3"
                                          Points="{Binding PhosphorusUsagePoints}"/>
                                <TextBlock Text="red: sodium % of target"
                                           Canvas.Left="8"
                                           Canvas.Top="8"
                                           Foreground="DimGray"/>
                                <TextBlock Text="green: net phosphorus % of target"
                                           Canvas.Left="8"
                                           Canvas.Top="28"
                                           Foreground="DimGray"/>
                            </Canvas>
                            <TextBlock Text="{Binding NutrientChartSummary}"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Header="Weight Trend"
                              Margin="0,4,0,0"
                              Visibility="{Binding HasWeightData, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Canvas Width="1080"
                                    Height="160"
                                    Background="#FFF4F4F4"
                                    HorizontalAlignment="Left">
                                <Polyline Stroke="Black"
                                          StrokeThickness="3"
                                          Points="{Binding WeightPoints}"/>
                                <TextBlock Text="{Binding StartWeightLabel}"
                                           Canvas.Left="8"
                                           Canvas.Top="8"
                                           FontWeight="SemiBold"
                                           Foreground="DimGray"/>
                                <TextBlock Text="{Binding EndWeightLabel}"
                                           Canvas.Right="8"
                                           Canvas.Top="136"
                                           FontWeight="SemiBold"
                                           Foreground="DimGray"/>
                            </Canvas>
                            <TextBlock Text="{Binding WeightChartSummary}"
                                       Foreground="{Binding WeightChartSummaryBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Exercise Notebook">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Calories Burned Per Session"
                              Margin="0,0,0,8"
                              Visibility="{Binding HasExerciseSessionData, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Canvas Width="1080"
                                    Height="190"
                                    Background="#FFF4F4F4"
                                    HorizontalAlignment="Left">
                                <Polyline Stroke="DarkOrange"
                                          StrokeThickness="3"
                                          Points="{Binding ExerciseCaloriesPoints}"/>
                                <Polyline Stroke="SteelBlue"
                                          StrokeThickness="3"
                                          Points="{Binding ExerciseRollingPoints}"/>
                                <TextBlock Text="orange: session calories"
                                           Canvas.Left="8"
                                           Canvas.Top="8"
                                           Foreground="DimGray"/>
                                <TextBlock Text="blue: 7-session rolling average"
                                           Canvas.Left="8"
                                           Canvas.Top="28"
                                           Foreground="DimGray"/>
                                <TextBlock Text="{Binding ExerciseStartDurationLabel}"
                                           Canvas.Left="8"
                                           Canvas.Top="48"
                                           Foreground="DimGray"/>
                                <TextBlock Text="{Binding ExerciseCurrentDurationLabel}"
                                           Canvas.Right="8"
                                           Canvas.Top="168"
                                           FontWeight="SemiBold"
                                           Foreground="DimGray"/>
                            </Canvas>
                            <TextBlock Text="{Binding ExerciseChartSummary}"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                              Header="Total Calories Burned Per Month"
                              Visibility="{Binding HasMonthlyExerciseData, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Canvas Width="1080"
                                    Height="220"
                                    Background="#FFF4F4F4"
                                    HorizontalAlignment="Left"
                                    ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding MonthlyExerciseBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="{Binding Width}"
                                                       Height="{Binding Height}"
                                                       Fill="SeaGreen"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding MonthlyExerciseBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding LabelLeft}"/>
                                            <Setter Property="Canvas.Top" Value="198"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"
                                                       Width="{Binding Width}"
                                                       TextAlignment="Center"
                                                       FontSize="11"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding MonthlyExerciseBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding LabelLeft}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding ValueTop}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ValueText}"
                                                       Width="{Binding Width}"
                                                       TextAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                            <TextBlock Text="{Binding MonthlyExerciseSummary}"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding DailyRows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HorizontalScrollBarVisibility="Auto"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date"
                                    Width="105"
                                    Binding="{Binding Date, StringFormat=d}"/>
                <DataGridTextColumn Header="Calories In"
                                    Width="100"
                                    Binding="{Binding CaloriesIn}"/>
                <DataGridTextColumn Header="Exercise Cal"
                                    Width="105"
                                    Binding="{Binding ExerciseCalories}"/>
                <DataGridTextColumn Header="Balance"
                                    Width="90"
                                    Binding="{Binding CalorieBalance}"/>
                <DataGridTextColumn Header="Sodium (mg)"
                                    Width="105"
                                    Binding="{Binding SodiumMg}"/>
                <DataGridTextColumn Header="Net Phos (mg)"
                                    Width="115"
                                    Binding="{Binding NetPhosphorusMg, StringFormat={}{0:F0}}"/>
                <DataGridTextColumn Header="Weight"
                                    Width="90"
                                    Binding="{Binding WeightValue, StringFormat={}{0:F1}}"/>
                <DataGridTextColumn Header="Cal Target"
                                    Width="95"
                                    Binding="{Binding CalorieLimit}"/>
                <DataGridTextColumn Header="Sodium Target"
                                    Width="110"
                                    Binding="{Binding SodiumLimitMg}"/>
                <DataGridTextColumn Header="Phos Target"
                                    Width="100"
                                    Binding="{Binding PhosphorusLimitMg}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Close"
                    Width="90"
                    Height="32"
                    Style="{StaticResource MainMenuButtonStyle}"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
